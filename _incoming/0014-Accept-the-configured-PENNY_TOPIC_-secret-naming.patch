+TOPIC_ENV_VARS: dict[str, tuple[str, ...]] = {
+    TOPIC_RADAR: ("PENNY_TOPIC_EARLY", "PENNY_TOPIC_RADAR", "PENNY_RADAR_TOPIC_ID"),
+    TOPIC_CONFIRMING: ("PENNY_TOPIC_CONFIRMING", "PENNY_CONFIRMING_TOPIC_ID"),
