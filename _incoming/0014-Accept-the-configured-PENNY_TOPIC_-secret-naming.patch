+# --- topic naming conventions -----------------------------------------------
+
+def test_the_configured_topic_naming_is_accepted(monkeypatch):
+    """PENNY_TOPIC_* is the primary form and matches the group's topic titles."""
+    monkeypatch.setenv("PENNY_TOPIC_EARLY", "11")
+    monkeypatch.setenv("PENNY_TOPIC_CONFIRMING", "12")
+    monkeypatch.setenv("PENNY_TOPIC_READY", "13")
+    monkeypatch.setenv("PENNY_TOPIC_CIRCUIT_RISK", "14")
+    monkeypatch.setenv("PENNY_TOPIC_PORTFOLIO", "15")
+    monkeypatch.setenv("PENNY_TOPIC_SYSTEM", "16")
+    assert [topic_id(k) for k in TOPIC_KINDS] == [11, 12, 13, 14, 15, 16]
+
+
+def test_the_older_topic_naming_still_works(monkeypatch):
+    """Nobody should have to rename a secret that is already configured."""
+    monkeypatch.setenv("PENNY_RADAR_TOPIC_ID", "21")
+    monkeypatch.setenv("PENNY_CIRCUIT_TOPIC_ID", "24")
+    assert topic_id("RADAR") == 21
+    assert topic_id("CIRCUIT") == 24
+
+
+def test_the_primary_name_wins_when_both_are_set(monkeypatch):
+    monkeypatch.setenv("PENNY_TOPIC_EARLY", "11")
+    monkeypatch.setenv("PENNY_RADAR_TOPIC_ID", "99")
+    assert topic_id("RADAR") == 11
+
+
+def test_preflight_names_the_variable_each_topic_came_from(monkeypatch):
+    """So a typo in one of six secrets is immediately visible."""
+    monkeypatch.setenv("PENNY_TOPIC_EARLY", "11")
+    monkeypatch.setenv("PENNY_CIRCUIT_TOPIC_ID", "14")
+    sources = preflight()["topic_sources"]
+    assert sources["RADAR"] == "PENNY_TOPIC_EARLY"
+    assert sources["CIRCUIT"] == "PENNY_CIRCUIT_TOPIC_ID"
+    assert sources["READY"] is None
+
+
+def test_every_topic_has_at_least_one_accepted_name():
+    for kind in TOPIC_KINDS:
+        assert TOPIC_ENV_VARS[kind], f"{kind} has no environment variable"
