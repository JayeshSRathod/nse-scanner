 REQUIRED_SECRETS: tuple[str, ...] = (TOKEN_VAR, CHAT_VAR)
-OPTIONAL_SECRETS: tuple[str, ...] = tuple(f"PENNY_{kind}_TOPIC_ID" for kind in TOPIC_KINDS)
+#: Every accepted optional name, primary form listed first per topic.
+OPTIONAL_SECRETS: tuple[str, ...] = tuple(
