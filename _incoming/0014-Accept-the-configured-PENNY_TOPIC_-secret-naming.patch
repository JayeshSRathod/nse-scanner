+)
+#: Just the preferred name per topic, for documentation and error messages.
+PREFERRED_TOPIC_SECRETS: dict[str, str] = {
+    kind: TOPIC_ENV_VARS[kind][0] for kind in TOPIC_KINDS
+}
 
 #: Telegram rejects messages over 4096 characters.
