@@ -52,14 +81,41 @@ class DeliveryResult:
                 "reason": self.reason}
 
 
+def topic_env_var(kind: str) -> str | None:
+    """The variable actually supplying this topic, or ``None`` if unset.
+
+    Reporting the source name makes a typo in one of six secrets immediately
+    obvious, rather than silently posting to the chat root.
+    """
+    for name in TOPIC_ENV_VARS.get(kind.upper(), ()):
+        value = os.getenv(name, "").strip()
+        if not value:
+            continue
+        try:
+            if int(value) > 0:
+                return name
+        except ValueError:
+            continue
+    return None
+
+
 def topic_id(kind: str) -> int | None:
-    """Resolve ``PENNY_<KIND>_TOPIC_ID``; ``None`` means post to the chat root."""
-    value = os.getenv(f"PENNY_{kind.upper()}_TOPIC_ID", "").strip()
-    try:
-        parsed = int(value)
-    except ValueError:
-        return None
-    return parsed if parsed > 0 else None
+    """Resolve a topic ID from any accepted variable name.
+
+    ``None`` means post to the chat root rather than a thread, which is a valid
+    configuration — a group without topics works fine.
+    """
+    for name in TOPIC_ENV_VARS.get(kind.upper(), ()):
+        value = os.getenv(name, "").strip()
+        if not value:
+            continue
+        try:
+            parsed = int(value)
+        except ValueError:
+            continue
+        if parsed > 0:
+            return parsed
+    return None
 
 
 def credentials_present() -> bool:
@@ -160,5 +216,8 @@ def preflight() -> dict:
     return {
         "required": {name: bool(os.getenv(name, "").strip()) for name in REQUIRED_SECRETS},
         "topics": {kind: topic_id(kind) is not None for kind in TOPIC_KINDS},
+        # Which variable name each topic actually came from, so a typo in one of
+        # six secrets is immediately obvious.
+        "topic_sources": {kind: topic_env_var(kind) for kind in TOPIC_KINDS},
         "ready": credentials_present(),
     }
