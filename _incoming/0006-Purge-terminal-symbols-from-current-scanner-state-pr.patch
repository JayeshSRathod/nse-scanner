new file mode 100755
index 0000000..f29ff04
--- /dev/null
+++ b/tests/test_purge_terminal_state.py
@@ -0,0 +1,160 @@
+"""Step 7: purge terminal symbols from current state, preserving history."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from scripts.purge_terminal_symbols_from_state import Purge, purge_file
+from v2.security_lifecycle import LifecycleEvent, LifecycleRegistry
+
+# Terminal from 2026-07-17: the session after its last trade on 2026-07-16.
+EVENT = LifecycleEvent(
+    symbol="JBCHEPHARM", event_type="AMALGAMATION", status="EFFECTIVE",
+    effective_date="2026-07-08", record_date="2026-07-17",
+    last_trading_date="2026-07-16", successor_symbol="TORNTPHARM",
+    exchange_ratio_from=100.0, exchange_ratio_to=51.0, terminal=True,
+)
+REGISTRY = LifecycleRegistry([EVENT])
+
+
+def _state() -> dict:
+    return {
+        "schema_version": 1,
+        "sessions": {
+            # Valid history: the symbol really did trade on these dates.
+            "2026-07-15": {"shadow_symbols": ["JBCHEPHARM", "RELIANCE"]},
+            "2026-07-16": {"shadow_symbols": ["JBCHEPHARM", "RELIANCE"]},
+            # Defective: the symbol had already ceased to exist.
+            "2026-07-17": {"shadow_symbols": ["JBCHEPHARM", "RELIANCE"]},
+            "2026-08-19": {"shadow_symbols": ["JBCHEPHARM", "RELIANCE"],
+                           "baseline_symbols": ["JBCHEPHARM"]},
+        },
+        "updated_at": "2026-08-19",
+    }
+
+
+def _write(tmp_path: Path, document: dict, name: str = "state.json") -> Path:
+    path = tmp_path / name
+    path.write_text(json.dumps(document), encoding="utf-8")
+    return path
+
+
+# --- date awareness ---------------------------------------------------------
+
+def test_records_before_the_terminal_date_are_preserved():
+    purge = Purge(REGISTRY)
+    cleaned = purge.walk(_state(), None)
+    for session in ("2026-07-15", "2026-07-16"):
+        assert cleaned["sessions"][session]["shadow_symbols"] == ["JBCHEPHARM", "RELIANCE"], \
+            f"{session} is valid history and must not be edited"
+
+
+def test_records_on_or_after_the_terminal_date_are_removed():
+    purge = Purge(REGISTRY)
+    cleaned = purge.walk(_state(), None)
+    assert cleaned["sessions"]["2026-07-17"]["shadow_symbols"] == ["RELIANCE"]
+    assert cleaned["sessions"]["2026-08-19"]["shadow_symbols"] == ["RELIANCE"]
+    assert cleaned["sessions"]["2026-08-19"]["baseline_symbols"] == []
+
+
+def test_the_boundary_is_the_session_after_the_last_trade():
+    purge = Purge(REGISTRY)
+    purge.walk(_state(), None)
+    removed = {(entry["session"], entry["symbol"]) for entry in purge.removals}
+    assert ("2026-07-16", "JBCHEPHARM") not in removed
+    assert ("2026-07-17", "JBCHEPHARM") in removed
+
+
+def test_unrelated_symbols_are_never_touched():
+    purge = Purge(REGISTRY)
+    cleaned = purge.walk(_state(), None)
+    for session in cleaned["sessions"].values():
+        assert "RELIANCE" in session.get("shadow_symbols", ["RELIANCE"])
+    assert all(entry["symbol"] == "JBCHEPHARM" for entry in purge.removals)
+
+
+def test_every_removal_is_reported_with_its_session():
+    purge = Purge(REGISTRY)
+    purge.walk(_state(), None)
+    assert len(purge.removals) == 3
+    assert {entry["session"] for entry in purge.removals} == {
+        "2026-07-17", "2026-08-19",
+    }
+
+
+def test_undated_structures_are_left_alone():
+    """Without a session date there is no basis to judge a record defective."""
+    purge = Purge(REGISTRY)
+    document = {"watchlist": ["JBCHEPHARM", "RELIANCE"]}
+    cleaned = purge.walk(document, None)
+    assert cleaned == document
+    assert purge.removals == []
+
+
+# --- positions are a portfolio matter, not a text edit ----------------------
+
+def test_open_positions_are_reported_and_never_deleted():
+    purge = Purge(REGISTRY)
+    document = {"sessions": {"2026-08-19": {"positions": [
+        {"symbol": "JBCHEPHARM", "state": "OPEN", "quantity": 100},
+        {"symbol": "RELIANCE", "state": "OPEN", "quantity": 5},
+    ]}}}
+    cleaned = purge.walk(document, None)
+    assert len(cleaned["sessions"]["2026-08-19"]["positions"]) == 2, \
+        "a holding must be resolved by reconciliation, not silently dropped"
+    assert purge.removals == []
+    assert len(purge.position_warnings) == 1
+    assert purge.position_warnings[0]["symbol"] == "JBCHEPHARM"
+
+
+# --- file handling ----------------------------------------------------------
+
+def test_dry_run_does_not_modify_the_file(tmp_path):
+    path = _write(tmp_path, _state())
+    before = path.read_text(encoding="utf-8")
+    report = purge_file(path, REGISTRY, apply=False)
+    assert report["status"] == "WOULD_UPDATE"
+    assert path.read_text(encoding="utf-8") == before
+    assert not path.with_suffix(".json.bak").exists()
+
+
+def test_apply_writes_the_file_and_keeps_a_backup(tmp_path):
+    path = _write(tmp_path, _state())
+    report = purge_file(path, REGISTRY, apply=True)
+    assert report["status"] == "UPDATED"
+    backup = Path(report["backup"])
+    assert backup.exists()
+    assert json.loads(backup.read_text(encoding="utf-8")) == _state()
+    written = json.loads(path.read_text(encoding="utf-8"))
+    assert written["sessions"]["2026-08-19"]["shadow_symbols"] == ["RELIANCE"]
+    assert written["sessions"]["2026-07-16"]["shadow_symbols"] == ["JBCHEPHARM", "RELIANCE"]
+
+
+def test_a_clean_file_is_left_untouched(tmp_path):
+    path = _write(tmp_path, {"sessions": {"2026-08-19": {"shadow_symbols": ["RELIANCE"]}}})
+    before = path.read_text(encoding="utf-8")
+    report = purge_file(path, REGISTRY, apply=True)
+    assert report["status"] == "CLEAN"
+    assert path.read_text(encoding="utf-8") == before
+
+
+def test_missing_and_unreadable_files_are_reported_not_raised(tmp_path):
+    assert purge_file(tmp_path / "nope.json", REGISTRY, apply=True)["status"] == "MISSING"
+    broken = tmp_path / "broken.json"
+    broken.write_text("{not json", encoding="utf-8")
+    assert purge_file(broken, REGISTRY, apply=True)["status"] == "UNREADABLE"
+
+
+def test_shipped_state_files_contain_no_post_terminal_records():
+    """Regression guard: the repository's own state must stay clean."""
+    root = Path(__file__).resolve().parents[1]
+    for name in ("old_nse_hull_shadow_state.json",
