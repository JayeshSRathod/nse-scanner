@@ -0,0 +1,204 @@
+#!/usr/bin/env python3
+"""Remove terminal symbols from *current* scanner state without touching history.
+
+Step 7 of the Cross-Scanner Eligibility and Corporate Lifecycle Sprint.
+
+The gateway stops a terminal symbol entering a new scan, but scanner state files
+already on disk can reintroduce one as a current candidate.  This script cleans
+them, and it is deliberately date-aware rather than a per-ticker blacklist:
+
+* A symbol recorded against a session **before** its terminal date was validly
+  observed on that date.  That record is history and is left alone.
+* A symbol recorded against a session **on or after** its terminal date is
+  defective output.  That record is removed.
+
+For ``JBCHEPHARM`` (terminal from 2026-07-17, the session after its last trade
+on 2026-07-16) every occurrence in the shipped state files is dated 2026-07-22
+or later, so all of them are defective.
+
+Price history, ``market_data/daily/*.csv`` and the corporate snapshots are never
+touched by this script.
+
+Positions are *not* silently deleted.  An open position in a terminal symbol is
+a portfolio event -- a corporate conversion or a terminal exit -- and belongs to
+``v2.universe_reconciliation``, which the scanners now run.  This script reports
+such positions and refuses to remove them.
+
+Usage
+-----
+    python scripts/purge_terminal_symbols_from_state.py                # dry run
+    python scripts/purge_terminal_symbols_from_state.py --apply        # write
+    python scripts/purge_terminal_symbols_from_state.py --apply --file x.json
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+import sys
+from datetime import date
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from v2.security_lifecycle import LifecycleRegistry, read_snapshot  # noqa: E402
+
+#: State files that describe the *current* view and can reseed a candidate.
+DEFAULT_STATE_FILES = (
+    "old_nse_hull_shadow_state.json",
+    "old_nse_hull_historical_replay_state.json",
+    "old_nse_hull_paper_state.json",
+    "scan_lifecycle.json",
+    "scan_history.json",
+    "telegram_last_scan.json",
+)
+
+#: Keys whose lists hold positions rather than candidate symbols.
+POSITION_KEYS = frozenset({"positions", "open_positions", "paper_positions", "holdings"})
+
+_ISO_LENGTH = 10
+
+
+def _as_date(text: object) -> date | None:
+    value = str(text)[:_ISO_LENGTH]
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        return None
+
+
+class Purge:
+    """Walks a decoded JSON document, removing only defective current records."""
+
+    def __init__(self, registry: LifecycleRegistry) -> None:
+        self.registry = registry
+        self.removals: list[dict] = []
+        self.position_warnings: list[dict] = []
+
+    def _terminal_on(self, symbol: str, when: date) -> bool:
+        event = self.registry.event_for(symbol, when)
+        return bool(event and event.is_terminal_on(when))
+
+    def _clean_symbol_list(self, values: list, when: date, path: str) -> list:
+        kept = []
+        for value in values:
+            if isinstance(value, str) and self._terminal_on(value, when):
+                self.removals.append({
+                    "path": path, "session": when.isoformat(), "symbol": value,
+                })
+                continue
+            kept.append(value)
+        return kept
+
+    def _clean_position_list(self, values: list, when: date, path: str) -> list:
+        for value in values:
+            if not isinstance(value, dict):
+                continue
+            symbol = str(value.get("symbol", "") or "")
+            if symbol and self._terminal_on(symbol, when):
+                self.position_warnings.append({
+                    "path": path, "session": when.isoformat(), "symbol": symbol,
+                    "state": value.get("state"),
+                })
+        return values
+
+    def walk(self, node, when: date | None, path: str = ""):
+        if isinstance(node, dict):
+            result = {}
+            for key, value in node.items():
+                # A dict keyed by ISO date re-dates everything beneath it.
+                child_when = _as_date(key) or when
+                result[key] = self.walk(value, child_when, f"{path}.{key}")
+            return result
+        if isinstance(node, list):
+            if when is None:
+                return [self.walk(item, when, f"{path}[{index}]")
+                        for index, item in enumerate(node)]
+            leaf = path.rsplit(".", 1)[-1]
+            if leaf in POSITION_KEYS:
+                return self._clean_position_list(node, when, path)
+            if all(isinstance(item, str) for item in node):
+                return self._clean_symbol_list(node, when, path)
+            return [self.walk(item, when, f"{path}[{index}]")
+                    for index, item in enumerate(node)]
+        return node
+
+
+def purge_file(path: Path, registry: LifecycleRegistry, *, apply: bool) -> dict:
+    if not path.exists():
+        return {"file": str(path), "status": "MISSING"}
+    try:
+        document = json.loads(path.read_text(encoding="utf-8"))
+    except (ValueError, json.JSONDecodeError) as error:
+        return {"file": str(path), "status": "UNREADABLE", "detail": str(error)}
+
+    purge = Purge(registry)
+    cleaned = purge.walk(document, None)
+    report = {
+        "file": str(path),
+        "status": "CLEAN" if not purge.removals else ("UPDATED" if apply else "WOULD_UPDATE"),
+        "removals": purge.removals,
+        "position_warnings": purge.position_warnings,
+    }
+    if purge.removals and apply:
+        shutil.copy2(path, path.with_suffix(path.suffix + ".bak"))
+        path.write_text(json.dumps(cleaned, indent=2, sort_keys=True), encoding="utf-8")
+        report["backup"] = str(path.with_suffix(path.suffix + ".bak"))
+    return report
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--apply", action="store_true",
+                        help="write the changes; without it this is a dry run")
+    parser.add_argument("--file", action="append", default=None,
+                        help="state file to clean; repeatable")
+    parser.add_argument("--snapshot",
+                        default="corporate_data/normalized/security_lifecycle_events.csv")
+    args = parser.parse_args(argv)
+
+    events = read_snapshot(args.snapshot)
+    if not events:
+        print(f"No lifecycle events in {args.snapshot}; nothing to purge.")
+        return 0
+    registry = LifecycleRegistry(events)
+    print(f"Lifecycle registry: {len(events)} event(s), "
+          f"{len(registry.symbols)} symbol(s)")
+    for symbol in sorted(registry.symbols):
+        for event in registry.events_for(symbol):
+            boundary = event.terminal_from
+            print(f"  {event.describe()}"
+                  + (f" | terminal from {boundary.isoformat()}" if boundary else ""))
+
+    targets = [Path(name) for name in (args.file or DEFAULT_STATE_FILES)]
+    total_removed = 0
+    total_warnings = 0
+    for path in targets:
+        report = purge_file(path, registry, apply=args.apply)
+        removals = report.get("removals", [])
+        warnings = report.get("position_warnings", [])
+        total_removed += len(removals)
+        total_warnings += len(warnings)
+        print(f"\n{report['file']}: {report['status']}")
+        by_symbol: dict[str, list[str]] = {}
+        for entry in removals:
+            by_symbol.setdefault(entry["symbol"], []).append(entry["session"])
+        for symbol, sessions in sorted(by_symbol.items()):
+            span = f"{min(sessions)} .. {max(sessions)}" if len(sessions) > 1 else sessions[0]
+            print(f"  remove {symbol}: {len(sessions)} session(s) [{span}]")
+        for entry in warnings:
+            print(f"  ⚠️  OPEN POSITION in terminal symbol {entry['symbol']} "
+                  f"({entry['state']}) at {entry['path']}")
+            print("      Not removed. Resolve through universe reconciliation, "
+                  "which records a corporate conversion or a terminal exit.")
+
+    print(f"\nTotal defective records: {total_removed}")
+    print(f"Positions needing reconciliation: {total_warnings}")
+    if not args.apply and total_removed:
+        print("\nDry run. Re-run with --apply to write, keeping a .bak of each file.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
