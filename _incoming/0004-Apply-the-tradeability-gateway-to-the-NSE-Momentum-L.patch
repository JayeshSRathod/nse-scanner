index 0000000..b4f82dd
--- /dev/null
+++ b/tests/test_ladder_tradeability_wiring.py
@@ -0,0 +1,216 @@
+"""Step 5: the gateway must govern the Momentum Ladder.
+
+Before this, ``old_nse_hull.discovery.discover`` applied exactly three filters —
+history >= 67 sessions, close >= 50, 20-day mean volume >= 50,000 — with no
+series check, no security-master join, no blacklist and no per-symbol price
+freshness.  On real data that let 112 stale symbols and JBCHEPHARM rank on their
+final close.  Its report was also dated by whichever symbol ranked first.
+"""
+from __future__ import annotations
+
+import sqlite3
+from datetime import date, timedelta
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from old_nse_hull.discovery import discover, load_market_data
+from old_nse_hull.engine import run_local
+from v2.database import V2Database
+from v2.security_lifecycle import LifecycleEvent, upsert_events
+from v2.tradeability import evaluate_universe
+
+MARKET_DATE = "2026-08-20"
+
+
+def _weekdays(count: int, end: str) -> list[str]:
+    days: list[str] = []
+    cursor = date.fromisoformat(end)
+    while len(days) < count:
+        if cursor.weekday() < 5:
+            days.append(cursor.isoformat())
+        cursor -= timedelta(days=1)
+    return sorted(days)
+
+
+FRESH = _weekdays(90, MARKET_DATE)
+STALE = _weekdays(90, "2026-07-16")
+
+
+def _frame(symbol: str, days: list[str], base: float, drift: float) -> pd.DataFrame:
+    closes = [base * (1.0 + drift) ** i for i in range(len(days))]
+    return pd.DataFrame({
+        "symbol": symbol, "trade_date": pd.to_datetime(days),
+        "open": [c * 0.995 for c in closes], "high": [c * 1.01 for c in closes],
+        "low": [c * 0.99 for c in closes], "close": closes, "volume": 400_000,
+    })
+
+
+def _master(symbol: str) -> dict:
+    return {"symbol": symbol, "series": "EQ", "active": 1}
+
+
+JBCHEPHARM_EVENT = LifecycleEvent(
+    symbol="JBCHEPHARM", event_type="AMALGAMATION", status="EFFECTIVE",
+    effective_date="2026-07-08", record_date="2026-07-17",
+    last_trading_date="2026-07-16", successor_symbol="TORNTPHARM",
+    exchange_ratio_from=100.0, exchange_ratio_to=51.0, terminal=True,
+)
+
+#: LEADER is the strongest mover but is stale, so it used to rank first and
+#: date the whole report from 2026-07-16.
+UNIVERSE = {
+    "STALELEADER": (STALE, 100.0, 0.020),
+    "JBCHEPHARM": (STALE, 1800.0, 0.015),
+    "GOODCO": (FRESH, 300.0, 0.010),
+    "ALSOGOOD": (FRESH, 450.0, 0.008),
+    "GOLDBEES": (FRESH, 80.0, 0.012),      # ETF: absent from the EQ master
+}
+
+
+def _prices() -> pd.DataFrame:
+    return pd.concat(
+        [_frame(sym, *spec) for sym, spec in UNIVERSE.items()], ignore_index=True,
+    ).sort_values(["symbol", "trade_date"])
+
+
+def _verdict(prices: pd.DataFrame):
+    return evaluate_universe(
+        prices, market_date=MARKET_DATE,
+        master={s: _master(s) for s in ("STALELEADER", "GOODCO", "ALSOGOOD")},
+        lifecycle=[JBCHEPHARM_EVENT],
+    )
+
+
+# --- discovery --------------------------------------------------------------
+
+def test_ungated_discovery_still_ranks_the_stale_leader():
+    """Baseline behaviour, kept as evidence of what the gateway fixes."""
+    result = discover(_prices(), top_n=25)
+    assert "STALELEADER" in set(result.shortlist["symbol"])
+    assert "JBCHEPHARM" in set(result.shortlist["symbol"])
+
+
+def test_gated_discovery_drops_stale_and_terminal_symbols():
+    prices = _prices()
+    result = discover(prices, top_n=25, verdict=_verdict(prices))
+    symbols = set(result.shortlist["symbol"])
+    assert "STALELEADER" not in symbols
+    assert "JBCHEPHARM" not in symbols
+    assert {"GOODCO", "ALSOGOOD"} <= symbols
+
+
+def test_gateway_reason_codes_appear_in_the_rejection_counters():
+    prices = _prices()
+    result = discover(prices, top_n=25, verdict=_verdict(prices))
+    assert result.rejected["TERMINAL_MERGER"] == 1
+    assert result.rejected["STALE_SYMBOL_PRICE"] == 1
+    # the original strategy counters survive
+    assert {"insufficient_history", "low_price", "low_volume"} <= set(result.rejected)
+
+
+def test_report_is_dated_by_the_market_not_by_the_top_ranked_symbol():
+    prices = _prices()
+    ungated = discover(prices, top_n=25)
+    assert ungated.as_of_date == MARKET_DATE, "market date must not come from a symbol"
+    gated = discover(prices, top_n=25, verdict=_verdict(prices))
+    assert gated.as_of_date == MARKET_DATE
+    assert gated.market_date == MARKET_DATE
+
+
+def test_etf_is_shortlisted_but_marked_observe_only():
+    prices = _prices()
+    result = discover(prices, top_n=25, verdict=_verdict(prices))
+    row = result.shortlist.set_index("symbol").loc["GOLDBEES"]
+    assert row["instrument_class"] == "NON_EQ_UNVERIFIED"
+    assert bool(row["entry_permitted"]) is False
+
+
+def test_equities_remain_entry_permitted():
+    prices = _prices()
+    result = discover(prices, top_n=25, verdict=_verdict(prices))
+    row = result.shortlist.set_index("symbol").loc["GOODCO"]
+    assert row["instrument_class"] == "EQUITY"
+    assert bool(row["entry_permitted"]) is True
+
+
+def test_gateway_diagnostics_are_carried_on_the_result():
+    prices = _prices()
+    result = discover(prices, top_n=25, verdict=_verdict(prices))
+    assert result.gateway["terminal_symbols"] == ["JBCHEPHARM"]
+    assert result.gateway["market_date"] == MARKET_DATE
+
+
+def test_empty_price_frame_is_survivable():
+    empty = pd.DataFrame(columns=["symbol", "trade_date", "close", "volume"])
+    result = discover(empty, top_n=25)
+    assert result.eligible == 0
+    assert result.shortlist.empty
+
+
+# --- run_local end to end ---------------------------------------------------
+
+@pytest.fixture()
+def database(tmp_path: Path) -> Path:
+    path = tmp_path / "nse_scanner.db"
+    prices = _prices()
+    with sqlite3.connect(path) as conn:
+        conn.execute("""CREATE TABLE daily_prices_v2 (
+            symbol TEXT NOT NULL, trade_date TEXT NOT NULL, open REAL, high REAL,
+            low REAL, close REAL, volume REAL, PRIMARY KEY(symbol, trade_date))""")
+        conn.execute("""CREATE TABLE symbol_master_v2 (
+            symbol TEXT PRIMARY KEY, isin TEXT, company_name TEXT, series TEXT,
+            sector TEXT, industry TEXT, listing_date TEXT, delisting_date TEXT,
+            active INTEGER NOT NULL DEFAULT 1,
+            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)""")
+        rows = prices.copy()
+        rows["trade_date"] = rows["trade_date"].dt.strftime("%Y-%m-%d")
+        conn.executemany(
+            "INSERT INTO daily_prices_v2 (symbol,trade_date,open,high,low,close,volume)"
+            " VALUES (?,?,?,?,?,?,?)",
+            [tuple(r) for r in rows[["symbol", "trade_date", "open", "high",
+                                     "low", "close", "volume"]].itertuples(index=False)],
+        )
+        conn.executemany(
+            "INSERT INTO symbol_master_v2 (symbol, series, active) VALUES (?,?,?)",
+            [(s, "EQ", 1) for s in ("STALELEADER", "GOODCO", "ALSOGOOD")],
+        )
+    V2Database(path).ensure_v3_schema()
+    with sqlite3.connect(path) as conn:
+        upsert_events(conn, [JBCHEPHARM_EVENT])
+    return path
+
+
+def test_run_local_gates_the_shortlist_and_dates_the_report(database):
+    report = run_local(str(database), as_of=MARKET_DATE, top_n=25)
+    symbols = {row["symbol"] for row in report["shortlist"]}
+    assert "JBCHEPHARM" not in symbols
+    assert "STALELEADER" not in symbols
+    assert report["market_date"] == MARKET_DATE
+    assert report["as_of_date"] == MARKET_DATE
+    assert report["tradeability"]["terminal_symbols"] == ["JBCHEPHARM"]
+
+
+def test_ready_alone_no_longer_authorises_a_paper_entry(database):
+    """An observe-only symbol may reach READY but must not be paper-enabled."""
+    report = run_local(str(database), as_of=MARKET_DATE, top_n=25)
+    for row in report["shortlist"]:
+        if not row["entry_permitted"]:
+            assert row["paper_entry_enabled"] is False
+        if row["paper_entry_enabled"]:
+            assert row["hull_state"] == "READY" and row["entry_permitted"]
+
+
+def test_entry_withheld_symbols_are_named_in_the_report(database):
+    report = run_local(str(database), as_of=MARKET_DATE, top_n=25)
+    shortlisted = {row["symbol"] for row in report["shortlist"]}
+    if "GOLDBEES" in shortlisted:
+        assert "GOLDBEES" in report["entry_withheld"]
+
+
+def test_historical_replay_before_the_merger_still_ranks_the_symbol(database):
+    report = run_local(str(database), as_of="2026-07-16", top_n=25)
+    assert report["market_date"] == "2026-07-16"
+    assert report["tradeability"]["terminal_symbols"] == []
+    assert "JBCHEPHARM" in {row["symbol"] for row in report["shortlist"]}
-- 
