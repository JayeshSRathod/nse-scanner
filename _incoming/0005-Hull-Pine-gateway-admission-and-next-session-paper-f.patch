+def _setup_event(state: dict, trade_date: str, setup: dict, event: str) -> None:
+    state["events"].append({"date": trade_date, "event": event, "setup_id": setup["setup_id"],
+                            "symbol": setup["symbol"], "state": setup["state"]})
