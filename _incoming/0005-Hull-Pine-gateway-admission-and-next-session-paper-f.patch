+def _entry_range(row: dict, config: PineConfig) -> tuple[float, float]:
+    """The band a later session must trade through for the setup to fill.
+
+    The lower bound is the signal bar's own high: the setup is confirmed only by
+    trade above it, never by the signal close itself.  The upper bound caps the
+    chase at ``max_chase_atr`` so a runaway gap is declined rather than filled
+    at an unobtainable price.
+    """
+    trigger = _number(row.get("high"), _number(row.get("close")))
+    ceiling = trigger + config.max_chase_atr * _number(row.get("atr14"))
+    return round(trigger, 2), round(ceiling, 2)
+
+
+def _build_setup(symbol: str, row: dict, trade_date: str, config: PineConfig) -> dict:
+    entry_low, entry_high = _entry_range(row, config)
+    return {
+        "setup_id": f"PINE-SETUP-{trade_date.replace('-', '')}-{uuid4().hex[:8].upper()}",
+        "symbol": symbol, "state": SETUP_PENDING, "created_date": trade_date,
+        "signal_close": _number(row.get("close")), "entry_low": entry_low, "entry_high": entry_high,
+        "initial_stop": _number(row.get("initial_stop")), "target1": _number(row.get("target1")),
+        "target2": _number(row.get("target2")), "score": _number(row.get("score")),
+        "timing_state": str(row.get("timing_state", "READY")), "htf_state": str(row.get("htf_state", "NEUTRAL")),
+        "prior_hma21": _number(row.get("hma21")), "sessions_waited": 0,
+        "expires_after_sessions": config.setup_validity_sessions,
+    }
+
+
+def _evaluate_trigger(setup: dict, bar: pd.Series, config: PineConfig) -> dict:
+    """Decide whether a pending setup fills on this bar, and at what price.
+
+    Returns ``{"outcome": ..., "fill": float | None, "reason": str}`` where
+    outcome is ``FILLED``, ``WAITING`` or ``DECLINED``.
+    """
+    high, low, open_ = _number(bar["high"]), _number(bar["low"]), _number(bar["open"])
+    entry_low, entry_high = _number(setup["entry_low"]), _number(setup["entry_high"])
+
+    # No two-way trading: a bar with no range is frozen, typically an upper or
+    # lower circuit lock. It is not executable at any price.
+    if high <= low:
+        return {"outcome": "WAITING", "fill": None, "reason": "CIRCUIT_LOCKED"}
+    if high < entry_low:
+        return {"outcome": "WAITING", "fill": None, "reason": "TRIGGER_NOT_REACHED"}
+    if open_ > entry_high:
+        return {"outcome": "DECLINED", "fill": None, "reason": "GAP_BEYOND_ENTRY_RANGE"}
+    fill = min(max(open_, entry_low), entry_high)
+    if fill <= _number(setup["initial_stop"]):
+        return {"outcome": "DECLINED", "fill": None, "reason": "FILL_BELOW_STOP"}
+    return {"outcome": "FILLED", "fill": round(fill, 2), "reason": "TRADED_THROUGH_ENTRY_RANGE"}
+
