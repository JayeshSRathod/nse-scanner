+
+def test_an_already_held_symbol_does_not_get_a_duplicate_setup(tmp_path: Path):
+    db, state_path = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    _write(db, {"PINE": frame})
