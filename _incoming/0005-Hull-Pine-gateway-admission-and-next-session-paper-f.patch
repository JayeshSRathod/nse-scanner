+    state_path.write_text(json.dumps({
+        "version": 1, "capital_base": 300_000.0, "last_run": "2026-08-20",
+        "events": [], "positions": [
+            {"trade_id": "PINE-20260810-AAAA", "symbol": "BERGEPAINT", "state": "OPEN",
+             "entry_date": "2026-08-20", "entry": 528.55, "quantity": 10,
+             "initial_stop": 500.0, "stop": 500.0, "target1": 560.0, "target2": 590.0},
+        ],
+    }), encoding="utf-8")
+    state = load_state(state_path)
+    assert state["version"] == 2
+    assert len(state["positions"]) == 1
+    assert state["positions"][0]["entry"] == 528.55
+    assert state["positions"][0]["fill_rule"] == "SIGNAL_CLOSE_LEGACY"
+    assert state["pending"] == []
 
 
 def test_pine_signal_message_matches_compact_daily_candidate_style() -> None:
diff --git a/tests/test_pine_hull_next_session_fill.py b/tests/test_pine_hull_next_session_fill.py
new file mode 100755
index 0000000..1d32449
--- /dev/null
+++ b/tests/test_pine_hull_next_session_fill.py
@@ -0,0 +1,364 @@
+"""Steps 6 and 9: Hull Pine gateway admission and next-session paper fills.
+
+Hull Pine had the largest gap of the three scanners.  It loaded every symbol
+with 300 sessions, consulted no security master, no active flag and no corporate
+lifecycle, and booked a paper entry at the signal bar's own closing price — a
+price no order could have been filled at.  Its live state file showed the
+consequence: 13 of 16 paper positions were ETFs and index funds.
+
+Lifecycle now: BUILD -> NEAR -> READY -> TRIGGERED -> ENTERED.
+"""
+from __future__ import annotations
+
+import json
+import sqlite3
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from pine_hull.engine import (
+    PineConfig,
+    _evaluate_trigger,
+    load_state,
+    pine_metrics,
+    run_daily,
+)
+from v2.database import V2Database
+from v2.security_lifecycle import LifecycleEvent, upsert_events
+
+CONFIG = PineConfig(capital_base=300_000.0)
+
+
+def _uptrend(rows: int = 330, base: float = 100.0, top: float = 260.0) -> pd.DataFrame:
+    """A clean uptrend that reaches Hull READY on its final bar."""
+    dates = pd.bdate_range("2025-01-02", periods=rows)
+    close = pd.Series(np.linspace(base, top, rows))
+    return pd.DataFrame({
+        "trade_date": dates, "open": close - 0.3, "high": close + 3.0,
+        "low": close - 3.0, "close": close, "volume": 150_000,
+    })
+
+
+def _append_bar(frame: pd.DataFrame, *, open_: float, high: float,
+                low: float, close: float) -> pd.DataFrame:
+    nxt = frame["trade_date"].iloc[-1] + pd.offsets.BDay(1)
+    row = pd.DataFrame([{
+        "trade_date": nxt, "open": open_, "high": high, "low": low,
+        "close": close, "volume": 150_000,
+    }])
+    return pd.concat([frame, row], ignore_index=True)
+
+
+def _write(path: Path, frames: dict[str, pd.DataFrame],
+           master: dict[str, tuple[str, int]] | None = None,
+           events: list[LifecycleEvent] | None = None) -> None:
+    master = master if master is not None else {s: ("EQ", 1) for s in frames}
+    with sqlite3.connect(path) as conn:
+        conn.execute("""CREATE TABLE IF NOT EXISTS daily_prices_v2 (
+            symbol TEXT, trade_date TEXT, open REAL, high REAL, low REAL,
+            close REAL, volume REAL, PRIMARY KEY(symbol, trade_date))""")
+        conn.execute("""CREATE TABLE IF NOT EXISTS symbol_master_v2 (
+            symbol TEXT PRIMARY KEY, isin TEXT, company_name TEXT, series TEXT,
+            sector TEXT, industry TEXT, listing_date TEXT, delisting_date TEXT,
+            active INTEGER NOT NULL DEFAULT 1,
+            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)""")
+        conn.execute("DELETE FROM daily_prices_v2")
+        conn.execute("DELETE FROM symbol_master_v2")
+        for symbol, frame in frames.items():
+            loaded = frame.assign(symbol=symbol)[
+                ["symbol", "trade_date", "open", "high", "low", "close", "volume"]].copy()
+            loaded["trade_date"] = loaded["trade_date"].dt.strftime("%Y-%m-%d")
+            loaded.to_sql("daily_prices_v2", conn, if_exists="append", index=False)
+        conn.executemany(
+            "INSERT INTO symbol_master_v2 (symbol, series, active) VALUES (?,?,?)",
+            [(s, series, active) for s, (series, active) in master.items()],
+        )
+    V2Database(path).ensure_v3_schema()
+    if events:
+        with sqlite3.connect(path) as conn:
+            upsert_events(conn, events)
+
+
+# --- the trigger rule in isolation -----------------------------------------
+
+BASE_SETUP = {
+    "setup_id": "S1", "symbol": "X", "state": "READY_PENDING",
+    "created_date": "2026-08-20", "signal_close": 100.0,
+    "entry_low": 103.0, "entry_high": 105.0, "initial_stop": 95.0,
+    "target1": 110.0, "target2": 120.0, "prior_hma21": 99.0,
+    "sessions_waited": 0, "expires_after_sessions": 5,
+}
+
+
+def _bar(open_: float, high: float, low: float, close: float) -> pd.Series:
+    return pd.Series({"open": open_, "high": high, "low": low, "close": close})
+
+
+def test_bar_that_never_reaches_the_trigger_keeps_waiting():
+    outcome = _evaluate_trigger(BASE_SETUP, _bar(100.0, 102.0, 99.0, 101.0), CONFIG)
+    assert outcome["outcome"] == "WAITING"
+    assert outcome["reason"] == "TRIGGER_NOT_REACHED"
+
+
+def test_bar_trading_through_the_range_fills_at_the_trigger():
+    outcome = _evaluate_trigger(BASE_SETUP, _bar(101.0, 106.0, 100.5, 105.5), CONFIG)
+    assert outcome["outcome"] == "FILLED"
+    assert outcome["fill"] == 103.0, "fill is the trigger, not the bar's close"
+
+
+def test_open_inside_the_range_fills_at_the_open():
+    outcome = _evaluate_trigger(BASE_SETUP, _bar(104.0, 108.0, 103.5, 107.0), CONFIG)
+    assert outcome["outcome"] == "FILLED"
+    assert outcome["fill"] == 104.0
+
+
+def test_gap_beyond_the_range_is_declined_not_chased():
+    outcome = _evaluate_trigger(BASE_SETUP, _bar(112.0, 118.0, 111.0, 117.0), CONFIG)
+    assert outcome["outcome"] == "DECLINED"
+    assert outcome["reason"] == "GAP_BEYOND_ENTRY_RANGE"
+
+
+def test_frozen_bar_is_not_executable():
+    """A bar with no range is circuit-locked; there is no fill at any price."""
+    outcome = _evaluate_trigger(BASE_SETUP, _bar(104.0, 104.0, 104.0, 104.0), CONFIG)
+    assert outcome["outcome"] == "WAITING"
+    assert outcome["reason"] == "CIRCUIT_LOCKED"
+
+
+def test_fill_below_the_stop_is_refused():
+    setup = {**BASE_SETUP, "initial_stop": 104.5}
+    outcome = _evaluate_trigger(setup, _bar(101.0, 106.0, 100.0, 105.0), CONFIG)
+    assert outcome["outcome"] == "DECLINED"
+    assert outcome["reason"] == "FILL_BELOW_STOP"
+
+
+# --- end-to-end lifecycle ---------------------------------------------------
+
+def test_ready_then_trigger_produces_a_next_session_entry(tmp_path: Path):
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    _write(db, {"PINE": frame})
+    first = run_daily(db, state_path=state, config=CONFIG)
+    assert first["created"] == []
+    setup = first["pending"][0]
+    signal_date, trigger = setup["created_date"], setup["entry_low"]
+
+    # A later session trades decisively through the entry range.
+    extended = _append_bar(frame, open_=trigger - 1.0, high=trigger + 4.0,
+                           low=trigger - 2.0, close=trigger + 3.0)
+    _write(db, {"PINE": extended})
+    second = run_daily(db, state_path=state, config=CONFIG)
+
+    assert len(second["created"]) == 1
+    position = second["created"][0]
+    assert position["entry"] == pytest.approx(trigger, abs=0.01)
+    assert position["fill_rule"] == "NEXT_SESSION_TRIGGER"
+    assert position["signal_date"] == signal_date
+    assert position["entry_date"] > signal_date, "entry must be a later session"
+    assert position["setup_id"] == setup["setup_id"]
+    assert position["state"] == "OPEN"
+    assert second["pending"] == []
+
+
+def test_setup_survives_a_quiet_session_without_filling(tmp_path: Path):
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    _write(db, {"PINE": frame})
+    first = run_daily(db, state_path=state, config=CONFIG)
+    trigger = first["pending"][0]["entry_low"]
+
+    quiet = _append_bar(frame, open_=trigger - 5.0, high=trigger - 1.0,
+                        low=trigger - 6.0, close=trigger - 2.0)
+    _write(db, {"PINE": quiet})
+    second = run_daily(db, state_path=state, config=CONFIG)
+
+    assert second["created"] == []
+    assert len(second["pending"]) == 1
+    assert second["pending"][0]["sessions_waited"] == 1
+    assert second["pending"][0]["last_outcome"] == "TRIGGER_NOT_REACHED"
+
+
+def test_setup_expires_after_its_validity_window(tmp_path: Path):
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    config = PineConfig(capital_base=300_000.0, setup_validity_sessions=2)
+    frame = _uptrend()
+    _write(db, {"PINE": frame})
+    first = run_daily(db, state_path=state, config=config)
+    trigger = first["pending"][0]["entry_low"]
+
+    quiet = frame
+    for _ in range(2):
+        quiet = _append_bar(quiet, open_=trigger - 5.0, high=trigger - 1.0,
+                            low=trigger - 6.0, close=trigger - 2.0)
+        _write(db, {"PINE": quiet})
+        result = run_daily(db, state_path=state, config=config)
+
+    assert result["created"] == []
+    assert any(s["expiry_reason"] == "SETUP_TIMED_OUT" for s in result["expired_setups"])
+    assert all(s["state"] != "READY_PENDING" for s in result["pending"])
+
+
+def test_gap_beyond_range_expires_the_setup_without_an_entry(tmp_path: Path):
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    _write(db, {"PINE": frame})
+    first = run_daily(db, state_path=state, config=CONFIG)
+    setup = first["pending"][0]
+
+    gapped = _append_bar(frame, open_=setup["entry_high"] + 10.0,
+                         high=setup["entry_high"] + 15.0,
+                         low=setup["entry_high"] + 9.0,
+                         close=setup["entry_high"] + 14.0)
+    _write(db, {"PINE": gapped})
+    second = run_daily(db, state_path=state, config=CONFIG)
+
+    assert second["created"] == []
+    assert second["expired_setups"][0]["expiry_reason"] == "GAP_BEYOND_ENTRY_RANGE"
+
+
+def test_events_record_the_full_setup_to_entry_trail(tmp_path: Path):
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    _write(db, {"PINE": frame})
+    first = run_daily(db, state_path=state, config=CONFIG)
+    trigger = first["pending"][0]["entry_low"]
+    extended = _append_bar(frame, open_=trigger - 1.0, high=trigger + 4.0,
+                           low=trigger - 2.0, close=trigger + 3.0)
+    _write(db, {"PINE": extended})
+    run_daily(db, state_path=state, config=CONFIG)
+
+    events = [e["event"] for e in load_state(state)["events"]]
+    assert "SETUP_CREATED" in events
+    assert "SETUP_TRIGGERED" in events
+    assert "ENTRY" in events
+
+
+# --- gateway admission ------------------------------------------------------
+
+def test_symbol_absent_from_the_master_gets_no_setup(tmp_path: Path):
+    """This is why GSEC10IETF and friends reached the paper portfolio."""
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    _write(db, {"GOLDBEES": _uptrend()}, master={})
+    result = run_daily(db, state_path=state, config=CONFIG)
+    assert result["created"] == []
+    assert result["pending"] == []
+    assert result["tradeability"]["non_eq_unverified"] == 1
+    # ...but it is still observed.
+    assert result["evaluated"] == 1
+
+
+def test_terminal_symbol_is_excluded_from_hull_scoring(tmp_path: Path):
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    # The scheme must actually have taken effect before the market date this
+    # synthetic universe ends on, otherwise the symbol is legitimately live.
+    last_traded = (frame["trade_date"].iloc[-40]).date().isoformat()
+    effective = (frame["trade_date"].iloc[-45]).date().isoformat()
+    event = LifecycleEvent(
+        symbol="JBCHEPHARM", event_type="AMALGAMATION", status="EFFECTIVE",
+        effective_date=effective, last_trading_date=last_traded,
+        successor_symbol="TORNTPHARM", exchange_ratio_from=100.0,
+        exchange_ratio_to=51.0, terminal=True,
+    )
+    _write(db, {"JBCHEPHARM": frame, "PINE": frame}, events=[event])
+    result = run_daily(db, state_path=state, config=CONFIG)
+    assert "JBCHEPHARM" not in {row["symbol"] for row in result["pending"]}
+    assert "JBCHEPHARM" not in {row["symbol"] for row in result["watch"]}
+    assert result["tradeability"]["terminal_symbols"] == ["JBCHEPHARM"]
+    assert "PINE" in {row["symbol"] for row in result["pending"]}
+
+
+def test_a_symbol_is_only_terminal_from_its_effective_date(tmp_path: Path):
+    """Historical integrity: a scheme dated in the future must not remove it."""
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    event = LifecycleEvent(
+        symbol="JBCHEPHARM", event_type="AMALGAMATION", status="EFFECTIVE",
+        effective_date="2026-07-08", last_trading_date="2026-07-16",
+        successor_symbol="TORNTPHARM", exchange_ratio_from=100.0,
+        exchange_ratio_to=51.0, terminal=True,
+    )
+    _write(db, {"JBCHEPHARM": frame}, events=[event])
+    result = run_daily(db, state_path=state, config=CONFIG)
+    assert result["market_date"] < "2026-07-17"
+    assert result["tradeability"]["terminal_symbols"] == []
+
+
+def test_inactive_symbol_gets_no_setup(tmp_path: Path):
+    db, state = tmp_path / "p.db", tmp_path / "s.json"
+    _write(db, {"PINE": _uptrend()}, master={"PINE": ("EQ", 0)})
+    result = run_daily(db, state_path=state, config=CONFIG)
+    assert result["pending"] == []
+    assert result["tradeability"]["rejection_counts"]["INACTIVE_SECURITY"] == 1
+
+
+# --- legacy holdings --------------------------------------------------------
+
+def test_observe_only_holding_is_closed_as_a_universe_exit(tmp_path: Path):
+    """The decision taken for the 3 open ETF positions in the live state file."""
+    db, state_path = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    _write(db, {"GSEC10IETF": frame, "PINE": frame}, master={"PINE": ("EQ", 1)})
+    state_path.write_text(json.dumps({
+        "version": 1, "capital_base": 300_000.0, "last_run": None, "events": [],
+        "positions": [
+            {"trade_id": "PINE-OLD-1", "symbol": "GSEC10IETF", "state": "TRAILING",
+             "entry_date": "2026-08-11", "entry": 267.26, "quantity": 224,
+             "initial_stop": 250.0, "stop": 255.0, "target1": 280.0,
+             "target2": 300.0, "last_price": 267.26, "realised_pnl": 0.0},
+        ],
+    }), encoding="utf-8")
+
+    result = run_daily(db, state_path=state_path, config=CONFIG)
+    closed = [p for p in result["positions"] if p["symbol"] == "GSEC10IETF"]
+    assert closed and closed[0]["state"] == "CLOSED"
+    assert closed[0]["exit_reason"] == "UNIVERSE_EXIT"
+    assert closed[0]["exit_detail"] == "NON_EQ_UNVERIFIED_HOLDING"
+    assert any(r["symbol"] == "GSEC10IETF" for r in result["reconciled"])
+
+
+def test_a_still_valid_equity_holding_is_left_alone(tmp_path: Path):
+    db, state_path = tmp_path / "p.db", tmp_path / "s.json"
+    frame = _uptrend()
+    _write(db, {"PINE": frame})
+    state_path.write_text(json.dumps({
+        "version": 1, "capital_base": 300_000.0, "last_run": None, "events": [],
+        "positions": [
+            {"trade_id": "PINE-OLD-2", "symbol": "PINE", "state": "OPEN",
+             "entry_date": "2026-08-01", "entry": 200.0, "quantity": 10,
+             "initial_stop": 150.0, "stop": 150.0, "target1": 280.0,
+             "target2": 300.0, "last_price": 250.0, "realised_pnl": 0.0},
+        ],
+    }), encoding="utf-8")
+
+    result = run_daily(db, state_path=state_path, config=CONFIG)
