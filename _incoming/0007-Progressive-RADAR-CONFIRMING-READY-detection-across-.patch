+#: Hull Pine's own five-step setup lifecycle, mapped onto the shared stages.
+SETUP_STAGE_BUILD = "BUILD"
+SETUP_STAGE_NEAR = "NEAR"
+SETUP_STAGE_READY = "READY"
+SETUP_STAGE_TRIGGERED = "TRIGGERED"
+SETUP_STAGE_ENTERED = "ENTERED"
+
+
+def _setup_stage(row: dict, *, has_pending: bool, is_held: bool) -> str:
+    """Where a symbol sits on BUILD -> NEAR -> READY -> TRIGGERED -> ENTERED."""
+    if is_held:
+        return SETUP_STAGE_ENTERED
+    if has_pending:
+        return SETUP_STAGE_READY
+    timing = str(row.get("timing_state", "WEAK"))
+    if row.get("state") == "READY":
+        return SETUP_STAGE_NEAR
+    if timing == "EARLY":
+        return SETUP_STAGE_BUILD
+    return SETUP_STAGE_BUILD if row.get("daily_bullish") else "WEAK"
+
+
+def _stage_score(row: dict) -> float:
+    """Map the existing 0-100 Hull score onto the shared bands unchanged."""
+    return _number(row.get("score"))
+
+
 def _setup_event(state: dict, trade_date: str, setup: dict, event: str) -> None:
     state["events"].append({"date": trade_date, "event": event, "setup_id": setup["setup_id"],
