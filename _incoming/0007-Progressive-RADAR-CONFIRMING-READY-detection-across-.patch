index 0000000..38cc692
--- /dev/null
+++ b/v2/progressive_stages.py
@@ -0,0 +1,376 @@
+"""Progressive detection stages shared in *shape* by every scanner.
+
+The problem this solves
+----------------------
+When every criterion is compulsory from the first pass, a scanner only ever
+identifies mature setups and structurally cannot see a move beginning.  V3 shows
+this plainly: on 2026-08-20 it admitted 2,157 symbols and rejected 1,522 of
+them, most for liquidity and delivery thresholds that a stock only satisfies
+*after* participation has already expanded.
+
+The fix is not to weaken the entry rules.  It is to separate three questions
+that were previously collapsed into one:
+
+===============  ==========================================  ==========
+Stage            Question                                    Strictness
+===============  ==========================================  ==========
+``RADAR``        Is something starting?                      Flexible
+``CONFIRMING``   Is the participation genuine?               Moderate
+``READY``        May we authorise an entry?                  Strict
+===============  ==========================================  ==========
+
+A symbol reaches Telegram at ``RADAR``.  Only ``READY`` authorises a paper
+entry.  Entry quality is therefore unchanged while early visibility improves.
+
+What is shared and what is not
+------------------------------
+Only the *vocabulary and progression* are shared.  Each scanner keeps its own
+independent strategy rules and its own thresholds — V3 stays a weekly
+relative-strength system, the Momentum Ladder stays a multi-horizon momentum
+ladder, Hull Pine stays a Hull/KAMA trend system.  This module deliberately
+contains no strategy logic.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field
+from typing import Mapping, Sequence
+
+# --- shared vocabulary ------------------------------------------------------
+
+#: Nothing is happening yet.
+UNQUALIFIED = "UNQUALIFIED"
+#: Movement is detectable; this is an observation, not a setup.
+RADAR = "RADAR"
+#: Participation is confirming; still not an entry.
+CONFIRMING = "CONFIRMING"
+#: Strategy conditions are met but an entry gate is still outstanding.
+QUALIFIED = "QUALIFIED"
+#: Every gate is satisfied; an entry may be authorised.
+READY = "READY"
+
+PROGRESSION: tuple[str, ...] = (UNQUALIFIED, RADAR, CONFIRMING, QUALIFIED, READY)
+
+#: Parallel states that describe *availability* rather than progress.  A symbol
+#: in one of these is displayed, never silently discarded, and never entered.
+CIRCUIT_WATCH = "CIRCUIT_WATCH"
+CIRCUIT_LOCKED = "CIRCUIT_LOCKED"
+POST_CIRCUIT_CONFIRMING = "POST_CIRCUIT_CONFIRMING"
+EXTENDED = "EXTENDED"
+CORPORATE_REVIEW = "CORPORATE_REVIEW"
+TERMINATED = "TERMINATED"
+OBSERVE_ONLY = "OBSERVE_ONLY"
+
+AVAILABILITY_STATES: frozenset[str] = frozenset({
+    CIRCUIT_WATCH, CIRCUIT_LOCKED, POST_CIRCUIT_CONFIRMING, EXTENDED,
+    CORPORATE_REVIEW, TERMINATED, OBSERVE_ONLY,
+})
+
+#: States in which no new entry may be authorised, whatever the score.
+ENTRY_BLOCKING_STATES: frozenset[str] = frozenset({
+    CIRCUIT_LOCKED, TERMINATED, CORPORATE_REVIEW, OBSERVE_ONLY, EXTENDED,
+})
+
+_STAGE_RANK = {stage: index for index, stage in enumerate(PROGRESSION)}
+
+#: Display prefix per stage, used by every scanner's Telegram card.
+STAGE_BADGE = {
+    UNQUALIFIED: "⚪",
+    RADAR: "🔵",
+    CONFIRMING: "🟡",
+    QUALIFIED: "🟢",
+    READY: "🟢",
+    EXTENDED: "🔴",
+    CIRCUIT_WATCH: "🟠",
+    CIRCUIT_LOCKED: "🔴",
+    POST_CIRCUIT_CONFIRMING: "🟡",
+    CORPORATE_REVIEW: "⚠️",
+    TERMINATED: "⛔",
+    OBSERVE_ONLY: "⬜",
+}
+
+#: The one-line "what happens next" shown under each card.
+STAGE_NEXT_ACTION = {
+    RADAR: "Confirm sustained participation",
+    CONFIRMING: "Await closed-bar confirmation",
+    QUALIFIED: "Await the entry trigger",
+    READY: "Entry authorised",
+    EXTENDED: "Too far extended; wait for a pullback or base",
+    CIRCUIT_WATCH: "Monitor; liquidity may be one-sided",
+    CIRCUIT_LOCKED: "Entry unavailable; wait for normal two-way trading",
+    POST_CIRCUIT_CONFIRMING: "Normal trading resumed; re-confirm participation",
+    CORPORATE_REVIEW: "Corporate event pending; entry withheld",
+    TERMINATED: "Security is terminal; excluded from current scanning",
+    OBSERVE_ONLY: "Unverified instrument; observation only",
+}
+
+
+def stage_rank(stage: str) -> int:
+    """Ordinal position in the progression; availability states rank as 0."""
+    return _STAGE_RANK.get(stage, 0)
+
+
+def is_at_least(stage: str, minimum: str) -> bool:
+    return stage_rank(stage) >= stage_rank(minimum)
+
+
+def highest(*stages: str) -> str:
+    """The most advanced of several progression stages."""
+    candidates = [s for s in stages if s in _STAGE_RANK]
+    return max(candidates, key=stage_rank) if candidates else UNQUALIFIED
+
+
+@dataclass(frozen=True)
+class StageVerdict:
+    """A symbol's progression stage plus the availability state layered on it."""
+
+    symbol: str
+    stage: str
+    #: Availability state, when one applies. Displayed alongside the stage.
+    availability: str | None = None
+    #: Score on the scanner's own 0-100 scale, when it has one.
+    score: float | None = None
+    #: True when data needed for the strict gates is still missing.
+    data_pending: bool = False
+    #: Human-readable evidence for why this stage was reached.
+    evidence: tuple[str, ...] = ()
+    #: Gates that must still clear before READY.
+    outstanding: tuple[str, ...] = ()
+    detail: str | None = None
+
+    @property
+    def entry_authorised(self) -> bool:
+        """READY, verified, and not blocked by an availability state."""
+        if self.availability in ENTRY_BLOCKING_STATES:
+            return False
+        return self.stage == READY and not self.data_pending
+
+    @property
+    def display_state(self) -> str:
+        """What the card leads with."""
+        return self.availability or self.stage
+
+    @property
+    def badge(self) -> str:
+        return STAGE_BADGE.get(self.display_state, "⚪")
+
+    @property
+    def next_action(self) -> str:
+        return STAGE_NEXT_ACTION.get(self.display_state, "")
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+    def describe(self) -> str:
+        """The card body, without scanner-specific numbers."""
+        header = f"{self.badge} {self.symbol} • {self.display_state}"
+        if self.score is not None:
+            header += f" • {self.score:.0f}/100"
+        lines = [header]
+        if self.data_pending:
+            lines.append("DATA PENDING — strict gates unverified")
+        lines.extend(f"• {item}" for item in self.evidence)
+        if self.outstanding:
+            lines.append("Outstanding: " + ", ".join(self.outstanding))
+        if self.next_action:
+            lines.append(f"Next: {self.next_action}")
+        return "\n".join(lines)
+
+
+# --- score-based classification --------------------------------------------
+
+@dataclass(frozen=True)
+class ScoreBands:
+    """Score thresholds separating the progression stages.
+
+    Defaults follow the sprint specification: 35-49 radar, 50-64 confirming,
+    65+ qualified for review, 70+ with every gate cleared for ready.
+    """
+
+    radar: float = 35.0
+    confirming: float = 50.0
+    qualified: float = 65.0
+    ready: float = 70.0
+
+    def stage_for(self, score: float) -> str:
+        if score >= self.ready:
+            return READY
+        if score >= self.qualified:
+            return QUALIFIED
+        if score >= self.confirming:
+            return CONFIRMING
+        if score >= self.radar:
+            return RADAR
+        return UNQUALIFIED
+
+
+DEFAULT_BANDS = ScoreBands()
+
+
+@dataclass(frozen=True)
+class ScoreComponent:
+    """One weighted contribution to a scanner's 0-100 score."""
+
+    name: str
+    points: float
+    max_points: float
+    #: False when the component could not be measured, so it scores zero but is
+    #: reported as pending rather than as a failure.
+    measured: bool = True
+
+    @property
+    def earned(self) -> float:
+        return max(0.0, min(self.points, self.max_points)) if self.measured else 0.0
+
+
+#: The component weights from the sprint specification.  A scanner supplies its
+#: own measurements; the weighting is shared so scores stay comparable.
+COMPONENT_WEIGHTS: Mapping[str, float] = {
+    "early_momentum": 20.0,
+    "turnover_expansion": 20.0,
+    "trend_formation": 15.0,
+    "base_or_breakout_quality": 15.0,
+    "relative_strength": 10.0,
+    "delivery_participation": 10.0,
+    "executability": 10.0,
+}
+
+
+def compose_score(components: Sequence[ScoreComponent]) -> tuple[float, tuple[str, ...]]:
+    """Total a component list and name the components that could not be measured."""
+    total = sum(component.earned for component in components)
+    pending = tuple(c.name for c in components if not c.measured)
+    return round(min(100.0, max(0.0, total)), 2), pending
+
+
+def classify(
+    symbol: str,
+    score: float,
+    *,
+    bands: ScoreBands = DEFAULT_BANDS,
+    availability: str | None = None,
+    gates_cleared: bool = True,
+    data_pending: bool = False,
+    evidence: Sequence[str] = (),
+    outstanding: Sequence[str] = (),
+    detail: str | None = None,
+) -> StageVerdict:
+    """Turn a score plus gate outcomes into a stage verdict.
+
+    ``gates_cleared`` is the scanner's own strict entry check — trigger, risk
+    geometry, regime permission, executability.  A symbol may score above the
+    ready band and still be held at ``QUALIFIED`` because a gate is outstanding;
+    that is the point of the separation.
+    """
+    stage = bands.stage_for(score)
+    if stage == READY and not (gates_cleared and not data_pending):
+        stage = QUALIFIED
+    return StageVerdict(
+        symbol=symbol, stage=stage, availability=availability, score=score,
+        data_pending=data_pending, evidence=tuple(evidence),
+        outstanding=tuple(outstanding), detail=detail,
+    )
+
+
+# --- availability resolution -------------------------------------------------
+
+def availability_from_gateway(
+    *,
+    eligible: bool,
+    reason_code: str,
+    entry_blocked: bool,
+    review_reason: str | None,
+    instrument_class: str,
+) -> str | None:
+    """Map a tradeability verdict onto an availability state.
+
+    Keeps the gateway's vocabulary and the display vocabulary separate, so the
+    gateway can stay strategy-agnostic while cards stay readable.
+    """
+    if not eligible:
+        if reason_code in {"TERMINAL_MERGER", "DELISTED_SECURITY", "SUSPENDED_SECURITY"}:
+            return TERMINATED
+        return None
+    if instrument_class != "EQUITY":
+        return OBSERVE_ONLY
+    if review_reason == "CORPORATE_ACTION_REVIEW":
+        return CORPORATE_REVIEW
+    if entry_blocked:
+        return CORPORATE_REVIEW
+    return None
+
+
+def circuit_state(
+    *,
+    high: float,
+    low: float,
+    prior_close: float,
+    band_pct: float = 20.0,
+    resumed_normal_trading: bool = False,
+) -> str | None:
+    """Classify circuit behaviour from a single bar.
+
+    A bar with no range at the band edge is locked; a bar that reaches the band
+    but still trades two-way is a watch.  Circuit symbols are displayed under
+    these states rather than dropped, so a mover is never invisible merely
+    because it is temporarily unbuyable.
+    """
+    if prior_close <= 0 or high < low:
+        return None
+    limit = prior_close * (1.0 + band_pct / 100.0)
+    floor_ = prior_close * (1.0 - band_pct / 100.0)
+    at_band = high >= limit * 0.999 or low <= floor_ * 1.001
+    frozen = high <= low
+    if frozen and at_band:
+        return CIRCUIT_LOCKED
+    if frozen:
+        return CIRCUIT_LOCKED
+    if at_band:
+        return POST_CIRCUIT_CONFIRMING if resumed_normal_trading else CIRCUIT_WATCH
+    return None
+
+
+# --- reporting --------------------------------------------------------------
+
+@dataclass
+class StageFunnel:
+    """Counts per stage and availability state, for diagnostics and Telegram."""
+
+    market_date: str
+    stages: dict[str, int] = field(default_factory=dict)
+    availability: dict[str, int] = field(default_factory=dict)
+    entry_authorised: int = 0
+
+    def add(self, verdict: StageVerdict) -> None:
+        self.stages[verdict.stage] = self.stages.get(verdict.stage, 0) + 1
+        if verdict.availability:
+            self.availability[verdict.availability] = \
+                self.availability.get(verdict.availability, 0) + 1
+        if verdict.entry_authorised:
+            self.entry_authorised += 1
+
+    def to_dict(self) -> dict:
+        return {
+            "market_date": self.market_date,
+            "stages": {stage: self.stages.get(stage, 0) for stage in PROGRESSION
+                       if self.stages.get(stage)},
+            "availability": dict(sorted(self.availability.items())),
+            "entry_authorised": self.entry_authorised,
+        }
+
+    def render(self, title: str = "PROGRESSIVE FUNNEL") -> str:
+        lines = [f"{title} — {self.market_date}"]
+        for stage in reversed(PROGRESSION):
+            count = self.stages.get(stage, 0)
+            if count:
+                lines.append(f"{STAGE_BADGE.get(stage, '')} {stage}: {count}")
+        for state, count in sorted(self.availability.items()):
+            lines.append(f"{STAGE_BADGE.get(state, '')} {state}: {count}")
+        lines.append(f"Entry authorised: {self.entry_authorised}")
+        return "\n".join(lines)
+
+
+def build_funnel(market_date: str, verdicts: Sequence[StageVerdict]) -> StageFunnel:
+    funnel = StageFunnel(market_date=market_date)
+    for verdict in verdicts:
+        funnel.add(verdict)
+    return funnel
diff --git a/v2/tiered_eligibility.py b/v2/tiered_eligibility.py
new file mode 100755
index 0000000..f39f8ff
--- /dev/null
+++ b/v2/tiered_eligibility.py
@@ -0,0 +1,209 @@
+"""Tiered V3 eligibility: wide detection, progressive confirmation, strict entry.
+
+V3's eligibility was a single all-or-nothing test at 260 sessions with hard
+market-cap, turnover, delivery and promoter gates.  On 2026-08-20 that rejected
+1,522 of 2,157 admitted symbols, overwhelmingly for thresholds a stock only
+satisfies *after* participation has already expanded — which is exactly the
+phase we wanted to catch.
+
+This module reuses ``evaluate_eligibility`` unchanged and simply runs it at
+three strictness tiers, strictest first.  The first tier a symbol passes is its
+stage:
+
+===================  ========  =======================================
+Tier                 Sessions  Data requirements
+===================  ========  =======================================
+``READY``                 260  Verified market cap and promoter holding
+``CONFIRMING``            180  Turnover and delivery confirmation
+``DISCOVERY_RADAR``       120  Liquidity floor only; fundamentals may be
+                               absent, and the card says DATA PENDING
+===================  ========  =======================================
+
+Nothing about the ``READY`` tier is relaxed.  Entry authorisation still requires
+the full 260-session strict pass, so entry quality is unchanged; only visibility
+below it improves.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping, Sequence
+
+import pandas as pd
+
+from .eligibility import EligibilityResult, evaluate_eligibility
+from .progressive_stages import (
+    CONFIRMING,
+    RADAR,
+    READY,
+    UNQUALIFIED,
+    StageVerdict,
+)
+
+#: Stage name used in V3 reporting for the widest tier.
+DISCOVERY_RADAR = RADAR
+
+
+@dataclass(frozen=True)
+class Tier:
+    """One strictness level and the eligibility parameters that define it."""
+
+    stage: str
+    label: str
+    min_sessions: int
+    params: Mapping[str, object]
+    #: True when this tier does not require verified fundamental data, so a
+    #: symbol admitted here must be shown as DATA PENDING.
+    data_pending: bool = False
+
+
+#: Strictest first.  ``min_price`` and volume floors are held constant across
+#: tiers because they define the tradable universe rather than maturity; only
+#: maturity, participation and data-verification requirements relax.
+V3_TIERS: tuple[Tier, ...] = (
+    Tier(
+        stage=READY, label="READY", min_sessions=260,
+        params={
+            "min_sessions": 260,
+            "min_median_turnover_cr_20": 5.0,
+            "min_delivery_5": 30.0,
+            "min_delivery_20": 25.0,
+            "require_market_cap": True,
+            "require_promoter_holding": True,
+            "require_corporate_action_safety": True,
+        },
+    ),
+    Tier(
+        stage=CONFIRMING, label="CONFIRMING", min_sessions=180,
+        params={
+            "min_sessions": 180,
+            "min_median_turnover_cr_20": 0.5,
+            "min_delivery_5": 0.0,
+            "min_delivery_20": 0.0,
+            "require_market_cap": False,
+            "require_promoter_holding": False,
+            "require_corporate_action_safety": False,
+        },
+        data_pending=True,
+    ),
+    Tier(
+        stage=DISCOVERY_RADAR, label="DISCOVERY_RADAR", min_sessions=120,
+        params={
+            "min_sessions": 120,
+            "min_median_turnover_cr_20": 0.25,
+            "min_delivery_5": 0.0,
+            "min_delivery_20": 0.0,
+            "require_market_cap": False,
+            "require_promoter_holding": False,
+            "require_corporate_action_safety": False,
+        },
+        data_pending=True,
+    ),
+)
+
+#: The lowest session count any tier needs. Prices must be loaded to at least
+#: this depth or the radar tier can never be reached.
+MIN_TIER_SESSIONS = min(tier.min_sessions for tier in V3_TIERS)
+
+
+@dataclass(frozen=True)
+class TieredResult:
+    """The outcome of running every tier for one symbol."""
+
+    symbol: str
+    stage: str
+    #: The eligibility result of the tier that admitted the symbol, or of the
+    #: strictest tier attempted when none did.
+    result: EligibilityResult
+    data_pending: bool
+    #: Reason codes from the tiers the symbol failed, strictest first, so the
+    #: card can say what is still outstanding.
+    outstanding: tuple[str, ...] = ()
+    sessions: int = 0
+
+    @property
+    def eligible(self) -> bool:
+        return self.stage != UNQUALIFIED
+
+    @property
+    def entry_authorised(self) -> bool:
+        return self.stage == READY and not self.data_pending
+
+    def to_stage_verdict(
+        self, *, score: float | None = None, availability: str | None = None,
+        evidence: Sequence[str] = (),
+    ) -> StageVerdict:
+        return StageVerdict(
+            symbol=self.symbol, stage=self.stage, availability=availability,
+            score=score, data_pending=self.data_pending,
+            evidence=tuple(evidence), outstanding=self.outstanding,
+            detail=self.result.reason_code if not self.entry_authorised else None,
+        )
+
+
+def evaluate_tiered_eligibility(
+    symbol: str,
+    frame: pd.DataFrame,
+    *,
+    metadata: Mapping[str, object] | None = None,
+    restricted_reason: str | None = None,
+    as_of_date: str | None = None,
+    tiers: Sequence[Tier] = V3_TIERS,
+    strict: bool = True,
+    **overrides,
+) -> TieredResult:
+    """Return the most advanced tier ``symbol`` satisfies.
+
+    ``strict=False`` reproduces the previous V2-compatible behaviour for the
+    READY tier only; the lower tiers are unaffected because they already do not
+    require verified fundamental data.
+    """
+    sessions = 0
+    if frame is not None and "trade_date" in getattr(frame, "columns", ()):
+        sessions = int(pd.to_datetime(frame["trade_date"], errors="coerce").nunique())
+
+    outstanding: list[str] = []
+    strictest: EligibilityResult | None = None
+    for tier in tiers:
+        params = dict(tier.params)
+        if tier.stage == READY and not strict:
+            params.update({
+                "require_market_cap": False,
+                "require_promoter_holding": False,
+                "require_corporate_action_safety": False,
+            })
+        params.update(overrides)
+        result = evaluate_eligibility(
+            symbol, frame, metadata=metadata, restricted_reason=restricted_reason,
+            as_of_date=as_of_date, **params,
+        )
+        if strictest is None:
+            strictest = result
+        if result.eligible:
+            return TieredResult(
+                symbol=symbol, stage=tier.stage, result=result,
+                data_pending=tier.data_pending, outstanding=tuple(outstanding),
+                sessions=sessions,
+            )
+        outstanding.append(result.reason_code)
+
+    assert strictest is not None
+    return TieredResult(
+        symbol=symbol, stage=UNQUALIFIED, result=strictest, data_pending=True,
+        outstanding=tuple(outstanding), sessions=sessions,
+    )
+
+
+def tier_funnel(results: Mapping[str, TieredResult]) -> dict:
+    """Stage counts plus the reason a symbol stopped where it did."""
+    stages: dict[str, int] = {}
+    blocked_at_ready: dict[str, int] = {}
+    for result in results.values():
+        stages[result.stage] = stages.get(result.stage, 0) + 1
+        if result.stage != READY and result.outstanding:
+            code = result.outstanding[0]
+            blocked_at_ready[code] = blocked_at_ready.get(code, 0) + 1
+    return {
+        "stages": dict(sorted(stages.items(), key=lambda item: -item[1])),
+        "ready_blockers": dict(sorted(blocked_at_ready.items(), key=lambda item: -item[1])),
+        "entry_authorised": sum(1 for r in results.values() if r.entry_authorised),
+    }
