+"""Step 8: progressive RADAR / CONFIRMING / READY detection.
+
+The point of the separation is that entry quality must not change while early
+visibility improves.  These tests assert both halves of that: a symbol below the
+strict bar becomes *visible*, and a symbol that is merely high-scoring does not
+become *enterable*.
+"""
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+import pandas as pd
+import pytest
+
+from v2.progressive_stages import (
+    AVAILABILITY_STATES,
+    CIRCUIT_LOCKED,
+    CIRCUIT_WATCH,
+    CONFIRMING,
+    CORPORATE_REVIEW,
+    OBSERVE_ONLY,
+    PROGRESSION,
+    QUALIFIED,
+    RADAR,
+    READY,
+    TERMINATED,
+    UNQUALIFIED,
+    ScoreBands,
+    ScoreComponent,
+    StageVerdict,
+    availability_from_gateway,
+    build_funnel,
+    circuit_state,
+    classify,
+    compose_score,
+    highest,
+    is_at_least,
+    stage_rank,
+)
+from v2.tiered_eligibility import (
+    MIN_TIER_SESSIONS,
+    V3_TIERS,
+    evaluate_tiered_eligibility,
+    tier_funnel,
+)
+
+
+# --- vocabulary -------------------------------------------------------------
+
+def test_progression_is_strictly_ordered():
+    ranks = [stage_rank(stage) for stage in PROGRESSION]
+    assert ranks == sorted(ranks) == list(range(len(PROGRESSION)))
+
+
+def test_availability_states_rank_as_zero_and_never_imply_progress():
+    for state in AVAILABILITY_STATES:
+        assert stage_rank(state) == 0
+
+
+def test_is_at_least_and_highest():
+    assert is_at_least(READY, CONFIRMING)
+    assert not is_at_least(RADAR, CONFIRMING)
+    assert highest(RADAR, READY, CONFIRMING) == READY
+    assert highest() == UNQUALIFIED
+
+
+@pytest.mark.parametrize("score,expected", [
+    (10.0, UNQUALIFIED), (34.9, UNQUALIFIED),
+    (35.0, RADAR), (44.0, RADAR), (49.9, RADAR),
+    (50.0, CONFIRMING), (59.0, CONFIRMING), (64.9, CONFIRMING),
+    (65.0, QUALIFIED), (69.9, QUALIFIED),
+    (70.0, READY), (82.0, READY), (100.0, READY),
+])
+def test_score_bands_match_the_specification(score, expected):
+    assert ScoreBands().stage_for(score) == expected
+
+
+# --- classification ---------------------------------------------------------
+
+def test_high_score_without_cleared_gates_is_held_at_qualified():
+    """A score is not an authorisation."""
+    verdict = classify("XYZ", 82.0, gates_cleared=False,
+                       outstanding=["ENTRY_TRIGGER", "RISK_GEOMETRY"])
+    assert verdict.stage == QUALIFIED
+    assert verdict.entry_authorised is False
+    assert "ENTRY_TRIGGER" in verdict.outstanding
+
+
+def test_high_score_with_cleared_gates_is_ready():
+    verdict = classify("XYZ", 82.0, gates_cleared=True)
+    assert verdict.stage == READY
+    assert verdict.entry_authorised is True
+
+
+def test_data_pending_prevents_entry_even_at_a_ready_score():
+    verdict = classify("XYZ", 90.0, gates_cleared=True, data_pending=True)
+    assert verdict.stage == QUALIFIED
+    assert verdict.entry_authorised is False
+    assert "DATA PENDING" in verdict.describe()
+
+
+@pytest.mark.parametrize("state", sorted(
+    {CIRCUIT_LOCKED, TERMINATED, CORPORATE_REVIEW, OBSERVE_ONLY}))
+def test_availability_state_blocks_entry_at_any_score(state):
+    verdict = classify("XYZ", 95.0, gates_cleared=True, availability=state)
+    assert verdict.entry_authorised is False
+    assert verdict.display_state == state
+
+
+def test_card_leads_with_availability_but_keeps_the_stage():
+    verdict = classify("NHCFOODS", 82.0, gates_cleared=True, availability=CIRCUIT_LOCKED)
+    assert verdict.display_state == CIRCUIT_LOCKED
+    assert verdict.stage == READY, "progress is recorded even when unavailable"
+    body = verdict.describe()
+    assert "CIRCUIT_LOCKED" in body
+    assert "82/100" in body
+    assert "normal two-way trading" in body
+
+
+def test_radar_card_says_what_happens_next():
+    verdict = classify("ABC", 44.0, gates_cleared=False,
+                       evidence=["5D return +6.8%", "Turnover 1.8x normal"])
+    assert verdict.stage == RADAR
+    body = verdict.describe()
+    assert "🔵" in body and "RADAR" in body
+    assert "Turnover 1.8x normal" in body
+    assert "Next: Confirm sustained participation" in body
+
+
+# --- score composition ------------------------------------------------------
+
+def test_unmeasured_components_score_zero_and_are_reported_pending():
+    total, pending = compose_score([
+        ScoreComponent("early_momentum", 20, 20),
+        ScoreComponent("turnover_expansion", 18, 20),
+        ScoreComponent("delivery_participation", 10, 10, measured=False),
+    ])
+    assert total == 38.0
+    assert pending == ("delivery_participation",)
+
+
+def test_score_is_clamped_to_zero_and_one_hundred():
+    assert compose_score([ScoreComponent("a", 500, 100)])[0] == 100.0
+    assert compose_score([ScoreComponent("a", -50, 100)])[0] == 0.0
+
+
+# --- gateway to availability mapping ---------------------------------------
+
+def test_terminal_gateway_reason_maps_to_terminated():
+    assert availability_from_gateway(
+        eligible=False, reason_code="TERMINAL_MERGER", entry_blocked=True,
+        review_reason=None, instrument_class="EQUITY") == TERMINATED
+
+
+def test_unverified_instrument_maps_to_observe_only():
+    assert availability_from_gateway(
+        eligible=True, reason_code="TRADEABLE", entry_blocked=True,
+        review_reason=None, instrument_class="NON_EQ_UNVERIFIED") == OBSERVE_ONLY
+
+
+def test_pending_scheme_maps_to_corporate_review():
+    assert availability_from_gateway(
+        eligible=True, reason_code="TRADEABLE", entry_blocked=True,
+        review_reason="CORPORATE_ACTION_REVIEW", instrument_class="EQUITY",
+    ) == CORPORATE_REVIEW
+
+
+def test_a_healthy_equity_has_no_availability_state():
+    assert availability_from_gateway(
+        eligible=True, reason_code="TRADEABLE", entry_blocked=False,
+        review_reason=None, instrument_class="EQUITY") is None
+
+
+# --- circuit treatment ------------------------------------------------------
+
+def test_frozen_bar_is_circuit_locked():
+    assert circuit_state(high=120.0, low=120.0, prior_close=100.0) == CIRCUIT_LOCKED
+
+
+def test_two_way_trading_at_the_band_is_a_watch_not_a_lock():
+    assert circuit_state(high=120.0, low=112.0, prior_close=100.0) == CIRCUIT_WATCH
+
+
+def test_normal_bar_has_no_circuit_state():
+    assert circuit_state(high=104.0, low=98.0, prior_close=100.0) is None
+
+
+def test_resumed_trading_at_the_band_is_post_circuit_confirming():
+    state = circuit_state(high=120.0, low=112.0, prior_close=100.0,
+                          resumed_normal_trading=True)
+    assert state == "POST_CIRCUIT_CONFIRMING"
+
+
+# --- funnel -----------------------------------------------------------------
+
+def test_funnel_counts_stages_availability_and_authorisations():
+    funnel = build_funnel("2026-08-20", [
+        classify("A", 44.0, gates_cleared=False),
+        classify("B", 59.0, gates_cleared=False),
+        classify("C", 82.0, gates_cleared=True),
+        classify("D", 82.0, gates_cleared=True, availability=CIRCUIT_LOCKED),
+    ])
+    payload = funnel.to_dict()
+    assert payload["stages"] == {RADAR: 1, CONFIRMING: 1, READY: 2}
+    assert payload["availability"] == {CIRCUIT_LOCKED: 1}
+    assert payload["entry_authorised"] == 1, "the locked symbol must not count"
+    rendered = funnel.render()
+    assert "READY: 2" in rendered and "CIRCUIT_LOCKED: 1" in rendered
+
+
+# --- tiered V3 eligibility --------------------------------------------------
+
+def _history(rows: int, *, turnover_cr: float = 6.0, delivery: float = 55.0,
+             price: float = 400.0, volume: float = 500_000.0) -> pd.DataFrame:
+    days: list[str] = []
+    cursor = date(2026, 8, 20)
+    while len(days) < rows:
+        if cursor.weekday() < 5:
+            days.append(cursor.isoformat())
+        cursor -= timedelta(days=1)
+    days.sort()
+    closes = [price * (1.0 + 0.001 * i) for i in range(rows)]
+    return pd.DataFrame({
+        "symbol": "T", "trade_date": days, "close": closes,
+        "open": [c * 0.997 for c in closes], "high": [c * 1.008 for c in closes],
+        "low": [c * 0.992 for c in closes], "volume": volume,
+        "turnover_lacs": turnover_cr * 100.0, "delivery_pct": delivery,
+        "quality_status": "VALIDATED",
+    })
+
+
+META = {"symbol": "T", "series": "EQ", "active": 1, "market_cap_cr": 5_000.0,
+        "market_cap_as_of": "2026-08-20", "market_cap_source": "DIRECT_SNAPSHOT",
+        "promoter_holding_pct": 55.0, "promoter_holding_as_of": "2026-06-30",
+        "promoter_holding_available_date": "2026-07-15"}
+
+
+def test_a_mature_liquid_stock_reaches_ready():
+    result = evaluate_tiered_eligibility(
+        "T", _history(300), metadata=META, as_of_date="2026-08-20", strict=False)
+    assert result.stage == READY
+    assert result.entry_authorised is True
+    assert result.data_pending is False
+
+
+def test_a_150_session_stock_is_visible_at_radar_instead_of_invisible():
+    """The core fix: previously this symbol produced INSUFFICIENT_HISTORY."""
+    result = evaluate_tiered_eligibility(
+        "T", _history(150), metadata=META, as_of_date="2026-08-20", strict=False)
+    assert result.stage == RADAR
+    assert result.eligible is True
+    assert result.entry_authorised is False, "visible, but not enterable"
+    assert result.data_pending is True
+    assert "INSUFFICIENT_HISTORY" in result.outstanding
+
+
+def test_a_200_session_stock_reaches_confirming():
+    result = evaluate_tiered_eligibility(
+        "T", _history(200), metadata=META, as_of_date="2026-08-20", strict=False)
+    assert result.stage == CONFIRMING
+    assert result.entry_authorised is False
+
+
+def test_below_the_shallowest_tier_the_symbol_is_unqualified():
+    result = evaluate_tiered_eligibility(
+        "T", _history(100), metadata=META, as_of_date="2026-08-20", strict=False)
+    assert result.stage == UNQUALIFIED
+    assert result.eligible is False
+
+
+def test_thin_delivery_holds_a_mature_stock_below_ready_but_keeps_it_visible():
+    result = evaluate_tiered_eligibility(
+        "T", _history(300, delivery=5.0), metadata=META,
+        as_of_date="2026-08-20", strict=False)
+    assert result.stage == CONFIRMING
+    assert result.entry_authorised is False
+    assert any("DELIVERY" in code for code in result.outstanding)
+
+
+def test_the_ready_tier_is_not_relaxed():
+    """Every strict requirement must still appear on the READY tier."""
+    ready = next(tier for tier in V3_TIERS if tier.stage == READY)
+    assert ready.min_sessions == 260
+    assert ready.params["require_market_cap"] is True
+    assert ready.params["require_promoter_holding"] is True
+    assert ready.params["require_corporate_action_safety"] is True
+    assert ready.data_pending is False
+
+
+def test_lower_tiers_are_flagged_data_pending():
+    for tier in V3_TIERS:
+        if tier.stage != READY:
+            assert tier.data_pending is True
+            assert tier.params["require_market_cap"] is False
+
+
+def test_universe_must_be_loaded_to_the_shallowest_tier_depth():
+    assert MIN_TIER_SESSIONS == 120
+    assert MIN_TIER_SESSIONS == min(t.min_sessions for t in V3_TIERS)
+
+
+def test_regulatory_restriction_rejects_at_every_tier():
+    """Relaxation must not become a loophole around a hard control."""
+    result = evaluate_tiered_eligibility(
+        "T", _history(300), metadata=META, restricted_reason="ASM_STAGE_2",
+        as_of_date="2026-08-20", strict=False)
+    assert result.stage == UNQUALIFIED
+    assert set(result.outstanding) == {"RESTRICTED_SECURITY"}
+
+
+def test_non_eq_series_rejects_at_every_tier():
+    result = evaluate_tiered_eligibility(
+        "T", _history(300), metadata={**META, "series": "BE"},
+        as_of_date="2026-08-20", strict=False)
+    assert result.stage == UNQUALIFIED
+    assert set(result.outstanding) == {"NON_EQ_SERIES"}
+
+
+def test_tier_funnel_reports_stages_and_what_blocks_promotion():
+    results = {
+        "A": evaluate_tiered_eligibility("A", _history(300), metadata=META,
+                                         as_of_date="2026-08-20", strict=False),
+        "B": evaluate_tiered_eligibility("B", _history(150), metadata=META,
+                                         as_of_date="2026-08-20", strict=False),
+    }
+    funnel = tier_funnel(results)
+    assert funnel["stages"][READY] == 1
+    assert funnel["stages"][RADAR] == 1
+    assert funnel["entry_authorised"] == 1
+    assert "INSUFFICIENT_HISTORY" in funnel["ready_blockers"]
+
+
+def test_tiered_result_converts_to_a_stage_verdict():
+    result = evaluate_tiered_eligibility(
+        "T", _history(150), metadata=META, as_of_date="2026-08-20", strict=False)
+    verdict = result.to_stage_verdict(score=44.0, evidence=["EMA20 turning up"])
+    assert isinstance(verdict, StageVerdict)
+    assert verdict.stage == RADAR
+    assert verdict.entry_authorised is False
+    assert "EMA20 turning up" in verdict.describe()
