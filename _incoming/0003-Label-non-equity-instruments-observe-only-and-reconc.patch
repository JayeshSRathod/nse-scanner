@@ -0,0 +1,201 @@
+"""What happens to a paper position when its symbol leaves the universe."""
+from __future__ import annotations
+
+import pandas as pd
+import pytest
+
+from v2.security_lifecycle import LifecycleEvent
+from v2.tradeability import evaluate_universe
+from v2.universe_reconciliation import (
+    CORPORATE_CONVERSION,
+    TERMINAL_EXIT,
+    UNIVERSE_EXIT,
+    classify_position,
+    reconcile_positions,
+    render_reconciliation_notice,
+)
+
+MARKET_DATE = "2026-08-20"
+DAYS = ["2026-08-18", "2026-08-19", "2026-08-20"]
+STALE_DAYS = ["2026-07-14", "2026-07-15", "2026-07-16"]
+
+
+def _frame(symbol: str, days: list[str], close: float) -> pd.DataFrame:
+    return pd.DataFrame({
+        "symbol": symbol, "trade_date": days,
+        "open": close, "high": close * 1.01, "low": close * 0.99,
+        "close": close, "volume": 100_000,
+    })
+
+
+def _master(symbol: str, **extra) -> dict:
+    row = {"symbol": symbol, "series": "EQ", "active": 1}
+    row.update(extra)
+    return row
+
+
+JBCHEPHARM_EVENT = LifecycleEvent(
+    symbol="JBCHEPHARM", event_type="AMALGAMATION", status="EFFECTIVE",
+    effective_date="2026-07-08", record_date="2026-07-17",
+    last_trading_date="2026-07-16", successor_symbol="TORNTPHARM",
+    exchange_ratio_from=100.0, exchange_ratio_to=51.0, terminal=True,
+)
+
+DELISTED_EVENT = LifecycleEvent(
+    symbol="GONECO", event_type="DELISTING", status="EFFECTIVE",
+    effective_date="2026-06-01", last_trading_date="2026-05-29", terminal=True,
+)
+
+
+def _verdict():
+    prices = pd.concat([
+        _frame("BERGEPAINT", DAYS, 528.55),
+        _frame("GSEC10IETF", DAYS, 267.26),
+        _frame("JBCHEPHARM", STALE_DAYS, 2408.9),
+        _frame("GONECO", STALE_DAYS, 45.0),
+        _frame("STALECO", STALE_DAYS, 90.0),
+    ], ignore_index=True)
+    return evaluate_universe(
+        prices, market_date=MARKET_DATE,
+        master={s: _master(s) for s in ("BERGEPAINT", "STALECO", "GONECO")},
+        lifecycle=[JBCHEPHARM_EVENT, DELISTED_EVENT],
+    )
+
+
+# --- per-position classification -------------------------------------------
+
+def test_a_healthy_equity_position_is_held():
+    verdict = _verdict()
+    action = classify_position(
+        "BERGEPAINT", verdict=verdict.results["BERGEPAINT"],
+        market_date=MARKET_DATE, quantity=10, last_price=528.55,
+    )
+    assert action is None, "a tradeable equity must not be disturbed"
+
+
+def test_merged_holding_is_converted_not_exited():
+    verdict = _verdict()
+    action = classify_position(
+        "JBCHEPHARM", verdict=verdict.results["JBCHEPHARM"],
+        market_date=MARKET_DATE, quantity=100, last_price=2408.9,
+    )
+    assert action is not None
+    assert action.action == CORPORATE_CONVERSION
+    assert action.reason_code == "TERMINAL_MERGER"
+    assert action.successor_symbol == "TORNTPHARM"
+    assert action.conversion_ratio == pytest.approx(0.51)
+    assert action.successor_quantity == 51.0
+    assert action.fractional_entitlement == 0.0
+    assert action.closes_position is False
+    assert "Realised P&L: 0 at conversion" in action.describe()
+
+
+def test_fractional_entitlement_is_recorded_not_rounded_away():
+    """100 -> 51 on a 175-share holding gives 89.25 shares."""
+    verdict = _verdict()
+    action = classify_position(
+        "JBCHEPHARM", verdict=verdict.results["JBCHEPHARM"],
+        market_date=MARKET_DATE, quantity=175, last_price=2408.9,
+    )
+    assert action.successor_quantity == 89.0
+    assert action.fractional_entitlement == pytest.approx(0.25)
+    assert "do not round" in action.describe()
+
+
+def test_delisting_without_a_successor_is_a_terminal_exit_for_review():
+    verdict = _verdict()
+    action = classify_position(
+        "GONECO", verdict=verdict.results["GONECO"],
+        market_date=MARKET_DATE, quantity=50, last_price=45.0,
+    )
+    assert action.action == TERMINAL_EXIT
+    assert action.reason_code == "DELISTED_SECURITY"
+    assert action.closes_position is True
+    assert "manual review" in action.detail
+
+
+def test_stale_symbol_holding_is_a_universe_exit_at_the_last_close():
+    verdict = _verdict()
+    action = classify_position(
+        "STALECO", verdict=verdict.results["STALECO"],
+        market_date=MARKET_DATE, quantity=20, last_price=90.0,
+    )
+    assert action.action == UNIVERSE_EXIT
+    assert action.reason_code == "STALE_SYMBOL_PRICE"
+    assert action.exit_price == 90.0
+
+
+def test_observe_only_etf_holding_is_exited():
+    """The decision taken for the legacy Hull Pine ETF positions."""
+    verdict = _verdict()
+    result = verdict.results["GSEC10IETF"]
+    assert result.eligible and result.observe_only    # admitted, not enterable
+    action = classify_position(
+        "GSEC10IETF", verdict=result, market_date=MARKET_DATE,
+        quantity=224, last_price=267.26,
+    )
+    assert action.action == UNIVERSE_EXIT
+    assert action.reason_code == "NON_EQ_UNVERIFIED_HOLDING"
+    assert action.exit_price == 267.26
+
+
+def test_a_symbol_with_no_verdict_at_all_is_exited():
+    action = classify_position(
+        "VANISHED", verdict=None, market_date=MARKET_DATE,
+        quantity=5, last_price=12.0,
+    )
+    assert action.action == UNIVERSE_EXIT
+    assert action.reason_code == "NO_CURRENT_VERDICT"
+
+
+# --- batch ------------------------------------------------------------------
+
+def test_reconcile_positions_handles_a_mixed_json_state_file():
+    verdict = _verdict()
+    positions = [
+        {"symbol": "BERGEPAINT", "quantity": 10, "last_price": 528.55, "state": "OPEN"},
+        {"symbol": "GSEC10IETF", "quantity": 224, "last_price": 267.26, "state": "TRAILING"},
+        {"symbol": "JBCHEPHARM", "quantity": 100, "last_price": 2408.9, "state": "OPEN"},
+        {"symbol": "STALECO", "quantity": 20, "last_price": 90.0, "state": "OPEN"},
+    ]
+    actions = {action.symbol: action for action in reconcile_positions(positions, verdict)}
+    assert "BERGEPAINT" not in actions
+    assert actions["GSEC10IETF"].action == UNIVERSE_EXIT
+    assert actions["JBCHEPHARM"].action == CORPORATE_CONVERSION
+    assert actions["STALECO"].action == UNIVERSE_EXIT
+
+
+def test_reconcile_tolerates_missing_and_malformed_fields():
+    verdict = _verdict()
+    positions = [
+        {"symbol": "GSEC10IETF"},                      # no quantity or price
+        {"symbol": "STALECO", "quantity": "not-a-number", "last_price": None},
+        {"quantity": 5},                               # no symbol at all
+    ]
+    actions = reconcile_positions(positions, verdict)
+    assert {a.symbol for a in actions} == {"GSEC10IETF", "STALECO"}
+
+
+def test_explicit_last_prices_override_the_position_record():
+    verdict = _verdict()
+    actions = reconcile_positions(
+        [{"symbol": "STALECO", "quantity": 1, "last_price": 1.0}],
+        verdict, last_prices={"STALECO": 90.0},
+    )
+    assert actions[0].exit_price == 90.0
+
+
+def test_notice_is_empty_when_nothing_needs_reconciling():
+    assert render_reconciliation_notice([]) == ""
+
+
+def test_notice_names_every_affected_symbol():
+    verdict = _verdict()
+    actions = reconcile_positions([
+        {"symbol": "GSEC10IETF", "quantity": 224, "last_price": 267.26},
+        {"symbol": "JBCHEPHARM", "quantity": 100, "last_price": 2408.9},
+    ], verdict)
+    notice = render_reconciliation_notice(actions)
+    assert "UNIVERSE RECONCILIATION" in notice
+    assert "GSEC10IETF" in notice and "UNIVERSE_EXIT" in notice
+    assert "TORNTPHARM" in notice and "CORPORATE_CONVERSION" in notice
