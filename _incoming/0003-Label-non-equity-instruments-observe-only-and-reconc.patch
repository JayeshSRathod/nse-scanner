diff --git a/v2/universe_reconciliation.py b/v2/universe_reconciliation.py
new file mode 100755
index 0000000..c9a03e4
--- /dev/null
+++ b/v2/universe_reconciliation.py
@@ -0,0 +1,194 @@
+"""Reconcile open paper positions against the current tradeable universe.
+
+The gateway decides what may be *entered*.  This module answers the companion
+question every scanner also has to answer: what happens to a position that is
+already open in a symbol the scanner may no longer trade?
+
+Three outcomes, in priority order:
+
+``CORPORATE_CONVERSION``
+    The symbol was amalgamated or merged and a successor with an exchange ratio
+    is known.  The holding is converted, not exited: realised P&L is zero at the
+    conversion and the position continues in the successor symbol.  Fractional
+    entitlements are recorded rather than silently rounded.
+
+``TERMINAL_EXIT``
+    The symbol is terminal with no successor — a plain delisting or suspension.
+    There is nothing to convert and no market to exit into, so the position is
+    closed at its last known price and flagged for manual review.
+
+``UNIVERSE_EXIT``
+    The symbol still trades but is no longer admissible for entry: it has gone
+    stale, become restricted, or is an unverified non-equity instrument that the
+    scanner may observe but not hold.  The position is closed at the last
+    available close so the paper equity curve stays continuous and honest.
+
+Nothing here writes to the price history.  These are portfolio decisions.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+from typing import Iterable, Mapping
+
+from .tradeability import EQUITY, TradeabilityResult, UniverseVerdict
+
+CORPORATE_CONVERSION = "CORPORATE_CONVERSION"
+TERMINAL_EXIT = "TERMINAL_EXIT"
+UNIVERSE_EXIT = "UNIVERSE_EXIT"
+
+#: Reason codes that mean "the security has ceased to be itself".
+_TERMINAL_CODES = frozenset({"TERMINAL_MERGER", "DELISTED_SECURITY", "SUSPENDED_SECURITY"})
+
+
+@dataclass(frozen=True)
+class ReconciliationAction:
+    """One decision about one open position."""
+
+    symbol: str
+    action: str
+    reason_code: str
+    market_date: str
+    exit_price: float | None = None
+    successor_symbol: str | None = None
+    conversion_ratio: float | None = None
+    #: Successor quantity for a conversion, before fractional treatment.
+    successor_quantity: float | None = None
+    #: The fractional remainder the scheme must settle in cash.
+    fractional_entitlement: float | None = None
+    detail: str | None = None
+
+    @property
+    def closes_position(self) -> bool:
+        return self.action in {TERMINAL_EXIT, UNIVERSE_EXIT}
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+    def describe(self) -> str:
+        lines = [f"{self.symbol} • {self.action}", f"Reason: {self.reason_code}"]
+        if self.action == CORPORATE_CONVERSION:
+            transfer = f"{self.symbol} → {self.successor_symbol}"
+            if self.conversion_ratio:
+                transfer += f" (ratio {self.conversion_ratio:.4f})"
+            lines.append(transfer)
+            if self.successor_quantity is not None:
+                lines.append(f"Successor quantity: {self.successor_quantity:g}")
+            if self.fractional_entitlement:
+                lines.append(
+                    f"Fractional entitlement: {self.fractional_entitlement:g}"
+                    " — settle per the scheme, do not round"
+                )
+            lines.append("Realised P&L: 0 at conversion")
+        elif self.exit_price is not None:
+            lines.append(f"Exit price: {self.exit_price:g}")
+        if self.detail:
+            lines.append(self.detail)
+        return "\n".join(lines)
+
+
+def classify_position(
+    symbol: str,
+    *,
+    verdict: TradeabilityResult | None,
+    market_date: str,
+    quantity: float = 0.0,
+    last_price: float | None = None,
+) -> ReconciliationAction | None:
+    """Decide what must happen to one open position. ``None`` means "hold"."""
+    if verdict is None:
+        # No verdict at all means the symbol vanished from the price frame
+        # entirely; treat it as a universe exit so it cannot linger unpriced.
+        return ReconciliationAction(
+            symbol=symbol, action=UNIVERSE_EXIT, reason_code="NO_CURRENT_VERDICT",
+            market_date=market_date, exit_price=last_price,
+            detail="Symbol produced no gateway verdict on this market date",
+        )
+
+    if verdict.reason_code in _TERMINAL_CODES:
+        ratio = verdict.conversion_ratio
+        if verdict.successor_symbol and ratio:
+            raw = quantity * ratio
+            whole = float(int(raw))
+            return ReconciliationAction(
+                symbol=symbol, action=CORPORATE_CONVERSION,
+                reason_code=verdict.reason_code, market_date=market_date,
+                successor_symbol=verdict.successor_symbol, conversion_ratio=ratio,
+                successor_quantity=whole,
+                fractional_entitlement=round(raw - whole, 8),
+                detail=verdict.detail,
+            )
+        return ReconciliationAction(
+            symbol=symbol, action=TERMINAL_EXIT, reason_code=verdict.reason_code,
+            market_date=market_date, exit_price=last_price,
+            detail=(verdict.detail or "") + " | No successor; requires manual review",
+        )
+
+    if not verdict.eligible:
+        return ReconciliationAction(
+            symbol=symbol, action=UNIVERSE_EXIT, reason_code=verdict.reason_code,
+            market_date=market_date, exit_price=last_price, detail=verdict.detail,
+        )
+
+    if verdict.instrument_class != EQUITY:
+        return ReconciliationAction(
+            symbol=symbol, action=UNIVERSE_EXIT,
+            reason_code="NON_EQ_UNVERIFIED_HOLDING", market_date=market_date,
+            exit_price=last_price,
+            detail=(
+                "Instrument may be observed but not held; the scanner cannot "
+                "verify its series, market cap or delivery data"
+            ),
+        )
+
+    return None
+
+
+def reconcile_positions(
+    positions: Iterable[Mapping[str, object]],
+    verdict: UniverseVerdict,
+    *,
+    last_prices: Mapping[str, float] | None = None,
+    symbol_key: str = "symbol",
+    quantity_key: str = "quantity",
+    price_key: str = "last_price",
+) -> list[ReconciliationAction]:
+    """Classify every open position against a gateway verdict.
+
+    Accepts plain mappings so the same helper serves the JSON state files used by
+    Hull Pine and the Momentum Ladder as well as V3's sqlite portfolio store.
+    """
+    prices = dict(last_prices or {})
+    actions: list[ReconciliationAction] = []
+    for position in positions:
+        symbol = str(position.get(symbol_key, "") or "")
+        if not symbol:
+            continue
+        raw_price = position.get(price_key)
+        try:
+            fallback = float(raw_price) if raw_price is not None else None
+        except (TypeError, ValueError):
+            fallback = None
+        try:
+            quantity = float(position.get(quantity_key) or 0.0)
+        except (TypeError, ValueError):
+            quantity = 0.0
+        action = classify_position(
+            symbol, verdict=verdict.results.get(symbol),
+            market_date=verdict.market_date, quantity=quantity,
+            last_price=prices.get(symbol, fallback),
+        )
+        if action is not None:
+            actions.append(action)
+    return actions
+
+
+def render_reconciliation_notice(actions: Iterable[ReconciliationAction]) -> str:
+    """Operator-facing summary for Telegram and the admin report."""
+    actions = list(actions)
+    if not actions:
+        return ""
+    lines = ["⚠️ UNIVERSE RECONCILIATION"]
+    for action in actions:
+        lines.append("")
+        lines.append(action.describe())
+    return "\n".join(lines)
