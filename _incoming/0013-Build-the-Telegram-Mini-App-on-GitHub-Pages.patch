+def render_miniapp_link(label: str = "Open the scanner app") -> str:
+    """A link to the Mini App, when one is configured.
+
+    Two forms work, and they behave differently:
+
+    ``MINI_APP_TELEGRAM_LINK``
+        A ``https://t.me/<bot>/<short_name>`` link created with BotFather's
+        ``/newapp``. Opens *inside* Telegram, which is what you want from a group.
+
+    ``MINI_APP_URL``
+        The plain GitHub Pages URL. Opens in the phone's browser instead.
+
+    Returns an empty string when neither is set, so the caller can always append
+    it unconditionally.
+    """
+    telegram_link = os.getenv("MINI_APP_TELEGRAM_LINK", "").strip()
+    if telegram_link:
+        return f'📊 <a href="{telegram_link}">{label}</a>'
+    url = os.getenv("MINI_APP_URL", "").strip()
+    if url:
+        return f'📊 <a href="{url}">{label}</a> (opens in your browser)'
+    return ""
+
+
 def assemble(*blocks: str, separator: str = "\n\n") -> str:
     """Join only the non-empty notice blocks."""
     return separator.join(block for block in blocks if block)
