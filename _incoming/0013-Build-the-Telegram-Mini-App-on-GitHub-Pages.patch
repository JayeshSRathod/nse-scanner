diff --git a/scripts/build_miniapp_feed.py b/scripts/build_miniapp_feed.py
new file mode 100644
index 0000000..d5201e6
--- /dev/null
+++ b/scripts/build_miniapp_feed.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Write the Mini App's static feed from whichever scanner runs are present.
+
+Run this at the end of the daily pipeline, after the scanners have written their
+own run files. The feed is committed to the repository and served by GitHub
+Pages, so the Mini App needs hosting but no server.
+
+    python scripts/build_miniapp_feed.py
+    python scripts/build_miniapp_feed.py --out docs/data/feed.json
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from v2.miniapp_feed import build_feed, write_feed  # noqa: E402
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--root", default=".")
+    parser.add_argument("--out", default="docs/data/feed.json")
+    parser.add_argument("--history", default="docs/data/feed_previous.json",
+                        help="keep one prior feed so the app can show what changed")
+    args = parser.parse_args(argv)
+
+    out = Path(args.out)
+    if out.exists() and args.history:
+        history = Path(args.history)
+        history.parent.mkdir(parents=True, exist_ok=True)
+        history.write_text(out.read_text(encoding="utf-8"), encoding="utf-8")
+
+    feed = build_feed(root=args.root)
+    write_feed(feed, out)
+
+    totals = feed["totals"]
+    print(f"market date : {feed['market_date']}")
+    print(f"items       : {totals['items']} (held {totals['held']})")
+    for block in feed["scanners"]:
+        print(f"  {block['key']:8s} {block['status']:9s} {len(block['items']):>4} items"
+              f"  date={block.get('market_date') or '-'}")
+    print(f"by stage    : {json.dumps(totals['by_stage'])}")
+    print(f"written     : {out} ({out.stat().st_size / 1024:.1f} KB)")
+    if totals["items"] == 0:
+        print("\nWARNING: the feed is empty. Check that the scanners wrote their run files.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_miniapp_feed.py b/tests/test_miniapp_feed.py
new file mode 100755
index 0000000..1cc5e71
--- /dev/null
+++ b/tests/test_miniapp_feed.py
@@ -0,0 +1,251 @@
+"""The Mini App feed contract.
+
+The app is a static page with no server, so the feed *is* the API. These tests
+pin the shape the page depends on, and the two properties that keep it honest:
+absent data is omitted rather than defaulted to zero, and a symbol that cannot be
+bought stays visible with that fact attached.
+"""
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+
+import pytest
+
+from v2.miniapp_feed import (
+    FEED_VERSION,
+    SCANNER_SOURCES,
+    FeedItem,
+    build_feed,
+    from_hull,
+    from_ladder,
+    from_penny,
+    from_v3,
+    write_feed,
+)
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+# --- item shape -------------------------------------------------------------
+
+def test_absent_values_are_omitted_not_zeroed():
+    """A card showing 0.00 where there is no data would be a lie."""
+    payload = FeedItem(symbol="AAA", scanner="v3", stage="RADAR").to_dict()
+    assert payload == {"symbol": "AAA", "scanner": "v3", "stage": "RADAR"}
+    for absent in ("cmp", "entry_low", "stop", "score", "risk_pct", "notes", "held"):
+        assert absent not in payload
+
+
+def test_real_values_survive():
+    payload = FeedItem(symbol="AAA", scanner="hull", stage="READY", score=82.0,
+                       cmp=100.5, stop=95.0, held=True, notes=["x"]).to_dict()
+    assert payload["score"] == 82.0
+    assert payload["held"] is True
+    assert payload["notes"] == ["x"]
+
+
+def test_non_numeric_and_infinite_inputs_are_dropped():
+    from v2.miniapp_feed import _num
+    for bad in ("", "abc", None, True, False, float("inf"), float("nan")):
+        assert _num(bad) is None
+    assert _num("12.5") == 12.5
+    assert _num(3) == 3.0
+
+
+# --- adapters ---------------------------------------------------------------
+
+def test_hull_adapter_reads_setups_watch_and_holdings():
+    items = from_hull({
+        "pending": [{"symbol": "BERGEPAINT", "score": 85.0, "signal_close": 528.55,
+                     "entry_low": 539.55, "entry_high": 547.60, "initial_stop": 509.56,
+                     "sessions_waited": 2}],
+        "watch": [{"symbol": "ABB", "stage": "RADAR", "score": 70.0, "close": 7605.0,
+                   "setup_stage": "BUILD"}],
+        "open_positions": [{"symbol": "FOSECOIND", "entry": 5000.0, "last_price": 5500.0,
+                            "stop": 4800.0, "entry_date": "2026-08-20"}],
+    })
+    by_symbol = {i.symbol: i for i in items}
+    assert by_symbol["BERGEPAINT"].stage == "QUALIFIED"
+    assert by_symbol["BERGEPAINT"].entry_high == 547.60
+    assert "Waiting 2 session(s)" in by_symbol["BERGEPAINT"].notes
+    assert by_symbol["ABB"].stage == "RADAR"
+    held = by_symbol["FOSECOIND"]
+    assert held.held is True
+    assert held.unrealised_pct == 10.0
+
+
+def test_ladder_adapter_reads_shortlist_and_paper_watchlist():
+    items = from_ladder({
+        "shortlist": [{"symbol": "BHAGYANGR", "discovery_score": 99.9,
+                       "stage": "CONFIRMING", "hull_state": "WATCH",
+                       "instrument_class": "EQUITY"}],
+        "multi_horizon_shadow": {"paper_lifecycle": {"watchlist": {
+            "AUBANK": {"entry_trigger": 1090.4, "stop": 1039.69,
+                       "target_1": 1166.48, "target_2": 1217.19, "risk_pct": 4.65}}}},
+    })
+    by_symbol = {i.symbol: i for i in items}
+    assert by_symbol["BHAGYANGR"].stage == "CONFIRMING"
+    assert "Hull WATCH" in by_symbol["BHAGYANGR"].notes
+    assert by_symbol["AUBANK"].stage == "QUALIFIED"
+    assert by_symbol["AUBANK"].entry_low == 1090.4
+    assert by_symbol["AUBANK"].risk_pct == 4.65
+
+
+def test_v3_adapter_includes_radar_and_confirming_symbols_without_plans():
+    items = from_v3({"radar_symbols": ["AMAGI", "FRACTAL"],
+                     "confirming_symbols": ["ADFFOODS"], "diagnostics": {}})
+    stages = {i.symbol: i.stage for i in items}
+    assert stages == {"AMAGI": "RADAR", "FRACTAL": "RADAR", "ADFFOODS": "CONFIRMING"}
+    assert all(i.entry_low is None for i in items), "no plan yet, so no buy price"
+
+
+def test_penny_adapter_marks_unverified_instruments():
+    items = from_penny({"candidates": [
+        {"symbol": "ABC", "stage": "RADAR", "score": 44.0, "cmp": 8.42,
+         "market_cap_verified": False, "notes": ["thin volume"]},
+        {"symbol": "XYZ", "stage": "READY", "score": 74.0, "cmp": 33.1},
+    ]})
+    by_symbol = {i.symbol: i for i in items}
+    assert by_symbol["ABC"].instrument_class == "NON_EQ_UNVERIFIED"
+    assert by_symbol["ABC"].notes == ["thin volume"]
+    assert by_symbol["XYZ"].instrument_class is None
+
+
+def test_availability_is_preserved_separately_from_stage():
+    """A circuit-locked symbol must stay visible and clearly unbuyable."""
+    items = from_penny({"candidates": [
+        {"symbol": "NHCFOODS", "stage": "READY", "availability": "CIRCUIT_LOCKED",
+         "score": 82.0, "cmp": 1.63},
+    ]})
+    assert items[0].stage == "READY"
+    assert items[0].availability == "CIRCUIT_LOCKED"
+
+
+def test_a_row_without_a_symbol_is_skipped():
+    assert from_penny({"candidates": [{"score": 50.0}, {"symbol": "", "score": 1}]}) == []
+
+
+# --- assembly ---------------------------------------------------------------
+
+def test_missing_scanner_files_are_reported_not_fatal(tmp_path):
+    feed = build_feed(root=tmp_path)
+    assert feed["feed_version"] == FEED_VERSION
+    assert feed["totals"]["items"] == 0
+    assert {b["status"] for b in feed["scanners"]} == {"MISSING"}
+    assert len(feed["scanners"]) == len(SCANNER_SOURCES)
+
+
+def test_a_corrupt_scanner_file_does_not_empty_the_feed(tmp_path):
+    (tmp_path / "output").mkdir()
+    (tmp_path / "output" / "pine_hull_daily_run.json").write_text("{not json",
+                                                                  encoding="utf-8")
+    (tmp_path / "output" / "old_nse_hull_daily.json").write_text(json.dumps({
+        "market_date": "2026-08-20",
+        "shortlist": [{"symbol": "AAA", "discovery_score": 90.0, "stage": "CONFIRMING"}],
+    }), encoding="utf-8")
+    feed = build_feed(root=tmp_path)
+    assert feed["totals"]["items"] == 1
+    statuses = {b["key"]: b["status"] for b in feed["scanners"]}
+    assert statuses["hull"] == "MISSING"          # unreadable, treated as absent
+    assert statuses["ladder"] == "OK"
+
+
+def test_market_date_is_the_newest_any_scanner_reported(tmp_path):
+    out = tmp_path / "output"
+    out.mkdir()
+    (out / "old_nse_hull_daily.json").write_text(json.dumps({
+        "market_date": "2026-08-18", "shortlist": [{"symbol": "OLD"}]}), encoding="utf-8")
+    (out / "pine_hull_daily_run.json").write_text(json.dumps({
+        "market_date": "2026-08-20", "watch": [{"symbol": "NEW"}]}), encoding="utf-8")
+    feed = build_feed(root=tmp_path)
+    assert feed["market_date"] == "2026-08-20"
+    # ...and the lag is visible per scanner, so the app can warn.
+    assert feed["scanner_dates"]["ladder"] == "2026-08-18"
+
+
+def test_totals_count_stages_and_holdings(tmp_path):
+    out = tmp_path / "output"
+    out.mkdir()
+    (out / "pine_hull_daily_run.json").write_text(json.dumps({
+        "market_date": "2026-08-20",
+        "open_positions": [{"symbol": "HELD", "entry": 100.0, "last_price": 110.0}],
+        "watch": [{"symbol": "W1", "stage": "RADAR"}, {"symbol": "W2", "stage": "RADAR"}],
+    }), encoding="utf-8")
+    totals = build_feed(root=tmp_path)["totals"]
+    assert totals["items"] == 3
+    assert totals["held"] == 1
+    assert totals["by_stage"]["RADAR"] == 2
+    assert totals["by_scanner"]["hull"] == 3
+
+
+def test_feed_round_trips_to_disk(tmp_path):
+    path = write_feed(build_feed(root=tmp_path), tmp_path / "d" / "feed.json")
+    assert path.exists()
+    assert json.loads(path.read_text(encoding="utf-8"))["feed_version"] == FEED_VERSION
+
+
+# --- the page and the feed must agree --------------------------------------
+
+def test_the_page_only_reads_fields_the_feed_can_provide():
+    """Guards against the app drifting from the builder."""
