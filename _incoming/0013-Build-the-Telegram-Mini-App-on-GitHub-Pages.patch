+
+
+def test_the_page_reads_the_top_level_keys_the_builder_writes(tmp_path):
+    feed = build_feed(root=tmp_path)
+    for key in ("market_date", "scanner_dates", "scanners", "items", "totals"):
+        assert key in feed
+    for key in ("key", "name", "status", "items"):
