+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>NSE Scanner</title>
+<script src="https://telegram.org/js/telegram-web-app.js"></script>
+<style>
+  :root{
+    --bg:#ffffff; --fg:#111418; --muted:#6b7280; --line:#e5e7eb; --card:#f9fafb;
+    --accent:#2563eb; --ok:#15803d; --warn:#b45309; --bad:#b91c1c; --chip:#f3f4f6;
+  }
+  body.tg-dark{
+    --bg:#17212b; --fg:#f1f5f9; --muted:#9aa8b6; --line:#2b3947; --card:#1d2b38;
+    --accent:#5b9cf6; --ok:#4ade80; --warn:#fbbf24; --bad:#f87171; --chip:#243342;
+  }
+  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
+  body{margin:0;background:var(--bg);color:var(--fg);
+    font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
+    padding:0 0 88px}
+  header{position:sticky;top:0;z-index:20;background:var(--bg);
+    border-bottom:1px solid var(--line);padding:12px 14px 10px}
+  h1{margin:0;font-size:17px;font-weight:650;letter-spacing:-.01em}
+  .sub{color:var(--muted);font-size:12.5px;margin-top:2px}
+  .row{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;margin-top:10px}
+  .row::-webkit-scrollbar{display:none}
+  .chip{flex:0 0 auto;padding:6px 11px;border-radius:999px;background:var(--chip);
+    color:var(--fg);font-size:12.5px;border:1px solid transparent;cursor:pointer;
+    white-space:nowrap;user-select:none}
+  .chip[aria-pressed="true"]{background:var(--accent);color:#fff;border-color:var(--accent)}
+  main{padding:12px 14px}
+  .card{background:var(--card);border:1px solid var(--line);border-radius:12px;
+    padding:11px 12px;margin-bottom:9px;cursor:pointer}
+  .card:active{opacity:.65}
+  .top{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
+  .sym{font-weight:650;font-size:15.5px;letter-spacing:-.01em}
+  .score{font-variant-numeric:tabular-nums;color:var(--muted);font-size:12.5px}
+  .tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
+  .tag{font-size:11px;padding:2.5px 7px;border-radius:6px;background:var(--chip);
+    color:var(--muted);font-weight:500}
+  .tag.stage{color:var(--accent)}
+  .tag.hold{color:var(--ok)}
+  .tag.block{color:var(--bad)}
+  .tag.watch{color:var(--warn)}
+  .nums{margin-top:7px;font-size:13px;color:var(--muted);
+    font-variant-numeric:tabular-nums;display:flex;flex-wrap:wrap;gap:4px 14px}
+  .nums b{color:var(--fg);font-weight:600}
+  .next{margin-top:6px;font-size:12.5px;color:var(--muted)}
+  .empty{text-align:center;color:var(--muted);padding:44px 20px;font-size:14px}
+  .banner{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--warn);
+    border-radius:8px;padding:9px 11px;margin-bottom:11px;font-size:12.5px;color:var(--muted)}
+  details{background:var(--card);border:1px solid var(--line);border-radius:10px;
+    padding:9px 11px;margin-top:14px;font-size:12.5px;color:var(--muted)}
+  summary{cursor:pointer;font-weight:600;color:var(--fg);font-size:13px}
+  details table{width:100%;border-collapse:collapse;margin-top:8px}
+  details td{padding:3px 0;border-bottom:1px solid var(--line)}
+  details td:last-child{text-align:right;font-variant-numeric:tabular-nums;color:var(--fg)}
+  .sheet{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.45);
+    display:none;align-items:flex-end}
+  .sheet.on{display:flex}
+  .panel{background:var(--bg);width:100%;border-radius:16px 16px 0 0;
+    padding:16px 16px calc(20px + env(safe-area-inset-bottom));max-height:86vh;overflow:auto}
+  .panel h2{margin:0 0 2px;font-size:19px;letter-spacing:-.02em}
+  .plan{margin-top:12px;border-top:1px solid var(--line)}
+  .plan div{display:flex;justify-content:space-between;padding:8px 0;
+    border-bottom:1px solid var(--line);font-size:13.5px}
+  .plan span:first-child{color:var(--muted)}
+  .plan span:last-child{font-variant-numeric:tabular-nums;font-weight:600}
+  .btn{display:block;text-align:center;margin-top:14px;padding:12px;border-radius:10px;
+    background:var(--accent);color:#fff;text-decoration:none;font-weight:600;font-size:14px}
+  .note{margin-top:10px;font-size:12.5px;color:var(--muted)}
+  .disclaimer{margin:18px 0 0;font-size:11.5px;color:var(--muted);text-align:center}
+</style>
+</head>
+<body>
+
+<header>
+  <h1>NSE Scanner</h1>
+  <div class="sub" id="sub">Loading…</div>
+  <div class="row" id="scanners"></div>
+  <div class="row" id="stages"></div>
+</header>
+
+<main>
+  <div id="banner"></div>
+  <div id="list"></div>
+  <details id="diag" hidden>
+    <summary>Why stocks were skipped</summary>
+    <div id="diagBody"></div>
+  </details>
+  <p class="disclaimer">Paper research only. Not trading advice.<br>
+     End-of-day data. Prices are not live.</p>
+</main>
+
+<div class="sheet" id="sheet"><div class="panel" id="panel"></div></div>
+
+<script>
+(function(){
+  "use strict";
+  var tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
+  if (tg) {
+    try {
+      tg.ready(); tg.expand();
+      if (tg.colorScheme === "dark") document.body.classList.add("tg-dark");
+      tg.onEvent("themeChanged", function(){
+        document.body.classList.toggle("tg-dark", tg.colorScheme === "dark");
+      });
+    } catch(e){}
+  } else if (window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches) {
+    document.body.classList.add("tg-dark");
+  }
+
+  // Stage order is the progression; availability states sit outside it.
+  var STAGE_ORDER = ["READY","QUALIFIED","CONFIRMING","RADAR","UNQUALIFIED"];
+  var BLOCKING = ["CIRCUIT_LOCKED","TERMINATED","CORPORATE_REVIEW","OBSERVE_ONLY","EXTENDED"];
+  var LABEL = {
+    READY:"Ready", QUALIFIED:"Almost ready", CONFIRMING:"Confirming",
+    RADAR:"Early", UNQUALIFIED:"Not yet",
+    CIRCUIT_LOCKED:"Can't buy", TERMINATED:"Gone", CORPORATE_REVIEW:"On hold",
+    OBSERVE_ONLY:"Fund, watch only", EXTENDED:"Ran too far"
+  };
+  // Internal codes are never shown raw.
+  var PLAIN = {
+    STALE_SYMBOL_PRICE:"Hasn't traded recently",
+    TERMINAL_MERGER:"Merged into another company",
+    DELISTED_SECURITY:"Delisted",
+    SUSPENDED_SECURITY:"Suspended",
+    NON_EQ_SERIES:"Not a normal equity series",
+    RESTRICTED_SECURITY:"Under exchange restriction",
+    NOT_IN_CURRENT_NSE_UNIVERSE:"Not a listed company (fund or ETF)",
+    INVALID_LATEST_ROW:"Last day's prices look wrong",
+    CORPORATE_ACTION_REVIEW:"Company event pending",
+    INACTIVE_SECURITY:"No longer active"
+  };
+
+  var feed = null, scanner = "all", stage = "all";
+  var $ = function(id){ return document.getElementById(id); };
+
+  function money(v){
+    if (v === null || v === undefined) return "—";
+    return "₹" + Number(v).toLocaleString("en-IN",
+      {minimumFractionDigits:2, maximumFractionDigits:2});
+  }
+  function esc(s){
+    return String(s === null || s === undefined ? "" : s)
+      .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
+      .replace(/"/g,"&quot;");
+  }
+  function state(it){ return it.availability || it.stage; }
+  function cls(s){
+    if (BLOCKING.indexOf(s) >= 0) return "block";
+    if (s === "READY" || s === "QUALIFIED") return "hold";
+    if (s === "CONFIRMING") return "watch";
+    return "stage";
+  }
+
+  function visible(){
+    return (feed.items || []).filter(function(it){
+      if (scanner !== "all" && it.scanner !== scanner) return false;
+      if (stage === "all") return true;
+      if (stage === "held") return !!it.held;
+      if (stage === "blocked") return BLOCKING.indexOf(state(it)) >= 0;
+      return state(it) === stage;
+    }).sort(function(a,b){
+      var ra = STAGE_ORDER.indexOf(a.stage), rb = STAGE_ORDER.indexOf(b.stage);
+      if (ra !== rb) return (ra < 0 ? 99 : ra) - (rb < 0 ? 99 : rb);
+      return (b.score || 0) - (a.score || 0);
+    });
+  }
+
+  function chips(host, options, current, onPick){
+    host.innerHTML = "";
+    options.forEach(function(o){
+      var b = document.createElement("button");
+      b.className = "chip";
+      b.setAttribute("aria-pressed", String(o.key === current));
+      b.textContent = o.label + (o.count !== undefined ? "  " + o.count : "");
+      b.onclick = function(){
+        if (tg && tg.HapticFeedback) { try { tg.HapticFeedback.selectionChanged(); } catch(e){} }
+        onPick(o.key);
+      };
+      host.appendChild(b);
+    });
+  }
+
+  function card(it){
+    var s = state(it);
+    var el = document.createElement("div");
+    el.className = "card";
+    var nums = [];
+    if (it.cmp !== undefined) nums.push("Price <b>" + money(it.cmp) + "</b>");
+    if (it.entry_low !== undefined) {
+      nums.push("Buy <b>" + money(it.entry_low) +
+        (it.entry_high !== undefined ? "–" + money(it.entry_high) : "") + "</b>");
+    }
+    if (it.stop !== undefined) nums.push("Stop <b>" + money(it.stop) + "</b>");
+    if (it.unrealised_pct !== undefined) {
+      nums.push("P&amp;L <b>" + (it.unrealised_pct > 0 ? "+" : "") +
+        it.unrealised_pct.toFixed(1) + "%</b>");
+    }
+    el.innerHTML =
+      '<div class="top"><span class="sym">' + esc(it.symbol) + '</span>' +
+      (it.score !== undefined ? '<span class="score">' + Math.round(it.score) + '</span>' : '') +
+      '</div>' +
+      '<div class="tags">' +
+        '<span class="tag ' + cls(s) + '">' + esc(LABEL[s] || s) + '</span>' +
+        '<span class="tag">' + esc((feed.scanners.filter(function(b){
+            return b.key === it.scanner; })[0] || {}).name || it.scanner) + '</span>' +
+        (it.held ? '<span class="tag hold">Holding</span>' : '') +
+      '</div>' +
+      (nums.length ? '<div class="nums">' + nums.join("") + '</div>' : '') +
+      (it.next_action ? '<div class="next">' + esc(it.next_action) + '</div>' : '');
+    el.onclick = function(){ openSheet(it); };
+    return el;
+  }
+
+  function openSheet(it){
+    var s = state(it);
+    var rows = [
+      ["Status", LABEL[s] || s],
+      ["Scanner", (feed.scanners.filter(function(b){ return b.key === it.scanner; })[0] || {}).name || it.scanner]
+    ];
+    if (it.score !== undefined) rows.push(["Score", Math.round(it.score) + " / 100"]);
+    if (it.cmp !== undefined) rows.push(["Last price", money(it.cmp)]);
+    if (it.entry_low !== undefined) {
+      rows.push(["Buy zone", money(it.entry_low) +
+        (it.entry_high !== undefined ? " – " + money(it.entry_high) : "")]);
+    }
+    if (it.stop !== undefined) rows.push(["Stop loss", money(it.stop)]);
+    if (it.target1 !== undefined) rows.push(["Target 1", money(it.target1)]);
+    if (it.target2 !== undefined) rows.push(["Target 2", money(it.target2)]);
+    if (it.risk_pct !== undefined) rows.push(["Risk if stopped", it.risk_pct.toFixed(2) + "%"]);
+    if (it.entry_date) rows.push(["Bought on", it.entry_date]);
+    if (it.unrealised_pct !== undefined) {
+      rows.push(["Open P&L", (it.unrealised_pct > 0 ? "+" : "") + it.unrealised_pct.toFixed(2) + "%"]);
+    }
+    if (it.instrument_class === "NON_EQ_UNVERIFIED") {
+      rows.push(["Note", "Fund or ETF — watch only"]);
+    }
+
+    $("panel").innerHTML =
+      '<h2>' + esc(it.symbol) + '</h2>' +
+      '<div class="sub">' + esc(LABEL[s] || s) +
+        (it.next_action ? " · " + esc(it.next_action) : "") + '</div>' +
+      '<div class="plan">' + rows.map(function(r){
+        return '<div><span>' + esc(r[0]) + '</span><span>' + esc(r[1]) + '</span></div>';
+      }).join("") + '</div>' +
+      (it.notes && it.notes.length
+        ? '<div class="note">' + it.notes.map(esc).join("<br>") + '</div>' : '') +
+      '<a class="btn" target="_blank" rel="noopener" href="https://www.tradingview.com/chart/?symbol=NSE%3A' +
+        encodeURIComponent(it.symbol) + '">Open chart</a>' +
+      '<div class="note">Paper research only. Check the chart before acting.</div>';
+    $("sheet").classList.add("on");
+    if (tg && tg.HapticFeedback) { try { tg.HapticFeedback.impactOccurred("light"); } catch(e){} }
+  }
+
+  $("sheet").onclick = function(e){
+    if (e.target === $("sheet")) $("sheet").classList.remove("on");
+  };
+
+  function diagnostics(){
+    var merged = {}, terminal = {};
+    feed.scanners.forEach(function(b){
+      var g = b.gateway || {};
+      Object.keys(g.rejections || {}).forEach(function(k){
+        merged[k] = (merged[k] || 0) + g.rejections[k];
+      });
+      Object.keys(g.terminal || {}).forEach(function(k){ terminal[k] = g.terminal[k]; });
+    });
+    var keys = Object.keys(merged).sort(function(a,b){ return merged[b] - merged[a]; });
+    if (!keys.length && !Object.keys(terminal).length) { $("diag").hidden = true; return; }
+    $("diag").hidden = false;
+    var html = '<table>' + keys.map(function(k){
+      return '<tr><td>' + esc(PLAIN[k] || k) + '</td><td>' + merged[k] + '</td></tr>';
+    }).join("") + '</table>';
+    Object.keys(terminal).forEach(function(sym){
+      var t = terminal[sym] || {};
+      html += '<div class="note"><b>' + esc(sym) + '</b> — ' +
+        esc(PLAIN[t.reason_code] || t.reason_code || "removed") +
+        (t.successor_symbol ? ", now " + esc(t.successor_symbol) : "") +
+        (t.symbol_last_date ? ". Last traded " + esc(t.symbol_last_date) + "." : "") +
+        " Past prices are kept.</div>";
+    });
+    $("diagBody").innerHTML = html;
+  }
+
+  function render(){
+    var t = feed.totals || {};
+    var counts = {};
+    (feed.items || []).forEach(function(it){
+      var s = state(it); counts[s] = (counts[s] || 0) + 1;
+    });
+
+    chips($("scanners"), [{key:"all", label:"All"}].concat(
+      feed.scanners.filter(function(b){ return b.items.length; }).map(function(b){
+        return {key:b.key, label:b.name, count:b.items.length};
+      })), scanner, function(k){ scanner = k; render(); });
+
+    var stageOpts = [{key:"all", label:"Everything"}];
+    if (t.held) stageOpts.push({key:"held", label:"Holding", count:t.held});
+    STAGE_ORDER.forEach(function(s){
+      if (counts[s]) stageOpts.push({key:s, label:LABEL[s] || s, count:counts[s]});
+    });
+    var blocked = BLOCKING.reduce(function(n,s){ return n + (counts[s] || 0); }, 0);
+    if (blocked) stageOpts.push({key:"blocked", label:"Can't buy", count:blocked});
+    chips($("stages"), stageOpts, stage, function(k){ stage = k; render(); });
+
+    var lagging = [];
+    var dates = feed.scanner_dates || {};
+    Object.keys(dates).forEach(function(k){
+      if (dates[k] && feed.market_date && dates[k] < feed.market_date) {
+        lagging.push(((feed.scanners.filter(function(b){ return b.key === k; })[0]) || {}).name || k);
+      }
+    });
+    $("banner").innerHTML = lagging.length
+      ? '<div class="banner">' + esc(lagging.join(", ")) +
+        ' last ran on an older session, so those rows may be out of date.</div>'
+      : "";
+
+    var rows = visible();
+    $("sub").textContent = (feed.market_date || "no date") + " close · " +
+      rows.length + " of " + (t.items || 0) + " shown";
+
+    var list = $("list");
+    list.innerHTML = "";
+    if (!rows.length) {
+      list.innerHTML = '<div class="empty">Nothing here today.<br>' +
+        'That is a normal outcome, not an error.</div>';
+    } else {
+      var frag = document.createDocumentFragment();
+      rows.forEach(function(it){ frag.appendChild(card(it)); });
+      list.appendChild(frag);
+    }
+    diagnostics();
+  }
+
+  fetch("data/feed.json?t=" + Date.now(), {cache:"no-store"})
+    .then(function(r){
+      if (!r.ok) throw new Error("HTTP " + r.status);
+      return r.json();
+    })
+    .then(function(d){ feed = d; render(); })
+    .catch(function(err){
+      $("sub").textContent = "Could not load today's data";
+      $("list").innerHTML = '<div class="empty">Could not load the scan.<br>' +
+        esc(err.message) + '<br><br>The daily run may not have finished yet.</div>';
+    });
+})();
+</script>
+</body>
+</html>
