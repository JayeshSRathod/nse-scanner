@@ -0,0 +1,316 @@
+"""Collect every scanner's daily run into one uniform Mini App feed.
+
+Each scanner writes its own run file in its own shape:
+
+    output/v2_daily_run.json          V3
+    output/old_nse_hull_daily.json    Momentum Ladder
+    output/pine_hull_daily_run.json   Hull Pine
+    output/penny_shadow_daily.json    Penny & Microcap (when wired)
+
+This module normalises them into a single flat item list so the Mini App has one
+shape to render and one place to look, regardless of how many scanners exist or
+how their internals change. Adding a fifth scanner means adding one adapter here,
+not touching the app.
+
+The feed is a *static file*. It is written by the daily GitHub Actions run and
+committed, so the Mini App needs hosting but no server.
+
+Design rules
+------------
+* Missing data is omitted, never defaulted to zero. A card that shows nothing is
+  honest; a card showing 0.0% is a lie.
+* Every item carries the scanner it came from, so a Hull Pine setup can never be
+  mistaken for a V3 one.
+* Availability (circuit, terminal, observe-only) is preserved distinctly from
+  stage, so an unbuyable symbol stays visible and clearly unbuyable.
+"""
+from __future__ import annotations
+
+import json
+from dataclasses import asdict, dataclass, field
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterable, Mapping, Sequence
+
+FEED_VERSION = 2
+
+#: Where each scanner writes its daily run, and its display name.
+SCANNER_SOURCES: tuple[tuple[str, str, str], ...] = (
+    ("v3", "NSE Scanner V3", "output/v2_daily_run.json"),
+    ("ladder", "Momentum Ladder", "output/old_nse_hull_daily.json"),
+    ("hull", "Hull Pine", "output/pine_hull_daily_run.json"),
+    ("penny", "Penny & Microcap", "output/penny_shadow_daily.json"),
+)
+
+
+def _num(value: Any) -> float | None:
+    """A number, or None. Never a silent zero."""
+    if value is None or isinstance(value, bool):
+        return None
+    try:
+        parsed = float(value)
+    except (TypeError, ValueError):
+        return None
+    return parsed if parsed == parsed and abs(parsed) != float("inf") else None
+
+
+def _text(value: Any) -> str | None:
+    if value is None:
+        return None
+    cleaned = str(value).strip()
+    return cleaned or None
+
+
+@dataclass
+class FeedItem:
+    """One row in the Mini App, uniform across every scanner."""
+
+    symbol: str
+    scanner: str
+    stage: str
+    availability: str | None = None
+    score: float | None = None
+    cmp: float | None = None
+    entry_low: float | None = None
+    entry_high: float | None = None
+    stop: float | None = None
+    target1: float | None = None
+    target2: float | None = None
+    risk_pct: float | None = None
+    instrument_class: str | None = None
+    next_action: str | None = None
+    notes: list[str] = field(default_factory=list)
+    #: Set when the item is an open paper position rather than a candidate.
+    held: bool = False
+    entry_date: str | None = None
+    unrealised_pct: float | None = None
+
+    def to_dict(self) -> dict:
+        # Omit empty values so the payload stays small and the app can rely on
+        # "key present means real data".
+        return {k: v for k, v in asdict(self).items()
+                if v is not None and v != [] and v is not False}
+
+
+def _reward_risk(entry: float | None, stop: float | None, target: float | None) -> float | None:
+    if entry is None or stop is None or target is None:
+        return None
+    risk = entry - stop
+    return round((target - entry) / risk, 2) if risk > 0 else None
+
+
+# --- per-scanner adapters ---------------------------------------------------
+
+def from_v3(payload: Mapping[str, Any]) -> list[FeedItem]:
+    """V3 writes a DailyRunResult dict."""
+    items: list[FeedItem] = []
+    diag = payload.get("diagnostics") or {}
+    for row in diag.get("candidates") or []:
+        symbol = _text(row.get("symbol"))
+        if not symbol:
+            continue
+        entry = _num(row.get("entry"))
+        items.append(FeedItem(
+            symbol=symbol, scanner="v3",
+            stage=_text(row.get("progression_stage")) or _text(row.get("classification")) or "RADAR",
+            score=_num(row.get("score")), cmp=_num(row.get("close")) or entry,
+            entry_low=entry, stop=_num(row.get("stop")),
+            target1=_num(row.get("target1")), target2=_num(row.get("target2")),
+            risk_pct=_num(row.get("risk_percent")),
+            next_action=_text(row.get("trade_plan_state")),
+        ))
+    # Symbols visible at the wider stages carry no plan yet, by design.
+    for stage, key in (("RADAR", "radar_symbols"), ("CONFIRMING", "confirming_symbols")):
+        for symbol in payload.get(key) or []:
+            items.append(FeedItem(symbol=str(symbol), scanner="v3", stage=stage,
+                                  next_action="Awaiting confirmation"))
+    return items
+
+
+def from_ladder(payload: Mapping[str, Any]) -> list[FeedItem]:
+    """The Ladder writes its radar report, with an optional shadow block."""
+    items: list[FeedItem] = []
+    for row in payload.get("shortlist") or []:
+        symbol = _text(row.get("symbol"))
+        if not symbol:
+            continue
+        items.append(FeedItem(
+            symbol=symbol, scanner="ladder",
+            stage=_text(row.get("stage")) or "CONFIRMING",
+            availability=_text(row.get("availability")),
+            score=_num(row.get("discovery_score")),
+            instrument_class=_text(row.get("instrument_class")),
+            next_action=_text(row.get("next_action")),
+            notes=[f"Hull {row.get('hull_state')}"] if row.get("hull_state") else [],
+        ))
+    shadow = payload.get("multi_horizon_shadow") or {}
+    watching = ((shadow.get("paper_lifecycle") or {}).get("watchlist")) or {}
+    if not isinstance(watching, dict):
+        watching = {}
+    for symbol, pending in watching.items():
+        if not isinstance(pending, Mapping):
+            continue
+        entry = _num(pending.get("entry_trigger"))
+        items.append(FeedItem(
+            symbol=str(symbol), scanner="ladder", stage="QUALIFIED",
+            entry_low=entry, stop=_num(pending.get("stop")),
+            target1=_num(pending.get("target_1")), target2=_num(pending.get("target_2")),
+            risk_pct=_num(pending.get("risk_pct")),
+            next_action="Await next-session trigger",
+        ))
+    return items
+
+
+def from_hull(payload: Mapping[str, Any]) -> list[FeedItem]:
+    """Hull Pine writes pending setups, watch rows and open positions."""
+    items: list[FeedItem] = []
+    for setup in payload.get("pending") or []:
+        symbol = _text(setup.get("symbol"))
+        if not symbol:
+            continue
+        items.append(FeedItem(
+            symbol=symbol, scanner="hull", stage="QUALIFIED",
+            score=_num(setup.get("score")), cmp=_num(setup.get("signal_close")),
+            entry_low=_num(setup.get("entry_low")), entry_high=_num(setup.get("entry_high")),
+            stop=_num(setup.get("initial_stop")),
+            target1=_num(setup.get("target1")), target2=_num(setup.get("target2")),
+            next_action="Await next-session trigger",
+            notes=[f"Waiting {setup.get('sessions_waited', 0)} session(s)"]
+            if setup.get("sessions_waited") else [],
+        ))
+    for row in payload.get("watch") or []:
+        symbol = _text(row.get("symbol"))
+        if not symbol:
+            continue
+        items.append(FeedItem(
+            symbol=symbol, scanner="hull",
+            stage=_text(row.get("stage")) or "RADAR",
+            availability=_text(row.get("availability")),
+            score=_num(row.get("score")), cmp=_num(row.get("close")),
+            instrument_class=_text(row.get("instrument_class")),
+            next_action=_text(row.get("next_action")),
+            notes=[n for n in (f"Setup {row.get('setup_stage')}" if row.get("setup_stage") else None,) if n],
+        ))
+    for position in payload.get("open_positions") or []:
+        symbol = _text(position.get("symbol"))
+        if not symbol:
+            continue
+        entry, last = _num(position.get("entry")), _num(position.get("last_price"))
+        items.append(FeedItem(
+            symbol=symbol, scanner="hull", stage="READY", held=True,
+            cmp=last, entry_low=entry, stop=_num(position.get("stop")),
+            target1=_num(position.get("target1")), target2=_num(position.get("target2")),
+            entry_date=_text(position.get("entry_date")),
+            unrealised_pct=round((last - entry) / entry * 100, 2)
+            if entry and last and entry > 0 else None,
+            next_action="Holding",
+        ))
+    return items
+
+
+def from_penny(payload: Mapping[str, Any]) -> list[FeedItem]:
+    """The penny scanner emits candidate dicts already close to feed shape."""
+    items: list[FeedItem] = []
+    for row in payload.get("candidates") or []:
+        symbol = _text(row.get("symbol"))
+        if not symbol:
+            continue
+        items.append(FeedItem(
+            symbol=symbol, scanner="penny",
+            stage=_text(row.get("stage")) or "RADAR",
+            availability=_text(row.get("availability")),
+            score=_num(row.get("score")), cmp=_num(row.get("cmp")) or _num(row.get("close")),
+            entry_low=_num(row.get("entry_low")), entry_high=_num(row.get("entry_high")),
+            stop=_num(row.get("stop")), risk_pct=_num(row.get("risk_pct")),
+            instrument_class=None if row.get("market_cap_verified") is not False
+            else "NON_EQ_UNVERIFIED",
+            next_action=_text(row.get("next_action")),
+            notes=[str(n) for n in (row.get("notes") or [])],
+        ))
+    return items
+
+
+ADAPTERS = {"v3": from_v3, "ladder": from_ladder, "hull": from_hull, "penny": from_penny}
+
+
+# --- assembly ---------------------------------------------------------------
+
+def _scanner_block(key: str, name: str, payload: Mapping[str, Any] | None) -> dict:
+    if payload is None:
+        return {"key": key, "name": name, "status": "MISSING", "items": []}
+    try:
+        items = ADAPTERS[key](payload)
+    except Exception as exc:            # one bad file must not empty the feed
+        return {"key": key, "name": name, "status": f"ERROR: {type(exc).__name__}",
+                "items": []}
+    gateway = payload.get("tradeability") or {}
+    return {
+        "key": key, "name": name, "status": "OK",
+        "market_date": _text(payload.get("market_date")) or _text(payload.get("trade_date"))
+        or _text(payload.get("as_of_date")),
+        "items": [item.to_dict() for item in items],
+        "stages": (payload.get("stage_funnel") or {}).get("stages") or {},
+        "gateway": {
+            "evaluated": gateway.get("evaluated"), "eligible": gateway.get("eligible"),
+            "observe_only": gateway.get("observe_only"),
+            "rejections": gateway.get("rejection_counts") or {},
+            "terminal": gateway.get("terminal_detail") or {},
+        } if gateway else {},
+        "pnl": {
+            "realised": _num(payload.get("realised_pnl")),
+            "unrealised": _num(payload.get("unrealised_pnl")),
+            "total": _num(payload.get("total_pnl")),
+        } if payload.get("total_pnl") is not None else {},
+    }
+
+
+def build_feed(
+    sources: Sequence[tuple[str, str, str]] = SCANNER_SOURCES,
+    *,
+    root: str | Path = ".",
+    generated_at: str | None = None,
+) -> dict:
+    """Read whichever scanner run files exist and return the feed payload."""
+    base = Path(root)
+    blocks = []
+    for key, name, relative in sources:
+        path = base / relative
+        payload = None
+        if path.exists():
+            try:
+                payload = json.loads(path.read_text(encoding="utf-8"))
+            except (ValueError, json.JSONDecodeError):
+                payload = None
+        blocks.append(_scanner_block(key, name, payload))
+
+    dates = [b["market_date"] for b in blocks if b.get("market_date")]
+    all_items: list[dict] = [item for b in blocks for item in b["items"]]
+    stage_totals: dict[str, int] = {}
+    for item in all_items:
+        stage = item.get("availability") or item.get("stage")
+        stage_totals[stage] = stage_totals.get(stage, 0) + 1
+
+    return {
+        "feed_version": FEED_VERSION,
+        "generated_at": generated_at or datetime.now(timezone.utc).isoformat(timespec="seconds"),
+        # The newest session any scanner reported, so the app can warn when a
+        # scanner is lagging the others.
+        "market_date": max(dates) if dates else None,
+        "scanner_dates": {b["key"]: b.get("market_date") for b in blocks},
+        "totals": {
+            "items": len(all_items),
+            "held": sum(1 for i in all_items if i.get("held")),
+            "by_stage": dict(sorted(stage_totals.items(), key=lambda kv: -kv[1])),
+            "by_scanner": {b["key"]: len(b["items"]) for b in blocks},
+        },
+        "scanners": blocks,
+        "items": all_items,
+    }
+
+
+def write_feed(payload: Mapping[str, Any], path: str | Path) -> Path:
+    target = Path(path)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(json.dumps(payload, indent=2, sort_keys=False, default=str) + "\n",
+                      encoding="utf-8")
+    return target
