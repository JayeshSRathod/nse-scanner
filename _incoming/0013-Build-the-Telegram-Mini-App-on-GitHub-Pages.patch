diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
new file mode 100644
index 0000000..d276e04
--- /dev/null
+++ b/.github/workflows/pages.yml
@@ -0,0 +1,47 @@
+name: Publish Mini App to GitHub Pages
+
+# The Mini App is a static page plus a static JSON feed, so it needs hosting but
+# no server. This publishes docs/ whenever the daily pipeline commits a new feed.
+#
+# One-time setup: Settings -> Pages -> Build and deployment -> Source:
+# "GitHub Actions". Then note the published URL and set MINI_APP_URL.
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'docs/**'
+      - '.github/workflows/pages.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+
+# Never cancel a publish midway; let one finish before the next starts.
+concurrency:
+  group: pages
+  cancel-in-progress: false
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - uses: actions/checkout@v4
+      - name: Fail early if the feed is missing
+        run: |
+          test -f docs/index.html || { echo "docs/index.html missing"; exit 1; }
+          test -f docs/data/feed.json || { echo "docs/data/feed.json missing"; exit 1; }
+          python -c "import json,sys; d=json.load(open('docs/data/feed.json')); \
+            print('feed items:', d.get('totals',{}).get('items')); \
+            sys.exit(0 if 'items' in d else 1)"
+      - uses: actions/configure-pages@v5
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: docs
+      - id: deployment
+        uses: actions/deploy-pages@v4
