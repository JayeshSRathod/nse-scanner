+"""Penny & Microcap Shadow Scanner Telegram cards.
+
+Renders the four sections the specification asks for — Radar, Confirming, Ready
+and Circuit Risk — from plain candidate dictionaries, so this module works
+whatever shape the penny scanner's internals take.  Each candidate needs, at
+minimum, ``symbol`` and ``score``; every other field degrades gracefully to a
+"not yet confirmed" line rather than a crash or a misleading zero.
+
+Card layout follows the specification exactly:
+
+    🪙 PENNY EARLY RADAR
+    21 Aug 2026 EOD • PAPER
+
+    🔵 ABC • EARLY RADAR • 44/100
+    CMP ₹8.42
+
+    5D return: +6.8%
+    Turnover: 1.8× normal
+    Delivery: Not yet confirmed
+    Trend: EMA20 turning upward
+
+    Next: Confirm sustained participation
+"""
+from __future__ import annotations
+
+from typing import Iterable, Mapping, Sequence
+
+from v2.progressive_stages import (
+    CIRCUIT_LOCKED,
+    CIRCUIT_WATCH,
+    CONFIRMING,
+    EXTENDED,
+    POST_CIRCUIT_CONFIRMING,
+    QUALIFIED,
+    RADAR,
+    READY,
+    STAGE_BADGE,
+    STAGE_NEXT_ACTION,
+    TERMINATED,
+)
+
+DIVIDER = "━━━━━━━━━━━━━━"
+
+#: Display label per stage. RADAR reads as EARLY RADAR in penny cards, which is
+#: the wording the specification uses.
+STAGE_LABEL = {
+    RADAR: "EARLY RADAR",
+    CONFIRMING: "CONFIRMING",
+    QUALIFIED: "READY REVIEW",
+    READY: "READY",
+    CIRCUIT_WATCH: "CIRCUIT WATCH",
+    CIRCUIT_LOCKED: "CIRCUIT LOCKED",
+    POST_CIRCUIT_CONFIRMING: "POST-CIRCUIT CONFIRMING",
+    EXTENDED: "EXTENDED",
+    TERMINATED: "TERMINATED",
+}
+
+#: Sections, in delivery order, and the states each collects.
+SECTIONS: tuple[tuple[str, str, frozenset[str]], ...] = (
+    ("🪙 PENNY EARLY RADAR", "radar", frozenset({RADAR})),
+    ("🟡 PENNY CONFIRMING", "confirming", frozenset({CONFIRMING})),
+    ("🟢 PENNY READY — PAPER", "ready", frozenset({QUALIFIED, READY})),
+    ("🔴 PENNY CIRCUIT RISK", "circuit", frozenset({
+        CIRCUIT_WATCH, CIRCUIT_LOCKED, POST_CIRCUIT_CONFIRMING, EXTENDED, TERMINATED,
+    })),
+)
+
+_NOT_CONFIRMED = "Not yet confirmed"
+
+
+def _rupees(value: object) -> str:
+    try:
+        return f"₹{float(value):,.2f}"
+    except (TypeError, ValueError):
+        return "₹—"
+
+
+def _signed_pct(value: object) -> str | None:
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    return f"{number:+.1f}%"
+
+
+def _multiple(value: object) -> str | None:
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    return f"{number:.1f}× normal"
+
+
+def _state_of(candidate: Mapping[str, object]) -> str:
+    """Availability wins the headline; stage is the fallback."""
+    availability = str(candidate.get("availability") or "").strip()
+    if availability:
+        return availability
+    return str(candidate.get("stage") or RADAR)
+
+
+def render_card(candidate: Mapping[str, object]) -> str:
+    """One candidate card. Missing evidence is stated, never invented."""
+    symbol = str(candidate.get("symbol", "?"))
+    state = _state_of(candidate)
+    label = STAGE_LABEL.get(state, state)
+    badge = STAGE_BADGE.get(state, "🔵")
+
+    header = f"{badge} <b>{symbol}</b> • {label}"
+    score = candidate.get("score")
+    if score is not None:
+        try:
+            header += f" • {float(score):.0f}/100"
+        except (TypeError, ValueError):
+            pass
+    lines = [header, f"CMP {_rupees(candidate.get('cmp', candidate.get('close')))}", ""]
+
+    if candidate.get("market_cap_verified") is False:
+        lines.append("Market cap: UNVERIFIED — observation only")
+
+    return_5d = _signed_pct(candidate.get("return_5d"))
+    lines.append(f"5D return: {return_5d}" if return_5d else f"5D return: {_NOT_CONFIRMED}")
+
+    turnover = _multiple(candidate.get("turnover_ratio"))
+    lines.append(f"Turnover: {turnover}" if turnover else f"Turnover: {_NOT_CONFIRMED}")
+
+    delivery = candidate.get("delivery_pct")
+    delivery_text = _NOT_CONFIRMED
+    if delivery is not None:
+        try:
+            delivery_text = f"{float(delivery):.1f}%"
+        except (TypeError, ValueError):
+            delivery_text = _NOT_CONFIRMED
+    trend = str(candidate.get("trend") or "").strip()
+    lines.append(f"Delivery: {delivery_text}")
+    if trend:
+        lines.append(f"Trend: {trend}")
+
+    entry_low, entry_high = candidate.get("entry_low"), candidate.get("entry_high")
+    if entry_low is not None and entry_high is not None:
+        prefix = "Entry" if state == READY else "Probable entry"
+        lines.append(f"{prefix}: {_rupees(entry_low)}–{_rupees(entry_high)}")
+    if candidate.get("stop") is not None:
+        lines.append(f"SL: {_rupees(candidate['stop'])}")
+
+    for note in candidate.get("notes") or ():
+        lines.append(str(note))
+
+    next_action = str(candidate.get("next_action") or "").strip() \
+        or STAGE_NEXT_ACTION.get(state, "")
+    if next_action:
+        lines.extend(["", f"Next: {next_action}"])
+    return "\n".join(lines)
+
+
+def render_section(
+    title: str,
+    candidates: Sequence[Mapping[str, object]],
+    market_date: str,
+    *,
+    max_cards: int = 20,
+) -> str:
+    """One section message, or empty when the section has no candidates."""
+    if not candidates:
+        return ""
+    ordered = sorted(
+        candidates,
+        key=lambda row: (-float(row.get("score") or 0.0), str(row.get("symbol", ""))),
+    )
+    lines = [f"<b>{title}</b>", f"{market_date} EOD • PAPER", ""]
+    for index, candidate in enumerate(ordered[:max_cards]):
+        if index:
+            lines.extend([DIVIDER, ""])
+        lines.append(render_card(candidate))
+        lines.append("")
+    if len(ordered) > max_cards:
+        lines.append(f"… and {len(ordered) - max_cards} more")
+    lines.append("⚠️ Paper research output. Not a live-trading instruction.")
+    return "\n".join(lines).strip()
+
+
+def bucket_candidates(
+    candidates: Iterable[Mapping[str, object]],
+) -> dict[str, list[Mapping[str, object]]]:
+    """Split candidates into the four delivery sections."""
+    buckets: dict[str, list[Mapping[str, object]]] = {
+        key: [] for _, key, _ in SECTIONS
+    }
+    for candidate in candidates:
+        state = _state_of(candidate)
+        for _, key, states in SECTIONS:
+            if state in states:
+                buckets[key].append(candidate)
+                break
+    return buckets
+
+
+def render_sections(
+    candidates: Iterable[Mapping[str, object]],
+    market_date: str,
+    *,
+    max_cards: int = 20,
+) -> dict[str, str]:
+    """``{section_key: message}``, omitting sections with nothing to say."""
+    buckets = bucket_candidates(candidates)
+    messages: dict[str, str] = {}
+    for title, key, _ in SECTIONS:
+        body = render_section(title, buckets[key], market_date, max_cards=max_cards)
+        if body:
+            messages[key] = body
+    return messages
+
+
+def render_summary(
+    candidates: Sequence[Mapping[str, object]],
+    market_date: str,
+    *,
+    gateway: Mapping[str, object] | None = None,
+) -> str:
+    """A one-message digest for the system topic."""
+    buckets = bucket_candidates(candidates)
+    lines = ["🪙 <b>PENNY & MICROCAP SHADOW — SUMMARY</b>",
+             f"{market_date} EOD • PAPER", ""]
+    for title, key, _ in SECTIONS:
+        lines.append(f"{title}: {len(buckets[key])}")
+    entry_ready = sum(
+        1 for row in candidates
+        if _state_of(row) == READY and row.get("market_cap_verified") is not False
+    )
+    lines.append(f"Entry authorised: {entry_ready}")
+    if gateway:
+        from v2.scanner_notices import render_gateway_notice
+        notice = render_gateway_notice(gateway)
+        if notice:
+            lines.extend(["", notice])
+    return "\n".join(lines)
