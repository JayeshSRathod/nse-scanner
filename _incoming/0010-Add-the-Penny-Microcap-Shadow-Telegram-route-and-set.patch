@@ -0,0 +1,245 @@
+"""Penny & Microcap Shadow bot: isolation, fail-closed delivery, card format."""
+from __future__ import annotations
+
+import pytest
+
+from penny_shadow import cards
+from penny_shadow.telegram import (
+    CHAR_LIMIT,
+    REQUIRED_SECRETS,
+    TOPIC_KINDS,
+    credentials_present,
+    preflight,
+    send_circuit,
+    send_radar,
+    send_ready,
+    split_message,
+    topic_id,
+)
+
+MARKET_DATE = "2026-08-21"
+
+RADAR = {"symbol": "ABC", "stage": "RADAR", "score": 44.0, "cmp": 8.42,
+         "return_5d": 6.8, "turnover_ratio": 1.8, "delivery_pct": None,
+         "trend": "EMA20 turning upward", "market_cap_verified": False}
+CONFIRMING = {"symbol": "XYZ", "stage": "CONFIRMING", "score": 59.0, "cmp": 21.30,
+              "return_5d": 9.4, "turnover_ratio": 2.3, "delivery_pct": 31.5,
+              "trend": "Range breakout developing",
+              "entry_low": 21.60, "entry_high": 22.15}
+READY = {"symbol": "GOODPENNY", "stage": "READY", "score": 74.0, "cmp": 33.10,
+         "return_5d": 4.2, "turnover_ratio": 2.1, "delivery_pct": 38.0,
+         "entry_low": 33.40, "entry_high": 34.05, "stop": 30.90}
+LOCKED = {"symbol": "NHCFOODS", "stage": "READY", "availability": "CIRCUIT_LOCKED",
+          "score": 82.0, "cmp": 1.63, "return_5d": 19.6, "turnover_ratio": 4.5,
+          "notes": ["Current entry unavailable", "Price already extended"]}
+ALL = [RADAR, CONFIRMING, READY, LOCKED]
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for name in REQUIRED_SECRETS:
+        monkeypatch.delenv(name, raising=False)
+    for kind in TOPIC_KINDS:
+        monkeypatch.delenv(f"PENNY_{kind}_TOPIC_ID", raising=False)
+
+
+# --- fail-closed isolation --------------------------------------------------
+
+def test_delivery_fails_closed_without_credentials():
+    result = send_radar(["hello"], enabled=True)
+    assert result.sent is False
+    assert result.reason == "penny_telegram_credentials_missing"
+    assert result.message_count == 0
+
+
+def test_the_penny_route_never_borrows_another_scanners_bot(monkeypatch):
+    """A penny card must never surface in a large-cap topic."""
+    for foreign in ("V3_TELEGRAM_BOT_TOKEN", "LADDER_TELEGRAM_BOT_TOKEN",
+                    "HULL_TELEGRAM_BOT_TOKEN"):
+        monkeypatch.setenv(foreign, "borrowed-token")
+        monkeypatch.setenv(foreign.replace("BOT_TOKEN", "CHAT_ID"), "-100999")
+    assert credentials_present() is False
+    assert send_radar(["x"], enabled=True).reason == "penny_telegram_credentials_missing"
+
+
+def test_dry_run_sends_nothing_even_with_credentials(monkeypatch):
+    monkeypatch.setenv("PENNY_TELEGRAM_BOT_TOKEN", "t")
+    monkeypatch.setenv("PENNY_TELEGRAM_CHAT_ID", "-1001")
+    assert send_radar(["x"], enabled=False).reason == "dry_run"
+
+
+def test_empty_messages_are_not_delivered(monkeypatch):
+    monkeypatch.setenv("PENNY_TELEGRAM_BOT_TOKEN", "t")
+    monkeypatch.setenv("PENNY_TELEGRAM_CHAT_ID", "-1001")
+    assert send_radar(["", "   "], enabled=True).reason == "no_messages"
+
+
+def test_preflight_reports_presence_without_leaking_values(monkeypatch):
+    monkeypatch.setenv("PENNY_TELEGRAM_BOT_TOKEN", "super-secret")
+    status = preflight()
+    assert status["required"]["PENNY_TELEGRAM_BOT_TOKEN"] is True
+    assert status["required"]["PENNY_TELEGRAM_CHAT_ID"] is False
+    assert status["ready"] is False
+    assert "super-secret" not in repr(status)
+
+
+# --- topic routing ----------------------------------------------------------
+
+def test_topic_id_is_read_per_section(monkeypatch):
+    monkeypatch.setenv("PENNY_RADAR_TOPIC_ID", "42")
+    assert topic_id("RADAR") == 42
+    assert topic_id("READY") is None
+
+
+@pytest.mark.parametrize("value", ["0", "-1", "", "abc"])
+def test_invalid_topic_ids_fall_back_to_the_chat_root(monkeypatch, value):
+    monkeypatch.setenv("PENNY_READY_TOPIC_ID", value)
+    assert topic_id("READY") is None
+
+
+def test_each_section_posts_to_its_own_thread(monkeypatch):
+    monkeypatch.setenv("PENNY_TELEGRAM_BOT_TOKEN", "t")
+    monkeypatch.setenv("PENNY_TELEGRAM_CHAT_ID", "-1001")
+    monkeypatch.setenv("PENNY_RADAR_TOPIC_ID", "11")
+    monkeypatch.setenv("PENNY_CIRCUIT_TOPIC_ID", "44")
+
+    threads: list[object] = []
+
+    class _Session:
+        def post(self, url, json, timeout):  # noqa: A002
+            threads.append(json.get("message_thread_id"))
+
+            class _R:
+                @staticmethod
+                def raise_for_status(): return None
+
+                @staticmethod
+                def json(): return {"ok": True}
+            return _R()
+
+    session = _Session()
+    assert send_radar(["a"], enabled=True, session=session).sent
+    assert send_circuit(["b"], enabled=True, session=session).sent
+    assert send_ready(["c"], enabled=True, session=session).sent
+    assert threads == [11, 44, None]
+
+
+# --- long-message handling --------------------------------------------------
+
+def test_short_messages_are_not_split():
+    assert split_message("hello") == ["hello"]
+    assert split_message("") == []
+
+
+def test_long_messages_split_on_card_boundaries():
+    card = "X" * 900
+    chunks = split_message("\n\n".join([card] * 10))
+    assert len(chunks) > 1
+    assert all(len(chunk) <= CHAR_LIMIT for chunk in chunks)
+    # No card is broken across chunks.
+    assert all(set(chunk.replace("\n", "")) == {"X"} for chunk in chunks)
+
+
+# --- card format ------------------------------------------------------------
+
+def test_radar_card_matches_the_specified_layout():
+    card = cards.render_card(RADAR)
+    assert "🔵 <b>ABC</b> • EARLY RADAR • 44/100" in card
+    assert "CMP ₹8.42" in card
+    assert "5D return: +6.8%" in card
+    assert "Turnover: 1.8× normal" in card
+    assert "Delivery: Not yet confirmed" in card
+    assert "Trend: EMA20 turning upward" in card
+    assert "Next: Confirm sustained participation" in card
+
+
+def test_unverified_market_cap_is_stated_on_the_card():
+    assert "Market cap: UNVERIFIED — observation only" in cards.render_card(RADAR)
+
+
+def test_confirming_card_offers_a_probable_entry_not_an_entry():
+    card = cards.render_card(CONFIRMING)
+    assert "CONFIRMING • 59/100" in card
+    assert "Probable entry: ₹21.60–₹22.15" in card
+    assert "Delivery: 31.5%" in card
+
+
+def test_ready_card_states_an_entry_and_a_stop():
+    card = cards.render_card(READY)
+    assert "READY • 74/100" in card
+    assert "Entry: ₹33.40–₹34.05" in card
+    assert "Probable entry" not in card
+    assert "SL: ₹30.90" in card
+
+
+def test_circuit_locked_card_keeps_its_score_but_refuses_entry():
+    card = cards.render_card(LOCKED)
+    assert "🔴 <b>NHCFOODS</b> • CIRCUIT LOCKED • 82/100" in card
+    assert "82/100" in card, "a locked symbol is still detected and scored"
+    assert "Current entry unavailable" in card
+    assert "wait for normal two-way trading" in card
+
+
+def test_missing_evidence_is_stated_never_invented():
+    card = cards.render_card({"symbol": "BARE", "stage": "RADAR", "score": 36.0})
+    assert "CMP ₹—" in card
+    assert card.count("Not yet confirmed") >= 2
+    assert "+0.0%" not in card, "absent data must not render as zero"
+
+
+# --- sectioning -------------------------------------------------------------
+
+def test_candidates_are_split_into_the_four_sections():
+    buckets = cards.bucket_candidates(ALL)
+    assert [row["symbol"] for row in buckets["radar"]] == ["ABC"]
+    assert [row["symbol"] for row in buckets["confirming"]] == ["XYZ"]
+    assert [row["symbol"] for row in buckets["ready"]] == ["GOODPENNY"]
+    assert [row["symbol"] for row in buckets["circuit"]] == ["NHCFOODS"]
+
+
+def test_a_locked_symbol_is_routed_to_circuit_risk_not_to_ready():
+    """It reached READY on score, but it must not appear as an entry."""
+    buckets = cards.bucket_candidates([LOCKED])
+    assert buckets["ready"] == []
+    assert buckets["circuit"] == [LOCKED]
+
+
+def test_empty_sections_are_omitted():
+    messages = cards.render_sections([RADAR], MARKET_DATE)
+    assert set(messages) == {"radar"}
+
+
+def test_sections_are_dated_and_marked_paper():
+    messages = cards.render_sections(ALL, MARKET_DATE)
+    for body in messages.values():
+        assert f"{MARKET_DATE} EOD • PAPER" in body
+        assert "Not a live-trading instruction" in body
+
+
+def test_cards_are_ordered_by_score_within_a_section():
+    low = {**RADAR, "symbol": "LOW", "score": 36.0}
+    high = {**RADAR, "symbol": "HIGH", "score": 48.0}
+    body = cards.render_sections([low, high], MARKET_DATE)["radar"]
+    assert body.index("HIGH") < body.index("LOW")
+
+
+def test_overflow_is_reported_rather_than_silently_truncated():
+    many = [{**RADAR, "symbol": f"S{i}", "score": 40.0 + i} for i in range(25)]
+    body = cards.render_sections(many, MARKET_DATE, max_cards=5)["radar"]
+    assert "… and 20 more" in body
+
+
+def test_summary_counts_every_section_and_authorised_entries():
+    summary = cards.render_summary(ALL, MARKET_DATE)
+    assert "🪙 PENNY EARLY RADAR: 1" in summary
+    assert "🔴 PENNY CIRCUIT RISK: 1" in summary
+    assert "Entry authorised: 1", "only GOODPENNY qualifies"
+
+
+def test_summary_can_carry_the_gateway_notice():
+    summary = cards.render_summary(ALL, MARKET_DATE, gateway={
+        "evaluated": 900, "eligible": 700, "rejection_counts": {"STALE_SYMBOL_PRICE": 12},
+        "terminal_symbols": [], "review_symbols": [],
+    })
+    assert "TRADEABILITY" in summary
+    assert "STALE_SYMBOL_PRICE: 12" in summary
