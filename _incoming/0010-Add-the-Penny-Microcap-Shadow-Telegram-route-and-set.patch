+"""Penny & Microcap Shadow Scanner — delivery layer.
+
+The scanner's strategy logic is maintained separately; this package holds its
+isolated Telegram route and card renderer so the fourth bot can be provisioned
+and validated before the scanner is wired to it.
+"""
+from .cards import render_card, render_sections, render_summary
+from .telegram import (
+    credentials_present,
+    preflight,
+    send_circuit,
+    send_confirming,
+    send_radar,
+    send_ready,
+    send_system,
+)
+
+__all__ = [
+    "render_card", "render_sections", "render_summary",
+    "credentials_present", "preflight",
+    "send_radar", "send_confirming", "send_ready", "send_circuit", "send_system",
+]
