@@ -0,0 +1,164 @@
+"""Fail-closed Telegram delivery for the isolated Penny & Microcap Shadow bot.
+
+Fourth route in the per-scanner pattern established by
+``docs/TELEGRAM_THREE_BOT_ROUTING.md``.  A missing ``PENNY_*`` credential stops
+this delivery and never falls back to the V3, Ladder or Hull bot — a penny-stock
+card must never appear in a large-cap topic.
+
+Topics are separate by stage, per the specification's "Separate Telegram
+sections for Radar, Confirming, Ready and Circuit Risk", so a reader can mute
+the radar firehose without losing entry authorisations.
+"""
+from __future__ import annotations
+
+import os
+import time
+from dataclasses import dataclass
+
+import requests
+
+#: Environment variables this module reads.  Nothing is ever hard-coded.
+TOKEN_VAR = "PENNY_TELEGRAM_BOT_TOKEN"
+CHAT_VAR = "PENNY_TELEGRAM_CHAT_ID"
+
+#: Topic kinds and the env var suffix each resolves to.
+TOPIC_RADAR = "RADAR"
+TOPIC_CONFIRMING = "CONFIRMING"
+TOPIC_READY = "READY"
+TOPIC_CIRCUIT = "CIRCUIT"
+TOPIC_PORTFOLIO = "PORTFOLIO"
+TOPIC_SYSTEM = "SYSTEM"
+
+TOPIC_KINDS: tuple[str, ...] = (
+    TOPIC_RADAR, TOPIC_CONFIRMING, TOPIC_READY,
+    TOPIC_CIRCUIT, TOPIC_PORTFOLIO, TOPIC_SYSTEM,
+)
+
+REQUIRED_SECRETS: tuple[str, ...] = (TOKEN_VAR, CHAT_VAR)
+OPTIONAL_SECRETS: tuple[str, ...] = tuple(f"PENNY_{kind}_TOPIC_ID" for kind in TOPIC_KINDS)
+
+#: Telegram rejects messages over 4096 characters.
+CHAR_LIMIT = 4096
+
+
+@dataclass(frozen=True)
+class DeliveryResult:
+    sent: bool
+    message_count: int
+    reason: str
+
+    def to_dict(self) -> dict:
+        return {"sent": self.sent, "message_count": self.message_count,
+                "reason": self.reason}
+
+
+def topic_id(kind: str) -> int | None:
+    """Resolve ``PENNY_<KIND>_TOPIC_ID``; ``None`` means post to the chat root."""
+    value = os.getenv(f"PENNY_{kind.upper()}_TOPIC_ID", "").strip()
+    try:
+        parsed = int(value)
+    except ValueError:
+        return None
+    return parsed if parsed > 0 else None
+
+
+def credentials_present() -> bool:
+    return all(os.getenv(name, "").strip() for name in REQUIRED_SECRETS)
+
+
+def split_message(message: str, limit: int = CHAR_LIMIT) -> list[str]:
+    """Split on card boundaries so a long radar list never truncates mid-card."""
+    message = message.strip()
+    if len(message) <= limit:
+        return [message] if message else []
+    chunks: list[str] = []
+    current: list[str] = []
+    size = 0
+    for block in message.split("\n\n"):
+        addition = len(block) + 2
+        if size + addition > limit and current:
+            chunks.append("\n\n".join(current))
+            current, size = [], 0
+        current.append(block)
+        size += addition
+    if current:
+        chunks.append("\n\n".join(current))
+    return chunks
+
+
+def _post(messages: list[str], *, enabled: bool, kind: str,
+          session: requests.Session | None = None) -> DeliveryResult:
+    if not enabled:
+        return DeliveryResult(False, 0, "dry_run")
+    token = os.getenv(TOKEN_VAR, "").strip()
+    chat_id = os.getenv(CHAT_VAR, "").strip()
+    if not token or not chat_id:
+        # Fail closed and name the route, so a missing secret is obvious in the
+        # workflow log rather than silently delivering nothing.
+        return DeliveryResult(False, 0, "penny_telegram_credentials_missing")
+
+    payloads: list[str] = []
+    for message in messages:
+        payloads.extend(split_message(message))
+    if not payloads:
+        return DeliveryResult(False, 0, "no_messages")
+
+    thread = topic_id(kind)
+    endpoint = f"https://api.telegram.org/bot{token}/sendMessage"
+    poster = session or requests
+    sent, errors = 0, []
+    for index, text in enumerate(payloads, start=1):
+        body: dict[str, object] = {
+            "chat_id": chat_id, "text": text, "parse_mode": "HTML",
+            "disable_web_page_preview": True,
+        }
+        if thread is not None:
+            body["message_thread_id"] = thread
+        try:
+            response = poster.post(endpoint, json=body, timeout=20)
+            response.raise_for_status()
+            if not response.json().get("ok"):
+                raise RuntimeError("telegram_rejected")
+            sent += 1
+        except (requests.RequestException, RuntimeError, ValueError) as exc:
+            errors.append(f"message_{index}:{type(exc).__name__}")
+        if index < len(payloads):
+            time.sleep(1)
+
+    if sent == len(payloads):
+        return DeliveryResult(True, sent, "sent")
+    reason = ("partial_delivery:" if sent else "delivery_failed:") + ",".join(errors)
+    return DeliveryResult(sent > 0, sent, reason)
+
+
+def send_radar(messages: list[str], *, enabled: bool, session=None) -> DeliveryResult:
+    return _post(messages, enabled=enabled, kind=TOPIC_RADAR, session=session)
+
+
+def send_confirming(messages: list[str], *, enabled: bool, session=None) -> DeliveryResult:
+    return _post(messages, enabled=enabled, kind=TOPIC_CONFIRMING, session=session)
+
+
+def send_ready(messages: list[str], *, enabled: bool, session=None) -> DeliveryResult:
+    return _post(messages, enabled=enabled, kind=TOPIC_READY, session=session)
+
+
+def send_circuit(messages: list[str], *, enabled: bool, session=None) -> DeliveryResult:
+    return _post(messages, enabled=enabled, kind=TOPIC_CIRCUIT, session=session)
+
+
+def send_portfolio(message: str, *, enabled: bool, session=None) -> DeliveryResult:
+    return _post([message], enabled=enabled, kind=TOPIC_PORTFOLIO, session=session)
+
+
+def send_system(message: str, *, enabled: bool, session=None) -> DeliveryResult:
+    return _post([message], enabled=enabled, kind=TOPIC_SYSTEM, session=session)
+
+
+def preflight() -> dict:
+    """Report which secrets are visible, without printing any of their values."""
+    return {
+        "required": {name: bool(os.getenv(name, "").strip()) for name in REQUIRED_SECRETS},
+        "topics": {kind: topic_id(kind) is not None for kind in TOPIC_KINDS},
+        "ready": credentials_present(),
+    }
