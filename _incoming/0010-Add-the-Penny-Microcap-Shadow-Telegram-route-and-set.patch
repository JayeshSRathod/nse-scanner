@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Validate the Penny bot's credentials and topics before wiring the scanner.
+
+Run this first.  It proves the token, chat and each topic ID work, using sample
+cards in the real card format, so a formatting or permission problem surfaces
+here rather than in a live daily run.
+
+    # 1. see what the environment exposes, send nothing
+    python scripts/penny_telegram_smoke.py
+
+    # 2. send one sample card per configured topic
+    python scripts/penny_telegram_smoke.py --send
+
+    # 3. send only the ready section
+    python scripts/penny_telegram_smoke.py --send --section ready
+
+Secret values are never printed — only whether each is present.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from penny_shadow.cards import render_sections, render_summary  # noqa: E402
+from penny_shadow.telegram import (  # noqa: E402
+    OPTIONAL_SECRETS,
+    REQUIRED_SECRETS,
+    TOPIC_KINDS,
+    credentials_present,
+    preflight,
+    send_circuit,
+    send_confirming,
+    send_radar,
+    send_ready,
+    send_system,
+    topic_id,
+)
+
+#: Sample candidates in the specification's own example shape.
+SAMPLES = [
+    {"symbol": "SAMPLEA", "stage": "RADAR", "score": 44.0, "cmp": 8.42,
+     "return_5d": 6.8, "turnover_ratio": 1.8, "delivery_pct": None,
+     "trend": "EMA20 turning upward", "market_cap_verified": False},
+    {"symbol": "SAMPLEB", "stage": "CONFIRMING", "score": 59.0, "cmp": 21.30,
+     "return_5d": 9.4, "turnover_ratio": 2.3, "delivery_pct": 31.5,
+     "trend": "Range breakout developing", "entry_low": 21.60, "entry_high": 22.15,
+     "notes": ["Turnover remained strong for 3 sessions"]},
+    {"symbol": "SAMPLEC", "stage": "READY", "score": 74.0, "cmp": 33.10,
+     "return_5d": 4.2, "turnover_ratio": 2.1, "delivery_pct": 38.0,
+     "trend": "Controlled pullback held EMA20", "entry_low": 33.40,
+     "entry_high": 34.05, "stop": 30.90},
+    {"symbol": "SAMPLED", "stage": "READY", "availability": "CIRCUIT_LOCKED",
+     "score": 82.0, "cmp": 1.63, "return_5d": 19.6, "turnover_ratio": 4.5,
+     "delivery_pct": None, "trend": "Momentum detected",
+     "notes": ["Current entry unavailable", "Price already extended"]},
+]
+
+SENDERS = {
+    "radar": send_radar,
+    "confirming": send_confirming,
+    "ready": send_ready,
+    "circuit": send_circuit,
+}
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--send", action="store_true",
+                        help="actually deliver; without it nothing is sent")
+    parser.add_argument("--section", choices=sorted(SENDERS) + ["summary", "all"],
+                        default="all")
+    parser.add_argument("--date", default="2026-08-21")
+    args = parser.parse_args(argv)
+
+    status = preflight()
+    print("PENNY TELEGRAM PREFLIGHT")
+    print("-" * 44)
+    for name in REQUIRED_SECRETS:
+        print(f"  {'OK  ' if status['required'][name] else 'MISS'}  {name}")
+    for kind in TOPIC_KINDS:
+        var = f"PENNY_{kind}_TOPIC_ID"
+        present = status["topics"][kind]
+        note = f"thread {topic_id(kind)}" if present else "not set (posts to chat root)"
+        print(f"  {'OK  ' if present else '--  '}  {var:28s} {note}")
+
+    if not credentials_present():
+        print("\nFAIL: set the two required secrets before sending.")
+        print("Optional topic IDs:", ", ".join(OPTIONAL_SECRETS))
+        return 1
+
+    messages = render_sections(SAMPLES, args.date)
+    print(f"\nRendered sections: {', '.join(messages) or 'none'}")
+    for key, body in messages.items():
+        print(f"  {key}: {len(body)} chars")
+
+    if not args.send:
+        print("\nDry run. Re-run with --send to deliver the sample cards.")
+        print("\n--- preview:", args.section, "---")
+        preview = (render_summary(SAMPLES, args.date) if args.section == "summary"
+                   else messages.get(args.section, next(iter(messages.values()), "")))
+        print(preview)
+        return 0
+
+    results: dict[str, dict] = {}
+    if args.section in {"all", "summary"}:
+        results["summary"] = send_system(
+            render_summary(SAMPLES, args.date), enabled=True).to_dict()
+    for key, sender in SENDERS.items():
+        if args.section not in {"all", key} or key not in messages:
+            continue
+        results[key] = sender([messages[key]], enabled=True).to_dict()
+
+    print("\nDelivery:", json.dumps(results, indent=2))
+    failed = [key for key, value in results.items() if not value["sent"]]
+    if failed:
+        print(f"\nFAIL: {', '.join(failed)} did not deliver.")
+        return 1
+    print("\nAll configured routes delivered. Safe to wire the scanner.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
