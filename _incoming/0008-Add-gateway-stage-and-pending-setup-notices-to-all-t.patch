diff --git a/v2/scanner_notices.py b/v2/scanner_notices.py
new file mode 100755
index 0000000..d44d146
--- /dev/null
+++ b/v2/scanner_notices.py
@@ -0,0 +1,191 @@
+"""Shared operator notices for gateway, lifecycle and stage reporting.
+
+Every scanner needs to say the same handful of things to the reader:
+
+* what the market date is, and whether it trails the run date
+* which symbols were removed and why — especially terminal corporate events,
+  which must be named with their successor rather than silently vanishing
+* which symbols are visible but not enterable, and what would change that
+* how many symbols sit at each progressive stage
+
+Rendering that once, here, keeps the three scanners' cards consistent without
+coupling their strategy logic.  These functions take plain dictionaries so they
+work equally with V3's dataclass result, the Ladder's JSON report and Hull
+Pine's state file.
+"""
+from __future__ import annotations
+
+from typing import Mapping, Sequence
+
+from .progressive_stages import PROGRESSION, STAGE_BADGE
+
+DIVIDER = "━━━━━━━━━━━━━━"
+
+
+def render_data_note(market_date: str, run_date: str | None = None) -> str:
+    """One line establishing which session the output actually describes."""
+    line = f"<b>Data:</b> {market_date} EOD"
+    if run_date and run_date != market_date:
+        line += f" (run {run_date}; last completed session is {market_date})"
+    return line
+
+
+def render_gateway_notice(
+    diagnostics: Mapping[str, object] | None,
+    results: Mapping[str, object] | None = None,
+    *,
+    max_named: int = 6,
+) -> str:
+    """Admission summary, naming terminal and withheld symbols.
+
+    ``results`` maps symbol to a ``TradeabilityResult``-shaped object; when
+    supplied, terminal symbols are named with their successor so a merger is
+    never a silent disappearance.
+    """
+    if not diagnostics:
+        return ""
+    counts = dict(diagnostics.get("rejection_counts") or {})
+    terminal = list(diagnostics.get("terminal_symbols") or [])
+    review = list(diagnostics.get("review_symbols") or [])
+    if not (counts or terminal or review):
+        return ""
+
+    lines = ["🛡️ <b>TRADEABILITY</b>",
+             f"Admitted {diagnostics.get('eligible', 0)} of {diagnostics.get('evaluated', 0)}"]
+    observe = diagnostics.get("observe_only") or 0
+    if observe:
+        lines.append(f"Observe-only (unverified instrument): {observe}")
+    for reason, count in list(counts.items())[:max_named]:
+        lines.append(f"• {reason}: {count}")
+
+    detail_map = dict(diagnostics.get("terminal_detail") or {})
+    for symbol in terminal[:max_named]:
+        record = (results or {}).get(symbol)
+        fallback = detail_map.get(symbol) or {}
+
+        def _field(name: str):
+            value = getattr(record, name, None)
+            return value if value is not None else fallback.get(name)
+
+        successor = _field("successor_symbol")
+        reason = _field("reason_code") or "TERMINAL"
+        last_traded = _field("symbol_last_date")
+        detail = f"⛔ <b>{symbol}</b> — {reason}"
+        if last_traded:
+            detail += f", last traded {last_traded}"
+        if successor:
+            ratio = _field("conversion_ratio")
+            detail += f" → {successor}"
+            if ratio:
+                detail += f" ({ratio:.4g} per share)"
+        lines.append(detail)
+        lines.append("   Excluded from current scanning. Price history retained.")
+
+    for symbol in review[:max_named]:
+        lines.append(f"⚠️ <b>{symbol}</b> — corporate event pending; entry withheld")
+
+    return "\n".join(lines)
+
+
+def render_stage_summary(stage_funnel: Mapping[str, object] | None,
+                        title: str = "PROGRESSIVE FUNNEL") -> str:
+    """Stage counts, most advanced first, plus availability states."""
+    if not stage_funnel:
+        return ""
+    stages = dict(stage_funnel.get("stages") or {})
+    availability = dict(stage_funnel.get("availability") or {})
+    if not (stages or availability):
+        return ""
+    lines = [f"📶 <b>{title}</b>"]
+    for stage in reversed(PROGRESSION):
+        count = stages.get(stage)
+        if count:
+            lines.append(f"{STAGE_BADGE.get(stage, '')} {stage}: {count}")
+    for state, count in sorted(availability.items()):
+        lines.append(f"{STAGE_BADGE.get(state, '')} {state}: {count}")
+    authorised = stage_funnel.get("entry_authorised")
+    if authorised is not None:
+        lines.append(f"Entry authorised: {authorised}")
+    blockers = dict(stage_funnel.get("ready_blockers") or {})
+    if blockers:
+        lines.append("Held below READY by:")
+        for reason, count in list(blockers.items())[:5]:
+            lines.append(f"• {reason}: {count}")
+    return "\n".join(lines)
+
+
+def render_pending_setups(
+    pending: Sequence[Mapping[str, object]],
+    *,
+    title: str = "READY — NOT ENTERED",
+    max_shown: int = 8,
+) -> str:
+    """Setups awaiting a next-session trigger.
+
+    This section exists because READY is no longer an entry.  Without it the
+    reader would see a symbol qualify and then apparently nothing happen.
+    """
+    if not pending:
+        return ""
+    lines = [f"🟢 <b>{title}</b>",
+             f"{len(pending)} setup(s) awaiting a next-session trigger"]
+    for setup in list(pending)[:max_shown]:
+        symbol = setup.get("symbol", "?")
+        low, high = setup.get("entry_low"), setup.get("entry_high")
+        lines.extend([
+            "", DIVIDER,
+            f"🟢 <b>{symbol}</b> • READY — NOT ENTERED",
+            f"Entry ₹{float(low):,.2f}–₹{float(high):,.2f}"
+            if low is not None and high is not None else "Entry range pending",
+            f"SL ₹{float(setup.get('initial_stop', 0.0)):,.2f}",
+        ])
+        waited = int(setup.get("sessions_waited", 0) or 0)
+        validity = int(setup.get("expires_after_sessions", 0) or 0)
+        if waited:
+            lines.append(f"Waiting {waited} of {validity} sessions"
+                         f" • last: {setup.get('last_outcome', '-')}")
+        lines.append("Next: Await next-session trigger")
+    return "\n".join(lines)
+
+
+def render_expired_setups(expired: Sequence[Mapping[str, object]],
+                         *, max_shown: int = 6) -> str:
+    """Setups that lapsed, with the reason, so a silent non-entry is explained."""
+    if not expired:
+        return ""
+    lines = ["⌛ <b>SETUPS LAPSED</b>"]
+    for setup in list(expired)[:max_shown]:
+        lines.append(f"• {setup.get('symbol', '?')}: "
+                     f"{setup.get('expiry_reason', 'EXPIRED')}")
+    return "\n".join(lines)
+
+
+def render_reconciliation(actions: Sequence[Mapping[str, object]],
+                         *, max_shown: int = 6) -> str:
+    """Holdings closed or converted because the universe moved under them."""
+    if not actions:
+        return ""
+    lines = ["🔁 <b>UNIVERSE RECONCILIATION</b>"]
+    for action in list(actions)[:max_shown]:
+        symbol = action.get("symbol", "?")
+        kind = action.get("action", "?")
+        reason = action.get("reason_code", "")
+        if kind == "CORPORATE_CONVERSION":
+            successor = action.get("successor_symbol")
+            quantity = action.get("successor_quantity")
+            lines.append(f"• {symbol} → {successor}: converted"
+                         + (f", {quantity:g} shares" if quantity is not None else ""))
+            fractional = action.get("fractional_entitlement") or 0
+            if fractional:
+                lines.append(f"  fractional {fractional:g} — settle per the scheme")
+            lines.append("  Realised P&L ₹0 at conversion")
+        else:
+            price = action.get("exit_price")
+            lines.append(f"• {symbol}: {kind} ({reason})"
+                         + (f" at ₹{float(price):,.2f}" if price is not None else ""))
+    return "\n".join(lines)
+
+
