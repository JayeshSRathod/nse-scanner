+"""Step 10: the reader must be told what was removed and what is armed."""
+from __future__ import annotations
+
+from v2.scanner_notices import (
+    assemble,
+    render_data_note,
+    render_expired_setups,
+    render_gateway_notice,
+    render_pending_setups,
+    render_reconciliation,
+    render_stage_summary,
+)
+from v2.tradeability import TradeabilityResult
+
+
+def _terminal_result() -> TradeabilityResult:
+    return TradeabilityResult(
+        symbol="JBCHEPHARM", eligible=False, reason_code="TERMINAL_MERGER",
+        stage="CORPORATE_LIFECYCLE", market_date="2026-08-20",
+        symbol_last_date="2026-07-16", successor_symbol="TORNTPHARM",
+        conversion_ratio=0.51,
+    )
+
+
+DIAGNOSTICS = {
+    "market_date": "2026-08-20", "evaluated": 2157, "eligible": 1657,
+    "entry_permitted": 1656, "observe_only": 343, "non_eq_unverified": 343,
+    "rejection_counts": {"NOT_IN_CURRENT_NSE_UNIVERSE": 265, "NON_EQ_SERIES": 123,
+                         "TERMINAL_MERGER": 1},
+    "terminal_symbols": ["JBCHEPHARM"], "review_symbols": ["KIRLPNU"],
+}
+
+
+# --- data note --------------------------------------------------------------
+
+def test_data_note_states_the_market_date():
+    assert render_data_note("2026-08-20") == "<b>Data:</b> 2026-08-20 EOD"
+
+
+def test_data_note_flags_a_run_date_ahead_of_the_session():
+    note = render_data_note("2026-08-20", "2026-08-23")
+    assert "run 2026-08-23" in note
+    assert "last completed session is 2026-08-20" in note
+
+
+# --- gateway notice ---------------------------------------------------------
+
+def test_terminal_symbol_is_named_with_its_successor_not_silently_dropped():
+    notice = render_gateway_notice(DIAGNOSTICS, {"JBCHEPHARM": _terminal_result()})
+    assert "JBCHEPHARM" in notice
+    assert "TERMINAL_MERGER" in notice
+    assert "last traded 2026-07-16" in notice
+    assert "TORNTPHARM" in notice
+    assert "0.51 per share" in notice
+    assert "Price history retained" in notice
+
+
+def test_gateway_notice_reports_admission_and_observe_only_counts():
+    notice = render_gateway_notice(DIAGNOSTICS)
+    assert "Admitted 1657 of 2157" in notice
+    assert "Observe-only (unverified instrument): 343" in notice
+    assert "NON_EQ_SERIES: 123" in notice
+
+
+def test_symbols_under_corporate_review_are_named_as_entry_withheld():
+    notice = render_gateway_notice(DIAGNOSTICS)
+    assert "KIRLPNU" in notice
+    assert "entry withheld" in notice
+
+
+def test_gateway_notice_is_empty_when_nothing_was_rejected():
+    assert render_gateway_notice({"evaluated": 10, "eligible": 10,
+                                  "rejection_counts": {}, "terminal_symbols": [],
+                                  "review_symbols": []}) == ""
+    assert render_gateway_notice(None) == ""
+
+
+# --- stage summary ----------------------------------------------------------
+
+def test_stage_summary_lists_the_most_advanced_stage_first():
+    summary = render_stage_summary({
+        "stages": {"RADAR": 23, "CONFIRMING": 185, "READY": 713},
+        "availability": {"OBSERVE_ONLY": 66, "CORPORATE_REVIEW": 1},
+        "entry_authorised": 713,
+        "ready_blockers": {"LOW_MEDIAN_VOLUME": 652, "INSUFFICIENT_HISTORY": 251},
+    })
+    assert summary.index("READY: 713") < summary.index("CONFIRMING: 185")
+    assert summary.index("CONFIRMING: 185") < summary.index("RADAR: 23")
+    assert "OBSERVE_ONLY: 66" in summary
+    assert "Entry authorised: 713" in summary
+    assert "Held below READY by:" in summary
+    assert "LOW_MEDIAN_VOLUME: 652" in summary
+
+
+def test_stage_summary_is_empty_without_data():
+    assert render_stage_summary(None) == ""
+    assert render_stage_summary({"stages": {}, "availability": {}}) == ""
+
+
+# --- pending setups ---------------------------------------------------------
+
+PENDING = [{
+    "symbol": "BERGEPAINT", "entry_low": 539.55, "entry_high": 547.60,
+    "initial_stop": 509.56, "sessions_waited": 0, "expires_after_sessions": 5,
+}]
+
+
+def test_pending_setups_are_shown_as_ready_but_not_entered():
+    """Without this section a qualifying symbol appears to simply vanish."""
+    block = render_pending_setups(PENDING)
+    assert "READY — NOT ENTERED" in block
+    assert "BERGEPAINT" in block
+    assert "Entry ₹539.55–₹547.60" in block
+    assert "SL ₹509.56" in block
+    assert "Next: Await next-session trigger" in block
+
+
+def test_waiting_setups_report_how_long_they_have_waited():
+    block = render_pending_setups([{**PENDING[0], "sessions_waited": 2,
+                                    "last_outcome": "TRIGGER_NOT_REACHED"}])
+    assert "Waiting 2 of 5 sessions" in block
+    assert "TRIGGER_NOT_REACHED" in block
+
+
+def test_no_pending_section_when_nothing_is_armed():
+    assert render_pending_setups([]) == ""
+
+
+def test_lapsed_setups_explain_the_non_entry():
+    block = render_expired_setups([
+        {"symbol": "GIPCL", "expiry_reason": "GAP_BEYOND_ENTRY_RANGE"},
+        {"symbol": "5PAISA", "expiry_reason": "SETUP_TIMED_OUT"},
+    ])
+    assert "SETUPS LAPSED" in block
+    assert "GIPCL: GAP_BEYOND_ENTRY_RANGE" in block
+    assert "5PAISA: SETUP_TIMED_OUT" in block
+
+
+# --- reconciliation ---------------------------------------------------------
+
+def test_conversion_is_reported_as_zero_pnl_not_as_a_trade_result():
+    block = render_reconciliation([{
+        "symbol": "JBCHEPHARM", "action": "CORPORATE_CONVERSION",
+        "reason_code": "TERMINAL_MERGER", "successor_symbol": "TORNTPHARM",
+        "successor_quantity": 51.0, "fractional_entitlement": 0.0,
+    }])
+    assert "JBCHEPHARM → TORNTPHARM: converted" in block
+    assert "51 shares" in block
+    assert "Realised P&L ₹0 at conversion" in block
+
+
+def test_fractional_entitlement_is_surfaced_for_manual_settlement():
+    block = render_reconciliation([{
+        "symbol": "JBCHEPHARM", "action": "CORPORATE_CONVERSION",
+        "reason_code": "TERMINAL_MERGER", "successor_symbol": "TORNTPHARM",
+        "successor_quantity": 89.0, "fractional_entitlement": 0.25,
+    }])
+    assert "fractional 0.25" in block
+    assert "settle per the scheme" in block
+
+
+def test_universe_exit_reports_the_exit_price():
+    block = render_reconciliation([{
+        "symbol": "GSEC10IETF", "action": "UNIVERSE_EXIT",
+        "reason_code": "NON_EQ_UNVERIFIED_HOLDING", "exit_price": 266.38,
+    }])
+    assert "GSEC10IETF: UNIVERSE_EXIT" in block
+    assert "NON_EQ_UNVERIFIED_HOLDING" in block
+    assert "₹266.38" in block
+
+
+def test_no_reconciliation_section_when_nothing_moved():
+    assert render_reconciliation([]) == ""
+
+
+# --- assembly ---------------------------------------------------------------
+
+def test_assemble_drops_empty_blocks():
+    assert assemble("a", "", "b", "") == "a\n\nb"
+    assert assemble("", "") == ""
+
+
+def test_terminal_detail_travels_in_the_diagnostics_payload():
+    """A renderer holding only diagnostics must still name the successor."""
+    diagnostics = {
+        **DIAGNOSTICS,
+        "terminal_detail": {"JBCHEPHARM": {
+            "reason_code": "TERMINAL_MERGER", "successor_symbol": "TORNTPHARM",
+            "conversion_ratio": 0.51, "symbol_last_date": "2026-07-16",
+        }},
+    }
+    notice = render_gateway_notice(diagnostics)      # no results map supplied
+    assert "TERMINAL_MERGER" in notice
+    assert "TORNTPHARM" in notice
+    assert "last traded 2026-07-16" in notice
