+"""Regression tests for the shared Pre-Scan Tradeability Gateway.
+
+These cover every reason code the gateway can emit, the JBCHEPHARM defect that
+motivated it, and the historical-integrity rule that a replay of a past date
+must still admit a symbol that was legitimately tradeable then.
+"""
+from __future__ import annotations
+
+import sqlite3
+from datetime import date, timedelta
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from v2.database import V2Database
+from v2.security_lifecycle import (
+    LifecycleEvent,
+    LifecycleRegistry,
+    event_from_mapping,
+    load_events,
+    load_registry,
+    read_snapshot,
+    upsert_events,
+)
+from v2.tradeability import (
+    REASON_CODES,
+    TRADEABLE,
+    evaluate_tradeability,
+    evaluate_universe,
+    gateway_from_database,
+    market_date_from_prices,
+    session_calendar_from_prices,
+)
+
+MARKET_DATE = "2026-08-20"
+
+
+def _sessions(count: int, end: str = MARKET_DATE) -> list[str]:
+    """`count` synthetic weekday sessions ending on `end` inclusive."""
+    days: list[str] = []
+    cursor = date.fromisoformat(end)
+    while len(days) < count:
+        if cursor.weekday() < 5:
+            days.append(cursor.isoformat())
+        cursor -= timedelta(days=1)
+    return sorted(days)
+
+
+def _frame(symbol: str, days: list[str], close: float = 100.0) -> pd.DataFrame:
+    return pd.DataFrame({
+        "symbol": symbol,
+        "trade_date": days,
+        "open": close, "high": close * 1.01, "low": close * 0.99, "close": close,
+        "volume": 500_000,
+    })
+
+
+def _master(symbol: str, **overrides) -> dict:
+    row = {"symbol": symbol, "series": "EQ", "active": 1}
+    row.update(overrides)
+    return row
+
+
+CALENDAR = tuple(_sessions(60))
+FRESH = _sessions(60)
+
+
+# --- happy path -------------------------------------------------------------
+
+def test_fresh_active_eq_symbol_is_tradeable():
+    result = evaluate_tradeability(
+        "RELIANCE", _frame("RELIANCE", FRESH),
+        market_date=MARKET_DATE, master_row=_master("RELIANCE"),
+        session_calendar=CALENDAR,
+    )
+    assert result.eligible
+    assert result.reason_code == TRADEABLE
+    assert result.entry_blocked is False
+    assert result.symbol_last_date == MARKET_DATE
+    assert result.staleness_sessions == 0
+
+
+# --- the eight mandatory rules ---------------------------------------------
+
+def test_missing_security_master_row_fails_closed():
+    result = evaluate_tradeability(
+        "GHOSTCO", _frame("GHOSTCO", FRESH),
+        market_date=MARKET_DATE, master_row=None, session_calendar=CALENDAR,
+    )
+    assert not result.eligible
+    assert result.reason_code == "NOT_IN_CURRENT_NSE_UNIVERSE"
+
+
+def test_non_eq_series_is_rejected():
+    result = evaluate_tradeability(
+        "SOMEBE", _frame("SOMEBE", FRESH),
+        market_date=MARKET_DATE, master_row=_master("SOMEBE", series="BE"),
+        session_calendar=CALENDAR,
+    )
+    assert result.reason_code == "NON_EQ_SERIES"
+
+
+@pytest.mark.parametrize("flag", [0, "0", "0.0", False, "false", "NO"])
+def test_inactive_security_is_rejected_for_every_csv_encoding(flag):
+    """A CSV round-trip turns active=0 into the truthy string "0"."""
+    result = evaluate_tradeability(
+        "DEADCO", _frame("DEADCO", FRESH),
+        market_date=MARKET_DATE, master_row=_master("DEADCO", active=flag),
+        session_calendar=CALENDAR,
+    )
+    assert result.reason_code == "INACTIVE_SECURITY", flag
+
+
+def test_absent_active_flag_fails_closed():
+    row = {"symbol": "NOFLAG", "series": "EQ"}
+    result = evaluate_tradeability(
+        "NOFLAG", _frame("NOFLAG", FRESH),
+        market_date=MARKET_DATE, master_row=row, session_calendar=CALENDAR,
+    )
+    assert result.reason_code == "INACTIVE_SECURITY"
+
+
+def test_security_master_delisting_date_is_terminal():
+    result = evaluate_tradeability(
+        "OLDCO", _frame("OLDCO", FRESH),
+        market_date=MARKET_DATE,
+        master_row=_master("OLDCO", delisting_date="2026-06-30"),
+        session_calendar=CALENDAR,
+    )
+    assert result.reason_code == "DELISTED_SECURITY"
+
+
+def test_regulatory_restriction_is_rejected():
+    result = evaluate_tradeability(
+        "ASMCO", _frame("ASMCO", FRESH),
+        market_date=MARKET_DATE, master_row=_master("ASMCO"),
+        restricted_reason="ASM_STAGE_2", session_calendar=CALENDAR,
+    )
+    assert result.reason_code == "RESTRICTED_SECURITY"
+    assert result.detail == "ASM_STAGE_2"
+
+
+def test_stale_symbol_price_is_rejected_even_with_long_history():
+    """The core defect: 300 old bars used to satisfy every min_sessions check."""
+    stale = _sessions(300, end="2026-07-16")
+    result = evaluate_tradeability(
+        "STALECO", _frame("STALECO", stale),
+        market_date=MARKET_DATE, master_row=_master("STALECO"),
+        session_calendar=tuple(sorted(set(stale) | set(FRESH))),
+    )
+    assert result.reason_code == "STALE_SYMBOL_PRICE"
+    assert result.symbol_last_date == "2026-07-16"
+    assert result.staleness_sessions and result.staleness_sessions > 20
+
+
+def test_staleness_is_counted_in_sessions_not_calendar_days():
+    days = _sessions(60)
+    one_behind = days[:-1]
+    result = evaluate_tradeability(
+        "LAGCO", _frame("LAGCO", one_behind),
+        market_date=MARKET_DATE, master_row=_master("LAGCO"),
+        session_calendar=CALENDAR,
+    )
+    assert result.staleness_sessions == 1
+    assert result.reason_code == "STALE_SYMBOL_PRICE"
+
+    tolerant = evaluate_tradeability(
+        "LAGCO", _frame("LAGCO", one_behind),
+        market_date=MARKET_DATE, master_row=_master("LAGCO"),
+        session_calendar=CALENDAR, max_staleness_sessions=1,
+    )
+    assert tolerant.eligible
+
+
+def test_invalid_latest_row_is_rejected():
+    frame = _frame("BADCO", FRESH)
+    frame.loc[frame.index[-1], "close"] = 0.0
+    result = evaluate_tradeability(
+        "BADCO", frame, market_date=MARKET_DATE,
+        master_row=_master("BADCO"), session_calendar=CALENDAR,
+    )
+    assert result.reason_code == "INVALID_LATEST_ROW"
+
+
+def test_latest_bar_after_market_date_is_rejected():
+    future = FRESH + ["2026-08-21"]
+    result = evaluate_tradeability(
+        "FUTURECO", _frame("FUTURECO", future),
+        market_date=MARKET_DATE, master_row=_master("FUTURECO"),
+        session_calendar=CALENDAR,
+    )
+    assert result.reason_code == "INVALID_LATEST_ROW"
+
+
+def test_every_emitted_reason_code_is_declared():
+    """Guards against a typo'd code leaking into Telegram or diagnostics."""
+    frame = _frame("X", FRESH)
+    cases = [
+        evaluate_tradeability("X", frame, market_date=MARKET_DATE, master_row=None,
+                              session_calendar=CALENDAR),
+        evaluate_tradeability("X", frame, market_date=MARKET_DATE,
+                              master_row=_master("X", series="SM"), session_calendar=CALENDAR),
+        evaluate_tradeability("X", frame, market_date=MARKET_DATE,
+                              master_row=_master("X", active=0), session_calendar=CALENDAR),
+    ]
+    for result in cases:
+        assert result.reason_code in REASON_CODES
+
+
+# --- corporate lifecycle ----------------------------------------------------
+
+JBCHEPHARM_EVENT = LifecycleEvent(
+    symbol="JBCHEPHARM", event_type="AMALGAMATION", status="EFFECTIVE",
+    effective_date="2026-07-08", record_date="2026-07-17",
+    last_trading_date="2026-07-16", successor_symbol="TORNTPHARM",
+    exchange_ratio_from=100.0, exchange_ratio_to=51.0,
+    source="TORRENT_PHARMA_EXCHANGE_FILING", terminal=True,
+)
+
+
+def test_jbchepharm_is_rejected_with_terminal_merger_not_a_side_effect():
+    """The reported reason must be the cause, not the symptom."""
+    stale = _sessions(300, end="2026-07-16")
+    result = evaluate_tradeability(
+        "JBCHEPHARM", _frame("JBCHEPHARM", stale, close=2408.9),
+        market_date=MARKET_DATE,
+        master_row=None,                      # genuinely absent from the master
+        lifecycle_event=JBCHEPHARM_EVENT,
+        session_calendar=tuple(sorted(set(stale) | set(FRESH))),
+    )
+    assert not result.eligible
+    assert result.reason_code == "TERMINAL_MERGER"
+    assert result.stage == "CORPORATE_LIFECYCLE"
+    assert result.successor_symbol == "TORNTPHARM"
+    assert result.conversion_ratio == pytest.approx(0.51)
+    assert result.terminal
+
+
+def test_historical_replay_before_last_trading_date_still_admits_the_symbol():
+    """Prior appearances were valid for their dates and must stay reproducible."""
+    days = _sessions(300, end="2026-07-16")
+    result = evaluate_tradeability(
+        "JBCHEPHARM", _frame("JBCHEPHARM", days, close=2408.9),
+        market_date="2026-07-16",
+        master_row=_master("JBCHEPHARM"),
+        lifecycle_event=JBCHEPHARM_EVENT,
+        session_calendar=tuple(days),
+    )
+    assert result.eligible, result.detail
+    assert result.reason_code == TRADEABLE
+
+
+def test_symbol_becomes_terminal_the_session_after_its_last_trade():
+    assert JBCHEPHARM_EVENT.is_terminal_on("2026-07-16") is False
+    assert JBCHEPHARM_EVENT.is_terminal_on("2026-07-17") is True
+    assert JBCHEPHARM_EVENT.terminal_from == date(2026, 7, 17)
+
+
+def test_effective_date_alone_drives_terminality_when_last_trade_unknown():
+    event = LifecycleEvent(
+        symbol="XCO", event_type="DELISTING", status="EFFECTIVE",
+        effective_date="2026-05-01", terminal=True,
+    )
+    assert event.is_terminal_on("2026-04-30") is False
+    assert event.is_terminal_on("2026-05-01") is True
+    assert event.reason_code == "DELISTED_SECURITY"
+
+
+def test_approved_scheme_stays_visible_but_blocks_new_entries():
+    event = LifecycleEvent(
+        symbol="PENDCO", event_type="AMALGAMATION", status="APPROVED",
+        announcement_date="2026-06-01", effective_date="2026-10-01",
+        successor_symbol="BIGCO", exchange_ratio_from=10.0, exchange_ratio_to=7.0,
+    )
+    result = evaluate_tradeability(
+        "PENDCO", _frame("PENDCO", FRESH), market_date=MARKET_DATE,
+        master_row=_master("PENDCO"), lifecycle_event=event,
+        session_calendar=CALENDAR,
+    )
+    assert result.eligible                    # displayed, not discarded
+    assert result.entry_blocked is True       # but no fresh paper entry
+    assert result.review_reason == "CORPORATE_ACTION_REVIEW"
+    assert result.successor_symbol == "BIGCO"
+
+
+def test_announced_scheme_warns_without_blocking_entry():
+    event = LifecycleEvent(
+        symbol="RUMOURCO", event_type="MERGER", status="ANNOUNCED",
+        announcement_date="2026-08-01",
+    )
+    result = evaluate_tradeability(
+        "RUMOURCO", _frame("RUMOURCO", FRESH), market_date=MARKET_DATE,
+        master_row=_master("RUMOURCO"), lifecycle_event=event,
+        session_calendar=CALENDAR,
+    )
+    assert result.eligible
+    assert result.review_reason == "CORPORATE_ACTION_REVIEW"
+    assert result.entry_blocked is False
+
+
+def test_cancelled_scheme_is_inert():
+    event = LifecycleEvent(
+        symbol="CALLEDOFF", event_type="MERGER", status="CANCELLED",
+        announcement_date="2026-02-01",
+    )
+    result = evaluate_tradeability(
+        "CALLEDOFF", _frame("CALLEDOFF", FRESH), market_date=MARKET_DATE,
+        master_row=_master("CALLEDOFF"), lifecycle_event=event,
+        session_calendar=CALENDAR,
+    )
+    assert result.eligible
+    assert result.review_reason is None
+    assert result.entry_blocked is False
+
+
+def test_corporate_review_can_be_made_terminal_for_strict_callers():
+    event = LifecycleEvent(
+        symbol="PENDCO", event_type="AMALGAMATION", status="APPROVED",
+        announcement_date="2026-06-01", effective_date="2026-10-01",
+    )
+    result = evaluate_tradeability(
+        "PENDCO", _frame("PENDCO", FRESH), market_date=MARKET_DATE,
+        master_row=_master("PENDCO"), lifecycle_event=event,
+        session_calendar=CALENDAR, corporate_review_is_terminal=True,
+    )
+    assert not result.eligible
+    assert result.reason_code == "CORPORATE_ACTION_REVIEW"
+
+
+# --- registry semantics -----------------------------------------------------
+
+def test_registry_prefers_the_terminal_event_over_an_earlier_announcement():
+    registry = LifecycleRegistry([
+        LifecycleEvent("ACO", "AMALGAMATION", "ANNOUNCED", announcement_date="2026-01-01"),
+        LifecycleEvent("ACO", "AMALGAMATION", "EFFECTIVE", effective_date="2026-06-01",
+                       last_trading_date="2026-06-10", successor_symbol="BCO",
+                       exchange_ratio_from=2.0, exchange_ratio_to=1.0, terminal=True),
+    ])
+    chosen = registry.event_for("ACO", MARKET_DATE)
+    assert chosen is not None and chosen.status == "EFFECTIVE"
+    assert registry.terminal_symbols(MARKET_DATE) == frozenset({"ACO"})
+    assert registry.successor_map(MARKET_DATE)["ACO"] == ("BCO", 0.5)
+    # ...but not yet, on an earlier market date
+    assert registry.terminal_symbols("2026-06-10") == frozenset()
+
+
+def test_registry_lookup_is_case_insensitive():
+    registry = LifecycleRegistry([JBCHEPHARM_EVENT])
+    assert registry.event_for("jbchepharm", MARKET_DATE) is not None
+
+
+def test_event_from_mapping_rejects_unknown_vocabulary():
+    with pytest.raises(ValueError):
+        event_from_mapping({"symbol": "X", "event_type": "GUESSING", "status": "EFFECTIVE"})
+    with pytest.raises(ValueError):
+        event_from_mapping({"symbol": "X", "event_type": "MERGER", "status": "MAYBE"})
+    with pytest.raises(ValueError):
+        event_from_mapping({"symbol": "", "event_type": "MERGER", "status": "EFFECTIVE"})
+
+
+def test_effective_status_implies_terminal_even_if_the_column_says_zero():
+    event = event_from_mapping({
+        "symbol": "jbchepharm", "event_type": "AMALGAMATION", "status": "EFFECTIVE",
+        "last_trading_date": "2026-07-16", "successor_symbol": "torntpharm",
+        "terminal": "0",
+    })
+    assert event.terminal is True
+    assert event.symbol == "JBCHEPHARM"
+    assert event.successor_symbol == "TORNTPHARM"
+
+
+# --- shipped snapshot -------------------------------------------------------
+
+def test_shipped_snapshot_contains_the_jbchepharm_record():
+    events = read_snapshot(Path("corporate_data/normalized/security_lifecycle_events.csv"))
+    by_symbol = {event.symbol: event for event in events}
+    assert "JBCHEPHARM" in by_symbol, "the seeded merger record is missing"
+    event = by_symbol["JBCHEPHARM"]
+    assert event.event_type == "AMALGAMATION"
+    assert event.status == "EFFECTIVE"
+    assert event.effective_date == "2026-07-08"
+    assert event.record_date == "2026-07-17"
+    assert event.last_trading_date == "2026-07-16"
+    assert event.successor_symbol == "TORNTPHARM"
+    assert (event.exchange_ratio_from, event.exchange_ratio_to) == (100.0, 51.0)
+    assert event.conversion_ratio == pytest.approx(0.51)
+    assert event.is_terminal_on("2026-08-21")
+
+
+# --- universe-level behaviour ----------------------------------------------
+
+def _universe() -> pd.DataFrame:
+    stale = _sessions(300, end="2026-07-16")
+    return pd.concat([
+        _frame("RELIANCE", FRESH, 1400.0),
+        _frame("TORNTPHARM", FRESH, 3800.0),
+        _frame("JBCHEPHARM", stale, 2408.9),
+        _frame("STALECO", stale, 90.0),
+    ], ignore_index=True)
+
+
+def test_universe_evaluation_separates_causes_and_counts_them():
+    prices = _universe()
+    verdict = evaluate_universe(
+        prices,
+        master={s: _master(s) for s in ("RELIANCE", "TORNTPHARM", "STALECO")},
+        lifecycle=[JBCHEPHARM_EVENT],
+    )
+    assert verdict.market_date == MARKET_DATE
+    assert verdict.eligible_symbols == ("RELIANCE", "TORNTPHARM")
+    assert verdict.results["JBCHEPHARM"].reason_code == "TERMINAL_MERGER"
+    assert verdict.results["STALECO"].reason_code == "STALE_SYMBOL_PRICE"
+    assert verdict.rejection_counts() == {"STALE_SYMBOL_PRICE": 1, "TERMINAL_MERGER": 1}
+
+    filtered = verdict.filter_frame(prices)
+    assert set(filtered["symbol"]) == {"RELIANCE", "TORNTPHARM"}
+    diagnostics = verdict.diagnostics()
+    assert diagnostics["terminal_symbols"] == ["JBCHEPHARM"]
+    assert diagnostics["eligible"] == 2
+
+
+def test_market_date_comes_from_the_universe_not_from_today():
+    prices = _universe()
+    assert market_date_from_prices(prices) == MARKET_DATE
+    assert session_calendar_from_prices(prices)[-1] == MARKET_DATE
+
+
+def test_named_symbol_absent_from_prices_still_gets_a_verdict():
+    verdict = evaluate_universe(
+        _universe(), master={"RELIANCE": _master("RELIANCE")},
+        symbols=["RELIANCE", "NEVERTRADED"],
+    )
+    assert verdict.results["NEVERTRADED"].eligible is False
+    assert set(verdict.results) == {"RELIANCE", "NEVERTRADED"}
+
+
+# --- database round trip ----------------------------------------------------
+
+def _database(tmp_path: Path) -> Path:
+    path = tmp_path / "nse_scanner.db"
+    with sqlite3.connect(path) as conn:
+        conn.execute("""CREATE TABLE daily_prices_v2 (
+            symbol TEXT, trade_date TEXT, open REAL, high REAL, low REAL,
+            close REAL, volume REAL, PRIMARY KEY(symbol, trade_date))""")
+        conn.execute("""CREATE TABLE symbol_master_v2 (
+            symbol TEXT PRIMARY KEY, isin TEXT, company_name TEXT, series TEXT,
+            sector TEXT, industry TEXT, listing_date TEXT, delisting_date TEXT,
+            active INTEGER NOT NULL DEFAULT 1,
+            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)""")
+        prices = _universe()
+        conn.executemany(
+            "INSERT INTO daily_prices_v2 VALUES (?,?,?,?,?,?,?)",
+            [tuple(row) for row in prices[
+                ["symbol", "trade_date", "open", "high", "low", "close", "volume"]
+            ].itertuples(index=False)],
+        )
+        conn.executemany(
+            "INSERT INTO symbol_master_v2 (symbol, series, active) VALUES (?,?,?)",
+            [("RELIANCE", "EQ", 1), ("TORNTPHARM", "EQ", 1), ("STALECO", "EQ", 1)],
+        )
+    V2Database(path).ensure_v3_schema()
+    return path
+
+
+def test_lifecycle_events_survive_a_sqlite_round_trip(tmp_path):
+    path = _database(tmp_path)
+    with sqlite3.connect(path) as conn:
+        assert upsert_events(conn, [JBCHEPHARM_EVENT]) == 1
+        upsert_events(conn, [JBCHEPHARM_EVENT])          # idempotent
+        stored = load_events(conn)
+        assert len(stored) == 1
+        assert stored[0] == JBCHEPHARM_EVENT
+        assert load_registry(conn).terminal_symbols(MARKET_DATE) == frozenset({"JBCHEPHARM"})
+
+
+def test_ensure_v3_schema_creates_the_lifecycle_and_audit_tables(tmp_path):
+    path = _database(tmp_path)
+    with sqlite3.connect(path) as conn:
+        names = {row[0] for row in conn.execute(
+            "SELECT name FROM sqlite_master WHERE type='table'")}
+    assert {"security_lifecycle_events", "tradeability_audit_v3"} <= names
+
+
+def test_symbol_master_now_exposes_delisting_date(tmp_path):
+    path = _database(tmp_path)
+    master = V2Database(path).load_symbol_master(MARKET_DATE)
+    assert "delisting_date" in master.columns
+
+
+def test_gateway_from_database_seeds_the_registry_and_blocks_jbchepharm(tmp_path, monkeypatch):
+    """A runner that restored only price data must still catch the merger."""
+    path = _database(tmp_path)
+    monkeypatch.chdir(Path(__file__).resolve().parents[1])   # repo root, for the CSV
+    prices = V2Database(path).load_prices(end_date=MARKET_DATE)
+    verdict = gateway_from_database(path, prices)
+    assert verdict.results["JBCHEPHARM"].reason_code == "TERMINAL_MERGER"
+    assert verdict.results["JBCHEPHARM"].successor_symbol == "TORNTPHARM"
+    assert "RELIANCE" in verdict.eligible_symbols
+
+    with sqlite3.connect(path) as conn:
+        assert conn.execute(
+            "SELECT COUNT(*) FROM security_lifecycle_events WHERE symbol='JBCHEPHARM'"
+        ).fetchone()[0] == 1
+
+
+def test_tradeability_audit_is_persisted(tmp_path):
+    path = _database(tmp_path)
+    database = V2Database(path)
+    prices = database.load_prices(end_date=MARKET_DATE)
+    verdict = evaluate_universe(
+        prices, master=database.load_symbol_master(MARKET_DATE),
+        lifecycle=[JBCHEPHARM_EVENT],
+    )
+    database.save_tradeability_audit(verdict.market_date, verdict.results)
+    with sqlite3.connect(path) as conn:
+        rows = dict(conn.execute(
+            "SELECT symbol, reason_code FROM tradeability_audit_v3 WHERE market_date=?",
+            (MARKET_DATE,)).fetchall())
+    assert rows["JBCHEPHARM"] == "TERMINAL_MERGER"
+    assert rows["RELIANCE"] == TRADEABLE
+
+
+def test_price_history_is_never_deleted_by_the_gateway(tmp_path):
+    """Historical bars and replay records must survive terminal marking."""
+    path = _database(tmp_path)
+    database = V2Database(path)
+    prices = database.load_prices(end_date=MARKET_DATE)
+    before = len(prices[prices["symbol"] == "JBCHEPHARM"])
+    verdict = evaluate_universe(prices, master=database.load_symbol_master(MARKET_DATE),
+                               lifecycle=[JBCHEPHARM_EVENT])
+    database.save_tradeability_audit(verdict.market_date, verdict.results)
+    after = len(database.load_prices(end_date=MARKET_DATE).query("symbol == 'JBCHEPHARM'"))
+    assert after == before > 0
