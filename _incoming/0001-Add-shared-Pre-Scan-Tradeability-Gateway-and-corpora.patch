@@ -0,0 +1,444 @@
+"""Authoritative corporate-lifecycle registry for the NSE scanner family.
+
+This module is the single source of truth for terminal corporate events —
+amalgamations, mergers, demergers, delistings and suspensions — that must remove
+a symbol from *current* scanning while leaving its price history and historical
+signals completely untouched.
+
+Design rules
+------------
+1.  A record is dated. ``terminal_from`` is derived, never guessed, so that a
+    historical replay of 2026-07-10 still sees ``JBCHEPHARM`` as tradeable while
+    a live scan on 2026-08-21 does not.
+2.  Non-terminal statuses (``ANNOUNCED``, ``APPROVED``) never delete a symbol.
+    They downgrade it to a review state so the scanner can display a warning and
+    withhold new READY entries.
+3.  Successor symbols and exchange ratios live here, so paper-portfolio
+    conversion is a lookup rather than a manual intervention.
+4.  The table is additive. Nothing in this module ever deletes price history.
+"""
+from __future__ import annotations
+
+import csv
+import sqlite3
+from dataclasses import asdict, dataclass
+from datetime import date, timedelta
+from pathlib import Path
+from typing import Iterable, Mapping, Sequence
+
+TABLE_NAME = "security_lifecycle_events"
+
+SNAPSHOT_PATH = Path("corporate_data/normalized/security_lifecycle_events.csv")
+
+SCHEMA_SQL = f"""
+CREATE TABLE IF NOT EXISTS {TABLE_NAME} (
+    symbol              TEXT NOT NULL,
+    event_type          TEXT NOT NULL,
+    status              TEXT NOT NULL,
+    announcement_date   TEXT,
+    effective_date      TEXT,
+    record_date         TEXT,
+    last_trading_date   TEXT,
+    successor_symbol    TEXT,
+    exchange_ratio_from REAL,
+    exchange_ratio_to   REAL,
+    source              TEXT NOT NULL DEFAULT 'MANUAL',
+    terminal            INTEGER NOT NULL DEFAULT 0 CHECK(terminal IN (0, 1)),
+    notes               TEXT,
+    loaded_at           TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    PRIMARY KEY(symbol, event_type, status)
+);
+CREATE INDEX IF NOT EXISTS idx_security_lifecycle_symbol
+    ON {TABLE_NAME}(symbol);
+CREATE INDEX IF NOT EXISTS idx_security_lifecycle_terminal
+    ON {TABLE_NAME}(terminal, effective_date);
+"""
+
+FIELDS: tuple[str, ...] = (
+    "symbol",
+    "event_type",
+    "status",
+    "announcement_date",
+    "effective_date",
+    "record_date",
+    "last_trading_date",
+    "successor_symbol",
+    "exchange_ratio_from",
+    "exchange_ratio_to",
+    "source",
+    "terminal",
+    "notes",
+)
+
+# Event vocabulary -----------------------------------------------------------
+AMALGAMATION = "AMALGAMATION"
+MERGER = "MERGER"
+DEMERGER = "DEMERGER"
+DELISTING = "DELISTING"
+SUSPENSION = "SUSPENSION"
+SYMBOL_CHANGE = "SYMBOL_CHANGE"
+
+EVENT_TYPES = frozenset({
+    AMALGAMATION, MERGER, DEMERGER, DELISTING, SUSPENSION, SYMBOL_CHANGE,
+})
+
+ANNOUNCED = "ANNOUNCED"
+APPROVED = "APPROVED"
+EFFECTIVE = "EFFECTIVE"
+TERMINAL = "TERMINAL"
+CANCELLED = "CANCELLED"
+
+STATUSES = frozenset({ANNOUNCED, APPROVED, EFFECTIVE, TERMINAL, CANCELLED})
+
+#: Statuses at which the security has actually stopped being itself.
+TERMINAL_STATUSES = frozenset({EFFECTIVE, TERMINAL})
+
+#: Reason code emitted by the tradeability gateway per event type.
+_REASON_BY_EVENT = {
+    AMALGAMATION: "TERMINAL_MERGER",
+    MERGER: "TERMINAL_MERGER",
+    DEMERGER: "TERMINAL_MERGER",
+    SYMBOL_CHANGE: "TERMINAL_MERGER",
+    DELISTING: "DELISTED_SECURITY",
+    SUSPENSION: "SUSPENDED_SECURITY",
+}
+
+
+def _as_date(value: object) -> date | None:
+    """Parse an ISO date defensively; unparseable values become ``None``."""
+    if value is None:
+        return None
+    if isinstance(value, date):
+        return value
+    text = str(value).strip()
+    if not text or text.lower() in {"nan", "none", "null", "nat"}:
+        return None
+    try:
+        return date.fromisoformat(text[:10])
+    except ValueError:
+        return None
+
+
+def _as_float(value: object) -> float | None:
+    if value is None:
+        return None
+    text = str(value).strip()
+    if not text or text.lower() in {"nan", "none", "null"}:
+        return None
+    try:
+        return float(text)
+    except ValueError:
+        return None
+
+
+def _as_bool(value: object) -> bool:
+    if isinstance(value, bool):
+        return value
+    text = str(value).strip().lower()
+    return text in {"1", "true", "yes", "y", "t"}
+
+
+@dataclass(frozen=True)
+class LifecycleEvent:
+    """One dated corporate-lifecycle fact about one symbol."""
+
+    symbol: str
+    event_type: str
+    status: str
+    announcement_date: str | None = None
+    effective_date: str | None = None
+    record_date: str | None = None
+    last_trading_date: str | None = None
+    successor_symbol: str | None = None
+    exchange_ratio_from: float | None = None
+    exchange_ratio_to: float | None = None
+    source: str = "MANUAL"
+    terminal: bool = False
+    notes: str | None = None
+
+    # -- derived ---------------------------------------------------------
+    @property
+    def terminal_from(self) -> date | None:
+        """First market date on which the symbol must leave the live universe.
+
+        The last trading date is authoritative when known: a scheme can become
+        legally effective while the share still trades until the record date, as
+        happened with ``JBCHEPHARM`` (effective 2026-07-08, last traded
+        2026-07-16).  Using ``last_trading_date + 1`` keeps every historical bar
+        valid for the date it was observed.
+        """
+        if not (self.terminal or self.status in TERMINAL_STATUSES):
+            return None
+        last_traded = _as_date(self.last_trading_date)
+        if last_traded is not None:
+            return last_traded + timedelta(days=1)
+        return _as_date(self.effective_date)
+
+    @property
+    def reason_code(self) -> str:
+        return _REASON_BY_EVENT.get(self.event_type.upper(), "CORPORATE_ACTION_REVIEW")
+
+    @property
+    def conversion_ratio(self) -> float | None:
+        """Successor shares received per held share, e.g. 100 -> 51 gives 0.51."""
+        source = _as_float(self.exchange_ratio_from)
+        target = _as_float(self.exchange_ratio_to)
+        if not source or target is None:
+            return None
+        return target / source
+
+    def is_terminal_on(self, market_date: date | str) -> bool:
+        """True when this event has already removed the symbol by ``market_date``."""
+        boundary = self.terminal_from
+        if boundary is None:
+            return False
+        day = _as_date(market_date)
+        return day is not None and day >= boundary
+
+    def blocks_new_entries_on(self, market_date: date | str) -> bool:
+        """True when the event is credible enough to withhold a fresh entry.
+
+        ``ANNOUNCED`` is displayed but does not block; ``APPROVED`` blocks new
+        READY entries because the scheme is materially certain.
+        """
+        if self.is_terminal_on(market_date):
+            return True
+        if self.status != APPROVED:
+            return False
+        day = _as_date(market_date)
+        if day is None:
+            return False
+        announced = _as_date(self.announcement_date)
+        return announced is None or day >= announced
+
+    def is_active_review_on(self, market_date: date | str) -> bool:
+        """True when the symbol should carry a visible corporate-event warning."""
+        if self.status == CANCELLED or self.is_terminal_on(market_date):
+            return False
+        day = _as_date(market_date)
+        if day is None:
+            return False
+        announced = _as_date(self.announcement_date)
+        return announced is None or day >= announced
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+    def to_row(self) -> tuple:
+        return (
+            self.symbol,
+            self.event_type,
+            self.status,
+            self.announcement_date,
+            self.effective_date,
+            self.record_date,
+            self.last_trading_date,
+            self.successor_symbol,
+            self.exchange_ratio_from,
+            self.exchange_ratio_to,
+            self.source,
+            1 if self.terminal else 0,
+            self.notes,
+        )
+
+    def describe(self) -> str:
+        """Operator-facing one-line diagnostic."""
+        parts = [f"{self.symbol} {self.event_type}/{self.status}"]
+        if self.effective_date:
+            parts.append(f"effective {self.effective_date}")
+        if self.last_trading_date:
+            parts.append(f"last traded {self.last_trading_date}")
+        if self.successor_symbol:
+            ratio = self.conversion_ratio
+            suffix = f" ({self.exchange_ratio_from:g}->{self.exchange_ratio_to:g})" if ratio else ""
+            parts.append(f"successor {self.successor_symbol}{suffix}")
+        return " | ".join(parts)
+
+
+def event_from_mapping(row: Mapping[str, object]) -> LifecycleEvent:
+    """Build an event from a CSV row, sqlite3.Row or plain dict."""
+    symbol = str(row.get("symbol", "") or "").strip().upper()
+    if not symbol:
+        raise ValueError("lifecycle event requires a symbol")
+    event_type = str(row.get("event_type", "") or "").strip().upper()
+    if event_type not in EVENT_TYPES:
+        raise ValueError(f"unknown lifecycle event_type {event_type!r} for {symbol}")
+    status = str(row.get("status", "") or "").strip().upper()
+    if status not in STATUSES:
+        raise ValueError(f"unknown lifecycle status {status!r} for {symbol}")
+
+    def text(key: str) -> str | None:
+        value = row.get(key)
+        if value is None:
+            return None
+        cleaned = str(value).strip()
+        return cleaned or None if cleaned.lower() not in {"nan", "none", "null", "nat"} else None
+
+    declared_terminal = _as_bool(row.get("terminal", 0))
+    successor = text("successor_symbol")
+    return LifecycleEvent(
+        symbol=symbol,
+        event_type=event_type,
+        status=status,
+        announcement_date=text("announcement_date"),
+        effective_date=text("effective_date"),
+        record_date=text("record_date"),
+        last_trading_date=text("last_trading_date"),
+        successor_symbol=successor.upper() if successor else None,
+        exchange_ratio_from=_as_float(row.get("exchange_ratio_from")),
+        exchange_ratio_to=_as_float(row.get("exchange_ratio_to")),
+        source=text("source") or "MANUAL",
+        terminal=declared_terminal or status in TERMINAL_STATUSES,
+        notes=text("notes"),
+    )
+
+
+class LifecycleRegistry:
+    """Read-side view of the lifecycle table, resolved for one market date."""
+
+    def __init__(self, events: Iterable[LifecycleEvent]) -> None:
+        self._by_symbol: dict[str, list[LifecycleEvent]] = {}
+        for event in events:
+            self._by_symbol.setdefault(event.symbol, []).append(event)
+        for records in self._by_symbol.values():
+            # Most decisive status first, so ``event_for`` short-circuits well.
+            records.sort(key=lambda item: (
+                0 if item.status in TERMINAL_STATUSES else 1,
+                item.effective_date or "9999-12-31",
+            ))
+
+    def __len__(self) -> int:
+        return sum(len(records) for records in self._by_symbol.values())
+
+    @property
+    def symbols(self) -> frozenset[str]:
+        return frozenset(self._by_symbol)
+
+    def events_for(self, symbol: str) -> tuple[LifecycleEvent, ...]:
+        return tuple(self._by_symbol.get(str(symbol).upper(), ()))
+
+    def event_for(self, symbol: str, market_date: date | str) -> LifecycleEvent | None:
+        """Return the most decisive event that is relevant on ``market_date``."""
+        candidates = self.events_for(symbol)
+        if not candidates:
+            return None
+        for event in candidates:
+            if event.is_terminal_on(market_date):
+                return event
+        for event in candidates:
+            if event.blocks_new_entries_on(market_date):
+                return event
+        for event in candidates:
+            if event.is_active_review_on(market_date):
+                return event
+        return None
+
+    def terminal_symbols(self, market_date: date | str) -> frozenset[str]:
+        return frozenset(
+            symbol
+            for symbol, records in self._by_symbol.items()
+            if any(event.is_terminal_on(market_date) for event in records)
+        )
+
+    def successor_map(self, market_date: date | str) -> dict[str, tuple[str, float | None]]:
+        """``{old_symbol: (successor_symbol, shares_per_share)}`` for conversions."""
+        mapping: dict[str, tuple[str, float | None]] = {}
+        for symbol, records in self._by_symbol.items():
+            for event in records:
+                if event.is_terminal_on(market_date) and event.successor_symbol:
+                    mapping[symbol] = (event.successor_symbol, event.conversion_ratio)
+                    break
+        return mapping
+
+    def diagnostics(self, market_date: date | str) -> dict[str, object]:
+        terminal = self.terminal_symbols(market_date)
+        review = {
+            symbol
+            for symbol, records in self._by_symbol.items()
+            if symbol not in terminal
+            and any(event.is_active_review_on(market_date) for event in records)
+        }
+        return {
+            "market_date": str(market_date),
+            "events": len(self),
+            "symbols": len(self._by_symbol),
+            "terminal_symbols": sorted(terminal),
+            "review_symbols": sorted(review),
+        }
+
+
+# --- persistence -----------------------------------------------------------
+
+def ensure_schema(conn: sqlite3.Connection) -> None:
+    conn.executescript(SCHEMA_SQL)
+
+
+def upsert_events(conn: sqlite3.Connection, events: Sequence[LifecycleEvent]) -> int:
+    if not events:
+        return 0
+    ensure_schema(conn)
+    placeholders = ",".join("?" for _ in FIELDS)
+    conn.executemany(
+        f"INSERT OR REPLACE INTO {TABLE_NAME} ({','.join(FIELDS)}) VALUES ({placeholders})",
+        [event.to_row() for event in events],
+    )
+    return len(events)
+
+
+def load_events(conn: sqlite3.Connection) -> list[LifecycleEvent]:
+    names = {row[0] for row in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+    if TABLE_NAME not in names:
+        return []
+    previous_factory = conn.row_factory
+    conn.row_factory = sqlite3.Row
+    try:
+        rows = conn.execute(f"SELECT {','.join(FIELDS)} FROM {TABLE_NAME}").fetchall()
+    finally:
+        conn.row_factory = previous_factory
+    events: list[LifecycleEvent] = []
+    for row in rows:
+        try:
+            events.append(event_from_mapping({key: row[key] for key in FIELDS}))
+        except ValueError:
+            # A malformed stored row must never abort a scan; it is skipped and
+            # surfaced by the caller's diagnostics instead.
+            continue
+    return events
+
+
+def load_registry(conn: sqlite3.Connection) -> LifecycleRegistry:
+    return LifecycleRegistry(load_events(conn))
+
+
+def read_snapshot(path: str | Path = SNAPSHOT_PATH) -> list[LifecycleEvent]:
+    """Read the git-backed CSV snapshot used to seed disposable CI runners."""
+    target = Path(path)
+    if not target.exists():
+        return []
+    with target.open(newline="", encoding="utf-8") as handle:
+        rows = list(csv.DictReader(handle))
+    events: list[LifecycleEvent] = []
+    for row in rows:
+        try:
+            events.append(event_from_mapping(row))
+        except ValueError:
+            continue
+    return events
+
+
+def write_snapshot(events: Sequence[LifecycleEvent], path: str | Path = SNAPSHOT_PATH) -> int:
+    target = Path(path)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with target.open("w", newline="", encoding="utf-8") as handle:
+        writer = csv.DictWriter(handle, fieldnames=FIELDS, lineterminator="\n")
+        writer.writeheader()
+        for event in events:
+            record = event.to_dict()
+            record["terminal"] = 1 if event.terminal else 0
+            writer.writerow({key: "" if record[key] is None else record[key] for key in FIELDS})
+    return len(events)
+
+
+def restore_snapshot(conn: sqlite3.Connection, path: str | Path = SNAPSHOT_PATH) -> int:
+    """Load the CSV snapshot into sqlite. Safe to call on every run."""
+    return upsert_events(conn, read_snapshot(path))
