@@ -0,0 +1,508 @@
+"""Pre-Scan Tradeability Gateway shared by every NSE scanner.
+
+The gateway answers exactly one question: *may this symbol be evaluated as a
+current candidate on this market date?*  It deliberately knows nothing about
+momentum, Hull averages, horizons or scoring, so V3, the Momentum Ladder, Hull
+Pine and the Penny Shadow scanner can each keep their own independent strategy
+logic while sharing one auditable admission decision.
+
+    Official NSE universe ─┐
+    Latest OHLCV date ─────┤──> Tradeability gateway ──> V3 / Ladder / Hull / Penny
+    Corporate lifecycle ───┘
+
+Why this exists
+---------------
+``JBCHEPHARM`` was amalgamated into ``TORNTPHARM`` effective 2026-07-08 and last
+traded on 2026-07-16, yet it kept appearing in scanner output a month later.  It
+slipped through every existing control because the old checks *fail open*: it
+has no ``symbol_master_v2`` row at all, so the series check defaulted to ``EQ``
+and the ``active`` check was skipped; it has no ``corporate_actions_v3`` row, so
+the +/-5/+14-day ex-date window found nothing; and its ~380 stale bars satisfied
+every ``min_sessions`` count.  This module fails *closed* instead, and it is not
+specific to one ticker: on 2026-08-20 there were 57 symbols with history but no
+recent bar.
+
+Historical integrity
+--------------------
+Nothing here deletes or rewrites history.  The gateway is evaluated per market
+date, so replaying 2026-07-10 still admits ``JBCHEPHARM`` exactly as it was
+legitimately admitted at the time.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field
+from datetime import date
+from pathlib import Path
+from typing import Iterable, Mapping, Sequence
+
+import pandas as pd
+
+from .security_lifecycle import LifecycleEvent, LifecycleRegistry
+
+# --- vocabulary -------------------------------------------------------------
+
+TRADEABLE = "TRADEABLE"
+
+#: Every rejection reason the gateway can emit.  Downstream Telegram and
+#: diagnostics code should switch on these and nothing else.
+REASON_CODES: tuple[str, ...] = (
+    "INACTIVE_SECURITY",
+    "NOT_IN_CURRENT_NSE_UNIVERSE",
+    "STALE_SYMBOL_PRICE",
+    "TERMINAL_MERGER",
+    "DELISTED_SECURITY",
+    "SUSPENDED_SECURITY",
+    "NON_EQ_SERIES",
+    "RESTRICTED_SECURITY",
+    "CORPORATE_ACTION_REVIEW",
+    "INVALID_LATEST_ROW",
+)
+
+STAGE_CORPORATE_LIFECYCLE = "CORPORATE_LIFECYCLE"
+STAGE_UNIVERSE = "UNIVERSE"
+STAGE_TRADEABILITY = "TRADEABILITY"
+STAGE_REGULATORY = "REGULATORY"
+STAGE_FRESHNESS = "FRESHNESS"
+STAGE_DATA_QUALITY = "DATA_QUALITY"
+
+_OHLC_COLUMNS = ("open", "high", "low", "close")
+
+_FALSE_TOKENS = frozenset({"0", "0.0", "false", "f", "no", "n", ""})
+
+
+def _flag_is_false(value: object) -> bool:
+    """Interpret a security-master boolean stored as int, float, str or bool.
+
+    CSV round-trips turn ``active=0`` into ``"0"`` and sometimes ``"0.0"``, both
+    of which are truthy strings in Python.  This normalises them.
+    """
+    if isinstance(value, bool):
+        return not value
+    if isinstance(value, (int, float)):
+        return float(value) == 0.0
+    return str(value).strip().lower() in _FALSE_TOKENS
+
+
+@dataclass(frozen=True)
+class TradeabilityResult:
+    """Per-symbol admission verdict for one market date."""
+
+    symbol: str
+    eligible: bool
+    reason_code: str
+    stage: str
+    market_date: str
+    symbol_last_date: str | None = None
+    staleness_sessions: int | None = None
+    #: Symbol may be evaluated and displayed, but must not receive a new entry.
+    entry_blocked: bool = False
+    #: Non-blocking corporate-event warning to surface on the card.
+    review_reason: str | None = None
+    successor_symbol: str | None = None
+    conversion_ratio: float | None = None
+    detail: str | None = None
+
+    @property
+    def terminal(self) -> bool:
+        return self.reason_code in {
+            "TERMINAL_MERGER", "DELISTED_SECURITY", "SUSPENDED_SECURITY",
+        }
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+    def describe(self) -> str:
+        """Operator-facing block used in diagnostics and Telegram notices."""
+        lines = [
+            self.symbol,
+            f"Eligible: {'Yes' if self.eligible else 'No'}",
+            f"Stage: {self.stage}",
+            f"Reason: {self.reason_code}",
+        ]
+        if self.detail:
+            lines.append(self.detail)
+        if self.symbol_last_date:
+            lines.append(f"Last traded: {self.symbol_last_date}")
+        if self.successor_symbol:
+            lines.append(f"Successor: {self.successor_symbol}")
+        return "\n".join(lines)
+
+
+@dataclass(frozen=True)
+class UniverseVerdict:
+    """Aggregate gateway outcome for a whole scan."""
+
+    market_date: str
+    results: dict[str, TradeabilityResult] = field(default_factory=dict)
+
+    @property
+    def eligible_symbols(self) -> tuple[str, ...]:
+        return tuple(sorted(s for s, r in self.results.items() if r.eligible))
+
+    @property
+    def entry_permitted_symbols(self) -> tuple[str, ...]:
+        return tuple(sorted(
+            s for s, r in self.results.items() if r.eligible and not r.entry_blocked
+        ))
+
+    @property
+    def rejected(self) -> dict[str, TradeabilityResult]:
+        return {s: r for s, r in self.results.items() if not r.eligible}
+
+    def rejection_counts(self) -> dict[str, int]:
+        counts: dict[str, int] = {}
+        for result in self.results.values():
+            if not result.eligible:
+                counts[result.reason_code] = counts.get(result.reason_code, 0) + 1
+        return dict(sorted(counts.items(), key=lambda item: (-item[1], item[0])))
+
+    def is_eligible(self, symbol: str) -> bool:
+        result = self.results.get(str(symbol))
+        return bool(result and result.eligible)
+
+    def entry_permitted(self, symbol: str) -> bool:
+        result = self.results.get(str(symbol))
+        return bool(result and result.eligible and not result.entry_blocked)
+
+    def filter_frame(self, prices: pd.DataFrame, symbol_column: str = "symbol") -> pd.DataFrame:
+        """Drop every non-admitted symbol from a price/candidate frame."""
+        if prices.empty:
+            return prices
+        keep = set(self.eligible_symbols)
+        return prices[prices[symbol_column].astype(str).isin(keep)].copy()
+
+    def diagnostics(self) -> dict[str, object]:
+        return {
+            "market_date": self.market_date,
+            "evaluated": len(self.results),
+            "eligible": len(self.eligible_symbols),
+            "entry_permitted": len(self.entry_permitted_symbols),
+            "rejected": len(self.results) - len(self.eligible_symbols),
+            "rejection_counts": self.rejection_counts(),
+            "terminal_symbols": sorted(
+                s for s, r in self.results.items() if r.terminal
+            ),
+            "review_symbols": sorted(
+                s for s, r in self.results.items() if r.review_reason
+            ),
+        }
+
+
+def _iso(value: object) -> str | None:
+    if value is None:
+        return None
+    try:
+        stamp = pd.Timestamp(value)
+    except (ValueError, TypeError):
+        return None
+    if pd.isna(stamp):
+        return None
+    return stamp.date().isoformat()
+
+
+def _staleness_sessions(
+    symbol_last_date: str,
+    market_date: str,
+    session_calendar: Sequence[str] | None,
+) -> int:
+    """Sessions the symbol is behind the market.
+
+    A session calendar (the sorted distinct trade dates present in the universe)
+    is used when available, because calendar days over-count weekends and
+    holidays.  Without one, fall back to calendar days.
+    """
+    if session_calendar:
+        after = [day for day in session_calendar if symbol_last_date < day <= market_date]
+        return len(after)
+    return max(0, (pd.Timestamp(market_date) - pd.Timestamp(symbol_last_date)).days)
+
+
+def session_calendar_from_prices(prices: pd.DataFrame) -> tuple[str, ...]:
+    """Sorted distinct trade dates present in a universe price frame."""
+    if prices.empty or "trade_date" not in prices.columns:
+        return ()
+    days = pd.to_datetime(prices["trade_date"], errors="coerce").dropna()
+    return tuple(sorted({stamp.date().isoformat() for stamp in days}))
+
+
+def market_date_from_prices(prices: pd.DataFrame) -> str | None:
+    """The scanner's market date: the newest completed session in the universe."""
+    if prices.empty or "trade_date" not in prices.columns:
+        return None
+    return _iso(pd.to_datetime(prices["trade_date"], errors="coerce").max())
+
+
+def evaluate_tradeability(
+    symbol: str,
+    frame: pd.DataFrame,
+    *,
+    market_date: date | str,
+    master_row: Mapping[str, object] | None = None,
+    lifecycle_event: LifecycleEvent | None = None,
+    restricted_reason: str | None = None,
+    session_calendar: Sequence[str] | None = None,
+    max_staleness_sessions: int = 0,
+    require_universe_membership: bool = True,
+    require_series_eq: bool = True,
+    corporate_review_is_terminal: bool = False,
+) -> TradeabilityResult:
+    """Decide whether ``symbol`` may be evaluated as a current candidate.
+
+    Parameters
+    ----------
+    frame
+        The symbol's own price history, any order; must contain ``trade_date``.
+    market_date
+        The scanner's market date — the newest completed session across the
+        whole universe, *not* ``date.today()``.  Use
+        :func:`market_date_from_prices`.
+    master_row
+        The symbol's row from the current official NSE security master.
+        ``None`` means "not in the current universe" and, with
+        ``require_universe_membership``, is a rejection rather than a pass.
+    max_staleness_sessions
+        ``0`` demands the symbol traded in the market date's own session.  Raise
+        it only for deliberately tolerant research modes.
+    """
+    symbol = str(symbol)
+    market_iso = _iso(market_date) or str(market_date)
+
+    def reject(stage: str, code: str, *, detail: str | None = None, **extra) -> TradeabilityResult:
+        return TradeabilityResult(
+            symbol=symbol, eligible=False, reason_code=code, stage=stage,
+            market_date=market_iso, detail=detail, **extra,
+        )
+
+    # 1. Terminal corporate lifecycle is the most specific explanation, so it is
+    #    tested first: a merged symbol should report TERMINAL_MERGER, not the
+    #    incidental STALE_SYMBOL_PRICE or NOT_IN_CURRENT_NSE_UNIVERSE that also
+    #    happen to be true.
+    if lifecycle_event is not None and lifecycle_event.is_terminal_on(market_iso):
+        return reject(
+            STAGE_CORPORATE_LIFECYCLE,
+            lifecycle_event.reason_code,
+            detail=lifecycle_event.describe(),
+            symbol_last_date=lifecycle_event.last_trading_date,
+            successor_symbol=lifecycle_event.successor_symbol,
+            conversion_ratio=lifecycle_event.conversion_ratio,
+        )
+
+    # 2. Current official NSE security-master membership.
+    if master_row is None:
+        if require_universe_membership:
+            return reject(
+                STAGE_UNIVERSE, "NOT_IN_CURRENT_NSE_UNIVERSE",
+                detail="Symbol absent from the current NSE security master",
+            )
+        master_row = {}
+
+    # 3. Series and active flag — fail closed when the field is absent.
+    series_value = master_row.get("series")
+    series = str(series_value).strip().upper() if series_value is not None else ""
+    if require_series_eq and series != "EQ":
+        return reject(
+            STAGE_TRADEABILITY, "NON_EQ_SERIES",
+            detail=f"series={series or 'UNKNOWN'} required=EQ",
+        )
+    active_value = master_row.get("active")
+    if active_value is None:
+        if require_universe_membership:
+            return reject(
+                STAGE_TRADEABILITY, "INACTIVE_SECURITY",
+                detail="Active flag missing from the security master",
+            )
+    elif _flag_is_false(active_value):
+        return reject(STAGE_TRADEABILITY, "INACTIVE_SECURITY", detail=f"active={active_value}")
+
+    delisting_date = _iso(master_row.get("delisting_date"))
+    if delisting_date and delisting_date <= market_iso:
+        return reject(
+            STAGE_CORPORATE_LIFECYCLE, "DELISTED_SECURITY",
+            detail=f"Security master delisting_date={delisting_date}",
+        )
+
+    # 4. Current regulatory exclusion.
+    if restricted_reason:
+        return reject(
+            STAGE_REGULATORY, "RESTRICTED_SECURITY", detail=str(restricted_reason),
+        )
+
+    # 5. Per-symbol price freshness — the control that was missing entirely.
+    if frame is None or len(frame) == 0 or "trade_date" not in getattr(frame, "columns", ()):
+        return reject(STAGE_DATA_QUALITY, "INVALID_LATEST_ROW", detail="No price history")
+    dates = pd.to_datetime(frame["trade_date"], errors="coerce").dropna()
+    if dates.empty:
+        return reject(STAGE_DATA_QUALITY, "INVALID_LATEST_ROW", detail="No parseable trade dates")
+    symbol_last = dates.max().date().isoformat()
+    behind = _staleness_sessions(symbol_last, market_iso, session_calendar)
+    if symbol_last > market_iso:
+        return reject(
+            STAGE_FRESHNESS, "INVALID_LATEST_ROW",
+            detail=f"Latest bar {symbol_last} is after market date {market_iso}",
+            symbol_last_date=symbol_last,
+        )
+    if behind > max_staleness_sessions:
+        return reject(
+            STAGE_FRESHNESS, "STALE_SYMBOL_PRICE",
+            detail=f"Last traded {symbol_last}, {behind} session(s) behind {market_iso}",
+            symbol_last_date=symbol_last, staleness_sessions=behind,
+        )
+
+    # 6. The latest row must be a usable bar.
+    ordered = frame.sort_values("trade_date")
+    latest = ordered.iloc[-1]
+    missing = [column for column in _OHLC_COLUMNS if column not in ordered.columns]
+    if missing:
+        return reject(
+            STAGE_DATA_QUALITY, "INVALID_LATEST_ROW",
+            detail=f"Missing columns: {', '.join(missing)}",
+            symbol_last_date=symbol_last, staleness_sessions=behind,
+        )
+    values = {column: pd.to_numeric(latest[column], errors="coerce") for column in _OHLC_COLUMNS}
+    if any(pd.isna(value) or value <= 0 for value in values.values()):
+        return reject(
+            STAGE_DATA_QUALITY, "INVALID_LATEST_ROW",
+            detail="Latest bar has a missing or non-positive price",
+            symbol_last_date=symbol_last, staleness_sessions=behind,
+        )
+    if values["high"] < max(values["open"], values["low"], values["close"]) or \
+       values["low"] > min(values["open"], values["high"], values["close"]):
+        return reject(
+            STAGE_DATA_QUALITY, "INVALID_LATEST_ROW", detail="Latest bar fails OHLC sanity",
+            symbol_last_date=symbol_last, staleness_sessions=behind,
+        )
+    if "volume" in ordered.columns:
+        volume = pd.to_numeric(latest["volume"], errors="coerce")
+        if pd.isna(volume) or volume < 0:
+            return reject(
+                STAGE_DATA_QUALITY, "INVALID_LATEST_ROW", detail="Latest bar volume is invalid",
+                symbol_last_date=symbol_last, staleness_sessions=behind,
+            )
+
+    # 7. Non-terminal corporate events are displayed, not discarded.  An
+    #    APPROVED scheme is materially certain, so it withholds new entries
+    #    while leaving the symbol visible.
+    review_reason: str | None = None
+    entry_blocked = False
+    successor = None
+    ratio = None
+    if lifecycle_event is not None and lifecycle_event.is_active_review_on(market_iso):
+        review_reason = "CORPORATE_ACTION_REVIEW"
+        entry_blocked = lifecycle_event.blocks_new_entries_on(market_iso)
+        successor = lifecycle_event.successor_symbol
+        ratio = lifecycle_event.conversion_ratio
+        if corporate_review_is_terminal and entry_blocked:
+            return reject(
+                STAGE_CORPORATE_LIFECYCLE, "CORPORATE_ACTION_REVIEW",
+                detail=lifecycle_event.describe(),
+                symbol_last_date=symbol_last, successor_symbol=successor,
+                conversion_ratio=ratio,
+            )
+    corporate_action = master_row.get("corporate_action_type")
+    if review_reason is None and corporate_action:
+        review_reason = "CORPORATE_ACTION_REVIEW"
+        entry_blocked = True
+
+    return TradeabilityResult(
+        symbol=symbol, eligible=True, reason_code=TRADEABLE, stage=STAGE_TRADEABILITY,
+        market_date=market_iso, symbol_last_date=symbol_last, staleness_sessions=behind,
+        entry_blocked=entry_blocked, review_reason=review_reason,
+        successor_symbol=successor, conversion_ratio=ratio,
+    )
+
+
+def evaluate_universe(
+    prices: pd.DataFrame,
+    *,
+    market_date: date | str | None = None,
+    master: Mapping[str, Mapping[str, object]] | pd.DataFrame | None = None,
+    lifecycle: LifecycleRegistry | Iterable[LifecycleEvent] | None = None,
+    restricted: Mapping[str, str] | None = None,
+    symbols: Iterable[str] | None = None,
+    **options,
+) -> UniverseVerdict:
+    """Run the gateway across a whole universe price frame."""
+    resolved_date = _iso(market_date) if market_date is not None else market_date_from_prices(prices)
+    if resolved_date is None:
+        raise ValueError("cannot determine a market date; pass market_date explicitly")
+
+    if isinstance(master, pd.DataFrame):
+        master_map = {
+            str(row["symbol"]): row.to_dict() for _, row in master.iterrows()
+        } if not master.empty else {}
+    else:
+        master_map = dict(master or {})
+
+    if lifecycle is None:
+        registry = LifecycleRegistry(())
+    elif isinstance(lifecycle, LifecycleRegistry):
+        registry = lifecycle
+    else:
+        registry = LifecycleRegistry(lifecycle)
+
+    restricted_map = dict(restricted or {})
+    calendar = options.pop("session_calendar", None)
+    if calendar is None:
+        calendar = session_calendar_from_prices(prices)
+
+    wanted = {str(s) for s in symbols} if symbols is not None else None
+    results: dict[str, TradeabilityResult] = {}
+    grouped = prices.groupby("symbol") if not prices.empty else ()
+    for symbol, frame in grouped:
+        symbol = str(symbol)
+        if wanted is not None and symbol not in wanted:
+            continue
+        results[symbol] = evaluate_tradeability(
+            symbol, frame,
+            market_date=resolved_date,
+            master_row=master_map.get(symbol),
+            lifecycle_event=registry.event_for(symbol, resolved_date),
+            restricted_reason=restricted_map.get(symbol),
+            session_calendar=calendar,
+            **options,
+        )
+
+    # Symbols named by the caller but absent from the price frame still deserve
+    # an explicit verdict rather than silent omission.
+    if wanted is not None:
+        for symbol in sorted(wanted - set(results)):
+            results[symbol] = evaluate_tradeability(
+                symbol, pd.DataFrame(columns=["trade_date"]),
+                market_date=resolved_date,
+                master_row=master_map.get(symbol),
+                lifecycle_event=registry.event_for(symbol, resolved_date),
+                restricted_reason=restricted_map.get(symbol),
+                session_calendar=calendar,
+                **options,
+            )
+
+    return UniverseVerdict(market_date=resolved_date, results=results)
+
+
+def gateway_from_database(
+    db_path: str | Path,
+    prices: pd.DataFrame,
+    *,
+    market_date: date | str | None = None,
