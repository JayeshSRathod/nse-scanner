+-- 005_security_lifecycle.sql
+-- Authoritative terminal corporate-event registry for the scanner family.
+--
+-- A symbol listed here as EFFECTIVE or TERMINAL must leave the *current*
+-- scanning universe from its last trading date onwards, while every historical
+-- price bar and every historical signal for earlier dates remains valid and
+-- untouched.  Non-terminal statuses (ANNOUNCED, APPROVED) keep the symbol
+-- visible but withhold new paper entries.
+--
+-- NOTE: this repository has no ordered migration runner; the same DDL is also
+-- applied idempotently at runtime by V2Database.ensure_v3_schema() so
+-- disposable CI runners get the table without a manual migration step.  Keep
+-- the two definitions in sync.
+
+CREATE TABLE IF NOT EXISTS security_lifecycle_events (
+    symbol              TEXT NOT NULL,
+    event_type          TEXT NOT NULL,
+    status              TEXT NOT NULL,
+    announcement_date   TEXT,
+    effective_date      TEXT,
+    record_date         TEXT,
+    last_trading_date   TEXT,
+    successor_symbol    TEXT,
+    exchange_ratio_from REAL,
+    exchange_ratio_to   REAL,
+    source              TEXT NOT NULL DEFAULT 'MANUAL',
+    terminal            INTEGER NOT NULL DEFAULT 0 CHECK(terminal IN (0, 1)),
+    notes               TEXT,
+    loaded_at           TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    PRIMARY KEY(symbol, event_type, status)
+);
+
+CREATE INDEX IF NOT EXISTS idx_security_lifecycle_symbol
+    ON security_lifecycle_events(symbol);
+CREATE INDEX IF NOT EXISTS idx_security_lifecycle_terminal
+    ON security_lifecycle_events(terminal, effective_date);
+
+-- Gateway rejection audit: one row per symbol per market date, so a scan's
+-- admission decisions are reconstructable after the fact.
+CREATE TABLE IF NOT EXISTS tradeability_audit_v3 (
+    symbol             TEXT NOT NULL,
+    market_date        TEXT NOT NULL,
+    eligible           INTEGER NOT NULL,
+    stage              TEXT NOT NULL,
+    reason_code        TEXT NOT NULL,
+    entry_blocked      INTEGER NOT NULL DEFAULT 0,
+    review_reason      TEXT,
+    symbol_last_date   TEXT,
+    staleness_sessions INTEGER,
+    successor_symbol   TEXT,
+    detail             TEXT,
+    created_at         TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    PRIMARY KEY(symbol, market_date)
+);
+
+CREATE INDEX IF NOT EXISTS idx_tradeability_audit_reason
+    ON tradeability_audit_v3(market_date, reason_code);
+
+INSERT OR IGNORE INTO schema_migrations (migration_id, checksum, notes)
+VALUES ('005_security_lifecycle', 'v1', 'Security lifecycle registry and tradeability audit');
